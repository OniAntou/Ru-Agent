<Application
    x:Class="RuApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RuApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:ErrorColorConverter x:Key="ErrorColorConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Editorial reading-room palette -->
            <Color x:Key="RuCanvasColor">#F3F4F0</Color>
            <Color x:Key="RuSidebarColor">#E9ECE6</Color>
            <Color x:Key="RuSurfaceColor">#FBFCF8</Color>
            <Color x:Key="RuInkColor">#20231F</Color>
            <Color x:Key="RuMutedColor">#687067</Color>
            <Color x:Key="RuLineColor">#D9DDD5</Color>
            <Color x:Key="RuAccentColor">#A84B38</Color>
            <Color x:Key="RuAccentSoftColor">#F3E5E0</Color>
            <Color x:Key="RuSuccessColor">#2F6F51</Color>
            <Color x:Key="RuWarningColor">#9A6C1F</Color>
            <Color x:Key="RuDangerColor">#A73A3A</Color>

            <SolidColorBrush x:Key="RuCanvasBrush" Color="{StaticResource RuCanvasColor}" />
            <SolidColorBrush x:Key="RuSidebarBrush" Color="{StaticResource RuSidebarColor}" />
            <SolidColorBrush x:Key="RuSurfaceBrush" Color="{StaticResource RuSurfaceColor}" />
            <SolidColorBrush x:Key="RuInkBrush" Color="{StaticResource RuInkColor}" />
            <SolidColorBrush x:Key="RuMutedBrush" Color="{StaticResource RuMutedColor}" />
            <SolidColorBrush x:Key="RuLineBrush" Color="{StaticResource RuLineColor}" />
            <SolidColorBrush x:Key="RuAccentBrush" Color="{StaticResource RuAccentColor}" />
            <SolidColorBrush x:Key="RuAccentSoftBrush" Color="{StaticResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="RuSuccessBrush" Color="{StaticResource RuSuccessColor}" />
            <SolidColorBrush x:Key="RuWarningBrush" Color="{StaticResource RuWarningColor}" />
            <SolidColorBrush x:Key="RuDangerBrush" Color="{StaticResource RuDangerColor}" />

            <FontFamily x:Key="RuUiFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="RuDisplayFontFamily">Cambria</FontFamily>
            <FontFamily x:Key="RuMonoFontFamily">Consolas</FontFamily>
            <CornerRadius x:Key="RuControlCornerRadius">6</CornerRadius>

            <!-- Legacy resource names remain available to untouched views. -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource RuCanvasColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource RuSidebarColor}" />
            <SolidColorBrush x:Key="AppSidebarBorderBrush" Color="{StaticResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{StaticResource RuSurfaceColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="{StaticResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{StaticResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBorderSubtleBrush" Color="{StaticResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBorderHighlightBrush" Color="{StaticResource RuLineColor}" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="{StaticResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="AppAccentGlowBrush" Color="{StaticResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppSecondaryAccentBrush" Color="{StaticResource RuMutedColor}" />
            <SolidColorBrush x:Key="AppSecondaryAccentSubtleBrush" Color="{StaticResource RuSidebarColor}" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource RuInkColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource RuMutedColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{StaticResource RuMutedColor}" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource RuSuccessColor}" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="{StaticResource RuSidebarColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource RuWarningColor}" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="{StaticResource RuSidebarColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource RuDangerColor}" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="{StaticResource RuSidebarColor}" />

            <!-- CornerRadius Design Tokens -->
            <CornerRadius x:Key="AppCardCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="AppPillCornerRadius">6</CornerRadius>

            <!-- Card Border Style -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="24,20" />
            </Style>

            <!-- Smooth Action Button Style -->
            <Style x:Key="ActionCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
