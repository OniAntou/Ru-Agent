<UserControl
    x:Class="RuApp.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,12" HorizontalAlignment="Stretch">
                <Border MaxWidth="620"
                        HorizontalAlignment="Right"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind Attachments, Mode=OneWay}"
                                      Visibility="{x:Bind HasAttachments, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageAttachmentItem">
                                    <Grid Margin="0,0,6,4">
                                        <!-- Image Rendering -->
                                        <Border Visibility="{x:Bind IsImage, Mode=OneWay}"
                                                Width="140" Height="105" CornerRadius="6"
                                                Background="{StaticResource RuCanvasBrush}"
                                                BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1">
                                            <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Document / Code File Pill Badge -->
                                        <Border Visibility="{x:Bind IsDocument, Mode=OneWay}"
                                                CornerRadius="6"
                                                Background="{StaticResource RuCanvasBrush}"
                                                BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind FileIconGlyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource RuAccentBrush}" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                                FontSize="14.5"
                                                Foreground="{StaticResource RuInkBrush}"
                                                FontFamily="{StaticResource RuUiFontFamily}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,16" HorizontalAlignment="Stretch">
                <Grid MaxWidth="740"
                      HorizontalAlignment="Left"
                      ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Width="26"
                            Height="26"
                            Margin="0,2,12,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource RuAccentSoftBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            CornerRadius="13">
                        <TextBlock Text="Ru"
                                   FontFamily="{StaticResource RuDisplayFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RuAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Spacing="6">
                        <Rectangle x:Name="TypingCaret"
                                   Width="2"
                                   Height="18"
                                   HorizontalAlignment="Left"
                                   Fill="{StaticResource RuAccentBrush}"
                                   Visibility="{x:Bind ShowTypingDots, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                                FontSize="15"
                                                Foreground="{x:Bind IsError, Converter={StaticResource ErrorColorConverter}}"
                                                FontFamily="{StaticResource RuUiFontFamily}"
                                                Visibility="{x:Bind ShowContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <views:ChatMessageTemplateSelector x:Key="ChatTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Background="{StaticResource RuCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InputContainer.Padding" Value="0,6,0,18" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="16,12" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SuggestionPanel.Orientation" Value="Vertical" />
                        <Setter Target="SuggestionPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="InputContainer.Padding" Value="0,4,0,12" />
                        <Setter Target="InputBorder.Padding" Value="4,2" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:MeteorShowerField x:Name="MeteorShowerField"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />

        <Grid x:Name="ReadingColumn"
              Grid.Row="0"
              HorizontalAlignment="Stretch"
              Background="Transparent">
            <StackPanel x:Name="WelcomeHeroPanel"
                        MaxWidth="820"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="18"
                        Margin="24,16"
                        Visibility="Visible">
                <TextBlock x:Name="WelcomeEyebrow"
                           Text="RU / CONVERSATIONAL RUNTIME"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{StaticResource RuMutedBrush}" />
                <TextBlock Text="Ru"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="14"
                           Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock x:Name="WelcomeIntro"
                           Text="Chào anh. Hôm nay mình bắt đầu từ đâu?"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="28"
                           Foreground="{StaticResource RuInkBrush}"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SuggestionPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="12">
                    <Button Tag="Hỏi về một việc đang làm"
                            Click="OnSuggestionClick"
                            Background="{StaticResource RuSurfaceBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource RuInkBrush}"
                            CornerRadius="{StaticResource RuControlCornerRadius}"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" />
                            <TextBlock Text="Hỏi về một việc đang làm"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="13"
                                       Foreground="{StaticResource RuInkBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Nói cho Ru nghe"
                            Click="OnSuggestionClick"
                            Background="{StaticResource RuSurfaceBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource RuInkBrush}"
                            CornerRadius="{StaticResource RuControlCornerRadius}"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE720;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" />
                            <TextBlock Text="Nói cho Ru nghe"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="13"
                                       Foreground="{StaticResource RuInkBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="ChatScrollHost"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Bottom"
                          Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuAccentColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                    <x:Double x:Key="ScrollBarSize">8</x:Double>
                </ScrollViewer.Resources>
                <Grid x:Name="ChatContentGrid"
                      HorizontalAlignment="Center"
                      RowDefinitions="Auto,Auto,Auto">
                    <ListView x:Name="ChatListView"
                              Grid.Row="0"
                              AutomationProperties.AutomationId="ChatMessages"
                              Padding="16,16,16,8"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical"
                                                 HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <ItemsControl x:Name="AgentActivityFeed"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="AgentActivityFeed"
                                  AutomationProperties.Name="Hoạt động Coding Agent"
                                  AutomationProperties.LiveSetting="Polite">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AgentActivityItem">
                                <Border Margin="16,3"
                                        Padding="12,8"
                                        Background="{StaticResource RuSurfaceBrush}"
                                        BorderBrush="{StaticResource RuLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RuControlCornerRadius}">
                                    <Grid ColumnDefinitions="22,*"
                                          AutomationProperties.LiveSetting="Polite">
                                        <Grid Grid.Column="0"
                                              Width="18"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <ProgressRing IsActive="True"
                                                          Width="13"
                                                          Height="13"
                                                          Foreground="{StaticResource RuAccentBrush}"
                                                          Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="&#xE73E;"
                                                      FontSize="13"
                                                      Foreground="{StaticResource RuSuccessBrush}"
                                                      Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="&#xE74D;"
                                                      FontSize="13"
                                                      Foreground="{StaticResource RuDangerBrush}"
                                                      Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="&#xE823;"
                                                      FontSize="13"
                                                      Foreground="{StaticResource RuMutedBrush}"
                                                      Visibility="{x:Bind IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource RuInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind MetadataText, Mode=OneWay}"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource RuMutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="AgentRunSummaryPanel"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Margin="16,10,16,16"
                            Padding="12,10"
                            Background="{StaticResource RuSurfaceBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            AutomationProperties.AutomationId="AgentRunSummary"
                            AutomationProperties.Name="Tóm tắt phiên Coding Agent"
                            AutomationProperties.LiveSetting="Polite">
                        <Grid ColumnDefinitions="22,*"
                              ColumnSpacing="8">
                            <FontIcon x:Name="AgentRunSummaryGlyph"
                                      Grid.Column="0"
                                      FontSize="14"
                                      Foreground="{StaticResource RuAccentBrush}"
                                      VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1"
                                        Spacing="2">
                                <TextBlock x:Name="AgentRunSummaryText"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource RuInkBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AgentRunSummaryMetadata"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="11"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="InputContainer"
              Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto"
              Width="820"
              MaxWidth="820"
              Background="Transparent"
              Padding="0,8,0,24"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center">
            <TextBlock x:Name="VoiceConversationStatusText"
                       Grid.Row="0"
                       Text=""
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="VoiceConversationStatus"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{StaticResource RuMutedBrush}"
                       Margin="8,0,8,6" />

            <StackPanel x:Name="AgentInlinePanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Spacing="6"
                        Margin="8,0,8,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="AgentStatusText"
                               AutomationProperties.AutomationId="AgentStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource RuMutedBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="AgentStopButton"
                            Grid.Column="1"
                            Content="Dừng"
                            Click="OnAgentStopClick"
                            Visibility="Collapsed"
                            Padding="10,4"
                            AutomationProperties.AutomationId="AgentStopButton"
                            AutomationProperties.Name="Dừng Coding Agent" />
                </Grid>

                <Border x:Name="AgentTrustPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RuControlCornerRadius}"
                        Padding="10,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Workspace cần được xác nhận"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuAccentBrush}" />
                        <TextBlock x:Name="AgentTrustText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RuInkBrush}"
                                   AutomationProperties.AutomationId="AgentTrustText" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AgentTrustDenyButton"
                                    Content="Từ chối"
                                    Click="OnAgentTrustDenyClick"
                                    AutomationProperties.AutomationId="AgentTrustDenyButton"
                                    AutomationProperties.Name="Từ chối workspace" />
                            <Button x:Name="AgentTrustApproveButton"
                                    Content="Tin cậy workspace"
                                    Click="OnAgentTrustApproveClick"
                                    AutomationProperties.AutomationId="AgentTrustApproveButton"
                                    AutomationProperties.Name="Tin cậy workspace" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AgentApprovalPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RuControlCornerRadius}"
                        Padding="10,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Agent cần anh phê duyệt một hành động"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuAccentBrush}" />
                        <TextBlock x:Name="AgentApprovalSummaryText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RuInkBrush}"
                                   AutomationProperties.AutomationId="AgentApprovalSummaryText" />
                        <StackPanel x:Name="AgentApprovalScopePanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock Text="Phạm vi"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <ComboBox x:Name="AgentApprovalScopeBox"
                                      SelectedIndex="0"
                                      MinWidth="190"
                                      AutomationProperties.AutomationId="AgentApprovalScopeBox"
                                      AutomationProperties.Name="Phạm vi phê duyệt Agent">
                                <ComboBoxItem Content="Chỉ lần này" Tag="once" />
                                <ComboBoxItem Content="Cho phiên hiện tại" Tag="run" />
                                <ComboBoxItem Content="Cho project này" Tag="project" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AgentDenyButton"
                                    Content="Từ chối"
                                    Click="OnAgentDenyClick"
                                    AutomationProperties.AutomationId="AgentDenyButton"
                                    AutomationProperties.Name="Từ chối hành động của Agent" />
                            <Button x:Name="AgentApproveButton"
                                    Content="Duyệt theo phạm vi"
                                    Click="OnAgentApproveClick"
                                    AutomationProperties.AutomationId="AgentApproveButton"
                                    AutomationProperties.Name="Duyệt theo phạm vi cho Agent" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="AgentContinueButton"
                        Content="Tiếp tục"
                        Click="OnAgentContinueClick"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        AutomationProperties.AutomationId="AgentContinueButton"
                        AutomationProperties.Name="Tiếp tục phiên Coding Agent" />
            </StackPanel>

            <Border x:Name="InputBorder"
                    Grid.Row="2"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10,12,8"
                    AllowDrop="True"
                    DragOver="OnInputDragOver"
                    Drop="OnInputDrop">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Image Attachment Preview Strip -->
                    <ScrollViewer x:Name="AttachmentPreviewContainer"
                                  Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  Margin="0,0,0,8"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="AttachmentPreviewList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageAttachmentItem">
                                    <Grid Margin="0,0,4,0">
                                        <!-- Image Thumbnail Box -->
                                        <Grid Visibility="{x:Bind IsImage, Mode=OneWay}" Width="60" Height="60">
                                            <Border CornerRadius="8" Background="{StaticResource RuCanvasBrush}"
                                                    BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1">
                                                <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Width="18" Height="18" Padding="0" Margin="2"
                                                    Background="#C0000000" Foreground="White"
                                                    BorderThickness="0" CornerRadius="9"
                                                    Click="OnRemoveAttachmentClick" Tag="{x:Bind Id}">
                                                <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                            </Button>
                                        </Grid>

                                        <!-- Document / Code File Pill Badge -->
                                        <Grid Visibility="{x:Bind IsDocument, Mode=OneWay}" Height="34">
                                            <Border CornerRadius="6" Background="{StaticResource RuCanvasBrush}"
                                                    BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                    Padding="8,4,4,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind FileIconGlyph, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RuAccentBrush}"/>
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" Margin="0,0,2,0"/>
                                                    <Button Width="18" Height="18" Padding="0"
                                                            Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                                            BorderThickness="0" CornerRadius="9"
                                                            Click="OnRemoveAttachmentClick" Tag="{x:Bind Id}">
                                                        <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBox x:Name="ChatInputTextBox"
                             Grid.Row="1"
                             AutomationProperties.AutomationId="ChatInput"
                             PlaceholderText="Viết cho Ru..."
                             PreviewKeyDown="OnChatInputPreviewKeyDown"
                             AcceptsReturn="True"
                             MinHeight="44"
                             MaxHeight="150"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="{StaticResource RuUiFontFamily}"
                             FontSize="15"
                             Padding="4,2,4,6"
                             Foreground="{StaticResource RuInkBrush}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                          Margin="0,4,0,0">
                        <Button x:Name="AttachImageButton"
                                Grid.Column="0"
                                Click="OnAttachImageClick"
                                Width="30"
                                Height="30"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Margin="0"
                                AutomationProperties.AutomationId="AttachImageButton"
                                AutomationProperties.Name="Đính kèm tập tin hoặc hình ảnh">
                            <FontIcon x:Name="AttachImageIcon"
                                      Glyph="&#xE710;"
                                      FontSize="14"
                                      Foreground="{StaticResource RuMutedBrush}" />
                        </Button>

                        <Button x:Name="AgentModeButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                IsTabStop="False"
                                AutomationProperties.AutomationId="AgentModeButton"
                                AutomationProperties.Name="Coding Agent">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="AgentModeIcon"
                                          Glyph="&#xEC25;"
                                          FontSize="12"
                                          Foreground="{StaticResource RuMutedBrush}" />
                                <TextBlock x:Name="AgentModeLabel"
                                           Text="Agent"
                                           FontSize="12"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <ComboBox x:Name="AgentPresetBox"
                                      Grid.Column="2"
                                      Visibility="Visible"
                                      SelectedIndex="0"
                                      SelectionChanged="OnAgentPresetChanged"
                                      AutomationProperties.AutomationId="AgentPresetBox"
                                      AutomationProperties.Name="Preset quyền của Agent"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      Margin="2,0,0,0"
                                      CornerRadius="{StaticResource RuControlCornerRadius}"
                                      FontFamily="{StaticResource RuUiFontFamily}"
                                      FontSize="12"
                                      Foreground="{StaticResource RuMutedBrush}"
                                      VerticalAlignment="Center">
                                <ComboBox.Resources>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Background="Transparent" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid x:Name="LayoutRoot">
                                                        <ToggleButton x:Name="DropDownToggle"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      CornerRadius="{StaticResource RuControlCornerRadius}"
                                                                      HorizontalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Left"
                                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource RuInkBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <FontIcon Glyph="&#xE70D;"
                                                                          FontSize="10"
                                                                          Foreground="{StaticResource RuMutedBrush}"
                                                                          VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <Popup x:Name="Popup"
                                                               VerticalOffset="-84"
                                                               HorizontalOffset="0"
                                                               IsOpen="{TemplateBinding IsDropDownOpen}">
                                                            <Border Background="{StaticResource RuSurfaceBrush}"
                                                                    BorderBrush="{StaticResource RuLineBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                                                    Padding="4"
                                                                    MinWidth="140">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="MinHeight" Value="34" />
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                        <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Grid x:Name="RootGrid"
                                                          Background="Transparent"
                                                          CornerRadius="{TemplateBinding CornerRadius}"
                                                          Padding="{TemplateBinding Padding}">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled" />
                                                            </VisualStateGroup>
                                                            <VisualStateGroup x:Name="SelectionStates">
                                                                <VisualState x:Name="Selected">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Unselected">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedUnfocused">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedDisabled" />
                                                                <VisualState x:Name="SelectedPointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedPressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                                    </Storyboard>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{TemplateBinding Content}"
                                                                       FontFamily="{TemplateBinding FontFamily}"
                                                                       FontSize="{TemplateBinding FontSize}"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <FontIcon x:Name="CheckMark"
                                                                      Grid.Column="1"
                                                                      Glyph="&#xE73E;"
                                                                      FontSize="12"
                                                                      Foreground="{StaticResource RuAccentBrush}"
                                                                      Opacity="0"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center"
                                                                      Margin="16,0,2,0" />
                                                        </Grid>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Standard" Tag="standard" />
                                <ComboBoxItem Content="Full Access" Tag="full_access" />
                            </ComboBox>

                            <Border Width="1" Height="14" Background="{StaticResource RuLineBrush}" Opacity="0.4" Margin="2,0" VerticalAlignment="Center"/>

                            <Button x:Name="ChatModelButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ChatModelButton"
                                    AutomationProperties.Name="Chọn Model AI"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,4"
                                    Margin="0"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RootBorder"
                                                            Background="Transparent"
                                                            CornerRadius="{TemplateBinding CornerRadius}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatModelLabel"
                                               Text="Model..."
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}"
                                               MaxWidth="160"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;"
                                               FontSize="9"
                                               Foreground="{StaticResource RuMutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="ChatModelFlyout" Placement="Top" Opened="OnChatModelFlyoutOpened">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                                <Setter Property="Padding" Value="2" />
                                                <Setter Property="MinWidth" Value="250" />
                                                <Setter Property="MaxWidth" Value="340" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel Spacing="0">
                                            <!-- Polished Search Pill Box -->
                                            <Border Background="{StaticResource RuCanvasBrush}"
                                                    BorderBrush="{StaticResource RuLineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                                    Padding="9,5"
                                                    Margin="6,6,6,4">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <FontIcon Glyph="&#xE721;"
                                                              FontSize="11"
                                                              Foreground="{StaticResource RuMutedBrush}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,7,0" />
                                                    <TextBox x:Name="ModelSearchBox"
                                                             Grid.Column="1"
                                                             AutomationProperties.AutomationId="ModelSearchBox"
                                                             PlaceholderText="Tìm model..."
                                                             TextChanged="OnModelSearchTextChanged"
                                                             FontFamily="{StaticResource RuUiFontFamily}"
                                                             FontSize="12"
                                                             MinHeight="0"
                                                             Padding="0,1,0,1"
                                                             Margin="0"
                                                             VerticalAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             IsSpellCheckEnabled="False"
                                                             Foreground="{StaticResource RuInkBrush}">
                                                        <TextBox.Resources>
                                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                            <Thickness x:Key="TextControlThemePadding">0,1,0,1</Thickness>
                                                        </TextBox.Resources>
                                                    </TextBox>
                                                </Grid>
                                            </Border>

                                            <!-- Divider Line -->
                                            <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.4" Margin="6,2,6,2" />

                                            <!-- Model List -->
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="4,2,4,4">
                                                <StackPanel x:Name="ModelListContainer" Spacing="2" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ContextMeterButton"
                                    AutomationProperties.AutomationId="ContextMeterButton"
                                    AutomationProperties.Name="Xem dung lượng Context Window"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="13"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent"
                                                            CornerRadius="13"
                                                            Width="26"
                                                            Height="26">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressRing x:Name="ContextProgressRing"
                                                  IsIndeterminate="False"
                                                  Value="0"
                                                  Minimum="0"
                                                  Maximum="100"
                                                  Width="18"
                                                  Height="18"
                                                  Foreground="{StaticResource RuAccentBrush}"
                                                  Background="{StaticResource RuLineBrush}"
                                                  Opacity="0.95"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout x:Name="ContextWindowFlyout" Placement="Top">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                                <Setter Property="Padding" Value="10,8" />
                                                <Setter Property="MinWidth" Value="170" />
                                                <Setter Property="MaxWidth" Value="230" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="ContextUsedLabel"
                                                           Text="0 / 128K"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="ContextPercentLabel"
                                                           Grid.Column="1"
                                                           Text="0%"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ProgressBar x:Name="ContextProgressBar"
                                                         Value="0"
                                                         Maximum="100"
                                                         Height="3"
                                                         CornerRadius="1.5"
                                                         Foreground="{StaticResource RuAccentBrush}"
                                                         Background="{StaticResource RuAccentSoftBrush}" />

                                            <TextBlock x:Name="ContextModelDetailLabel"
                                                       Text="dots-3-note-preview:free"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource RuMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="MicButton"
                                    Click="OnMicClick"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    AutomationProperties.AutomationId="MicButton"
                                    AutomationProperties.Name="Nói chuyện với Ru bằng giọng nói">
                                <FontIcon x:Name="MicIcon"
                                          Glyph="&#xE720;"
                                          FontSize="14"
                                          Foreground="{StaticResource RuMutedBrush}" />
                            </Button>

                            <Button x:Name="SendButton"
                                    AutomationProperties.AutomationId="SendButton"
                                    Click="OnSendClick"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    Background="{StaticResource RuAccentSoftBrush}"
                                    BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE725;" FontSize="13" Foreground="{StaticResource RuInkBrush}" Margin="-1,1,0,0" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
