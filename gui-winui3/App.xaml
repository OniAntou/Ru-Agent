                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#CBD5E1" />
