<UserControl
    x:Class="RuApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDescStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SidebarCategoryHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Margin" Value="8,16,8,4" />
            </Style>

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main 2-Column Settings Modal Container -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="200" />
            <!-- Right Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN: SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="12,16,12,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource SidebarCategoryHeadingStyle}" Margin="8,0,8,6" />
                    <!-- General Tab Button -->
                    <Button x:Name="NavGeneralBtn"
                            Content="General"
                            Click="OnNavGeneralClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <!-- Models / AI Providers Tab Button -->
                    <Button x:Name="NavModelsBtn"
                            Content="Models &amp; Providers"
                            Click="OnNavModelsClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== RIGHT COLUMN: CONTENT ==================== -->
        <Grid Grid.Column="1" Background="{StaticResource RuSurfaceBrush}" RowDefinitions="Auto,*">
            <!-- Header Bar (Category Title & Subtitle) -->
            <Grid Grid.Row="0" Padding="28,20,56,16" BorderBrush="{StaticResource RuLineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CategoryTitleText"
                               Text="General"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource RuDisplayFontFamily}"
                               Foreground="{StaticResource RuInkBrush}" />
                    <TextBlock x:Name="CategorySubtitleText"
                               Text="Manage application theme and agent defaults."
                               FontSize="12.5"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Panels Area -->
            <!-- General Settings Panel -->
            <ScrollViewer x:Name="PanelGeneralScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Visible">
                <StackPanel Spacing="16">
                    <!-- Appearance Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Appearance" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Switch between Dark and Light mode theme" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ThemeButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Appearance theme">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ThemeButtonLabel"
                                                   Text="Dark"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="ThemeDarkOption"
                                                        Tag="dark"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Dark theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeDarkText"
                                                                   Text="Dark"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeDarkCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeLightOption"
                                                        Tag="light"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Light theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeLightText"
                                                                   Text="Light"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeLightCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                  <!-- Conversation Typography Card -->
                  <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                      <StackPanel Spacing="16">
                          <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                  <TextBlock Text="Message text size" Style="{StaticResource SettingLabelStyle}" />
                                  <TextBlock Text="Conversation text size; activity lines stay one step smaller"
                                             Style="{StaticResource SettingDescStyle}" />
                              </StackPanel>
                              <Button x:Name="TranscriptSizeButton"
                                      Grid.Column="1"
                                      Width="260"
                                      MinHeight="36"
                                      Style="{StaticResource RuDropdownButtonStyle}"
                                      AutomationProperties.Name="Message text size">
                                  <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock x:Name="TranscriptSizeButtonLabel"
                                                 Text="14"
                                                 FontFamily="{StaticResource RuUiFontFamily}"
                                                 FontSize="13"
                                                 FontWeight="Medium"
                                                 Foreground="{StaticResource RuInkBrush}"
                                                 VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis" />
                                      <FontIcon Grid.Column="1"
                                                Glyph="&#xE70D;"
                                                FontSize="9"
                                                Foreground="{StaticResource RuMutedBrush}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0" />
                                  </Grid>
                                  <Button.Flyout>
                                      <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                          <StackPanel x:Name="TranscriptSizeOptionsPanel" Width="260" Spacing="2" />
                                      </Flyout>
                                  </Button.Flyout>
                              </Button>
                          </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Agent Capabilities Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Permission Preset" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Plan is read-only; Standard asks before mutations; Full Access skips approvals" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="PresetButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Permission preset">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="PresetButtonLabel"
                                                   Text="Standard"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="PresetPlanOption"
                                                        Tag="plan"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Plan preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetPlanText"
                                                                   Text="Plan"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetPlanCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetStandardOption"
                                                        Tag="standard"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Standard preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetStandardText"
                                                                   Text="Standard"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetStandardCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetFullAccessOption"
                                                        Tag="full_access"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Full Access preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetFullAccessText"
                                                                   Text="Full Access"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetFullAccessCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Models / Providers Panel -->
            <ScrollViewer x:Name="PanelModelsScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <!-- Main Provider & Keys Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <!-- Provider Dropdown Row -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Active Provider" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Choose cloud AI provider or custom server" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ProviderButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Active provider">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ProviderButtonLabel"
                                                   Text="OpenAI (Official API)"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="280" Spacing="0">
                                                <Border Background="{StaticResource RuCanvasBrush}"
                                                        BorderBrush="{StaticResource RuLineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <FontIcon Glyph="&#xE721;"
                                                                  FontSize="12"
                                                                  Foreground="{StaticResource RuMutedBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0" />
                                                        <TextBox x:Name="ProviderSearchBox"
                                                                 Grid.Column="1"
                                                                 AutomationProperties.Name="Search providers"
                                                                 PlaceholderText="Search providers…"
                                                                 TextChanged="OnProviderSearchChanged"
                                                                 FontFamily="{StaticResource RuUiFontFamily}"
                                                                 FontSize="12.5"
                                                                 MinHeight="0"
                                                                 Padding="0"
                                                                 Margin="0"
                                                                 VerticalAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 IsSpellCheckEnabled="False"
                                                                 Foreground="{StaticResource RuInkBrush}">
                                                            <TextBox.Resources>
                                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                                <Thickness x:Key="TextControlThemePadding">0</Thickness>
                                                            </TextBox.Resources>
                                                        </TextBox>
                                                    </Grid>
                                                </Border>
                                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" Margin="0,0,0,4" />
                                                <ScrollViewer MaxHeight="300"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              HorizontalScrollMode="Disabled"
                                                              Padding="0,0,6,4">
                                                    <ScrollViewer.Resources>
                                                        <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                                                        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                                                        <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                                                        <x:Double x:Key="ScrollBarSize">5</x:Double>
                                                    </ScrollViewer.Resources>
                                                    <StackPanel Spacing="2">
                                                <TextBlock x:Name="FixedProvidersHeader"
                                                           Text="BUILT-IN"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           Margin="4,4,0,4" />
                                                <Button x:Name="ProviderOpenaiOption"
                                                        Tag="openai"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="OpenAI provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderOpenaiText"
                                                                   Text="OpenAI (Official API)"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderOpenaiCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ProviderAnthropicOption"
                                                        Tag="anthropic"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Anthropic provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderAnthropicText"
                                                                   Text="Anthropic Claude (Official API)"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderAnthropicCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ProviderCustomOption"
                                                        Tag="custom"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Custom server provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderCustomText"
                                                                    Text="Custom OpenAI Server"
                                                                    FontFamily="{StaticResource RuUiFontFamily}"
                                                                    FontSize="12.5"
                                                                    Foreground="{StaticResource RuInkBrush}"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderCustomCheck"
                                                                   Grid.Column="1"
                                                                   Glyph="&#xE73E;"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource RuAccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <!-- Models.dev providers are appended here at runtime -->
                                                <TextBlock x:Name="ModelsDevOptionsHeader"
                                                           Text="MODELS.DEV"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           Margin="4,8,0,4"
                                                           Visibility="Collapsed" />
                                                <Border x:Name="ModelsDevOptionsDivider"
                                                        Height="1"
                                                        Background="{StaticResource RuLineBrush}"
                                                        Opacity="0.6"
                                                        Visibility="Collapsed" />
                                                <StackPanel x:Name="ModelsDevOptionsPanel" Spacing="2" />
                                                <TextBlock x:Name="ProviderNoMatchText"
                                                           Text="No provider matches."
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           Margin="4,8,0,2"
                                                           Visibility="Collapsed" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!--
                              A stored key is not a working key; this asks the endpoint.
                              The status sits in the same grid so it reads as the result
                              of the button beside it.
                            -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Connection" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="ProviderTestStatusText"
                                               Text="Not tested yet."
                                               Style="{StaticResource SettingDescStyle}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <Button x:Name="ProviderTestButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Content="Test connection"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Test provider connection"
                                        Click="OnProviderTestClick" />
                            </Grid>

                            <!-- OpenAI API Key Row -->
                            <StackPanel x:Name="OpenAiApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="OpenAiApiKeyLabel" Text="OpenAI API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="OpenAiApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=OpenAiApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="OpenAiSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="openai"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderOpenAi"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Anthropic API Key Row -->
                            <StackPanel x:Name="AnthropicApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="AnthropicApiKeyLabel" Text="Anthropic API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="AnthropicApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=AnthropicApiKeyLabel}"
                                                     PlaceholderText="sk-ant-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="AnthropicSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="anthropic"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderAnthropic"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Custom Endpoint URL Row -->
                            <StackPanel x:Name="CustomEndpointRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomServerUrlLabel" Text="Custom Server URL" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="OpenAI-compatible endpoint URL" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="CustomEndpointUrlBox"
                                             Grid.Column="1"
                                             AutomationProperties.LabeledBy="{Binding ElementName=CustomServerUrlLabel}"
                                             PlaceholderText="http://localhost:8000/v1"
                                             Width="260"
                                             Height="36"
                                             CornerRadius="{StaticResource RuControlCornerRadius}" />
                                </Grid>
                            </StackPanel>

                            <!-- Custom API Key Row -->
                            <StackPanel x:Name="CustomApiKeyRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomApiKeyLabel" Text="Custom API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="CustomApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=CustomApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="CustomSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="custom"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderCustom"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- Models.dev API Key Row -->
                            <StackPanel x:Name="ModelsDevApiKeyRow" Spacing="16">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="ModelsDevApiKeyLabel" Text="Models.dev API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="Pick a provider, paste its key, save" Style="{StaticResource SettingDescStyle}" />
                                        <TextBlock x:Name="ModelsDevKeyStatus"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource RuMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="ModelsDevProviderBox"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=ModelsDevApiKeyLabel}"
                                                  PlaceholderText="Provider"
                                                  Width="150"
                                                  Height="36"
                                                  CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <PasswordBox x:Name="ModelsDevApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=ModelsDevApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="180"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="ModelsDevSaveButton"
                                                Content="Lưu"
                                                Click="OnSaveModelsDevKeyClick"
                                                Height="36"
                                                MinWidth="72"
                                                AutomationProperties.AutomationId="SaveModelsDevKey"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
