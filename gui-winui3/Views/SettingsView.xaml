<UserControl
    x:Class="RuApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:RuApp.Views"
    xmlns:models="using:RuApp.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDescStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SidebarCategoryHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Margin" Value="8,16,8,4" />
            </Style>

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuLineBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main 2-Column Settings Modal Container -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="200" />
            <!-- Right Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN: SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="12,16,12,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource SidebarCategoryHeadingStyle}" Margin="8,0,8,6" />
                    <!-- General Tab Button -->
                    <Button x:Name="NavGeneralBtn"
                            Content="General"
                            AutomationProperties.Name="General settings"
                            Click="OnNavGeneralClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <!-- Models / AI Providers Tab Button -->
                    <Button x:Name="NavModelsBtn"
                            Content="Models &amp; Providers"
                            AutomationProperties.Name="Models and providers settings"
                            Click="OnNavModelsClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== RIGHT COLUMN: CONTENT ==================== -->
        <Grid Grid.Column="1" Background="{StaticResource RuSurfaceBrush}" RowDefinitions="Auto,*">
            <!-- Header Bar (Category Title & Subtitle) -->
            <Grid Grid.Row="0" Padding="28,20,56,16" BorderBrush="{StaticResource RuLineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CategoryTitleText"
                               Text="General"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource RuDisplayFontFamily}"
                               Foreground="{StaticResource RuInkBrush}" />
                    <TextBlock x:Name="CategorySubtitleText"
                               Text="Manage application theme and agent defaults."
                               FontSize="12.5"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Panels Area -->
            <!-- General Settings Panel -->
            <ScrollViewer x:Name="PanelGeneralScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Visible">
                <StackPanel Spacing="16">
                    <!-- Appearance Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Appearance" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Choose Light, Dark, Meteor Shower, or Starry Night" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ThemeButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Appearance theme">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ThemeButtonLabel"
                                                   Text="Dark"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="ThemeDarkOption"
                                                        Tag="dark"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Dark theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeDarkText"
                                                                   Text="Dark"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeDarkCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeLightOption"
                                                        Tag="light"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Light theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeLightText"
                                                                   Text="Light"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeLightCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeLightMeteorOption"
                                                        Tag="light-meteor"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Light Meteor Shower theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeLightMeteorText"
                                                                   Text="Light Meteor Shower"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeLightMeteorCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeDarkMeteorOption"
                                                        Tag="dark-meteor"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Dark Meteor Shower theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeDarkMeteorText"
                                                                   Text="Dark Meteor Shower"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeDarkMeteorCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeStarryNightOption"
                                                        Tag="starry-night"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Starry Night theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeStarryNightText"
                                                                   Text="Starry Night"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeStarryNightCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                  <!--
                    Conversation Typography Card. No dropdown here: the four
                    sizes sit in the open as live specimens, each set in its
                    own size, so the choice is seen rather than read.
                  -->
                  <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                      <StackPanel Spacing="12">
                          <StackPanel Spacing="2">
                              <TextBlock Text="Message text size" Style="{StaticResource SettingLabelStyle}" />
                              <TextBlock Text="Conversation text size; activity lines stay two steps smaller"
                                         Style="{StaticResource SettingDescStyle}" />
                          </StackPanel>
                          <!-- Four equal columns: the specimens stretch the full
                            width instead of huddling left. -->
                          <Grid x:Name="TranscriptSizeOptionsPanel"
                                ColumnDefinitions="*,*,*,*"
                                ColumnSpacing="8" />
                        </StackPanel>
                    </Border>

                    <!-- Agent Capabilities Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Permission Preset" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Style="{StaticResource SettingDescStyle}">
                                        <Run Text="Plan: read + Web auto; edits and terminal deny." />
                                        <LineBreak />
                                        <Run Text="Standard: workspace edits auto; outside asks." />
                                        <LineBreak />
                                        <Run Text="Full Access: skip all approvals; harness key files stay denied" />
                                    </TextBlock>
                                </StackPanel>
                                <Button x:Name="PresetButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Permission preset">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="PresetButtonLabel"
                                                   Text="Standard"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="PresetPlanOption"
                                                        Tag="plan"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Plan preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetPlanText"
                                                                   Text="Plan"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetPlanCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetStandardOption"
                                                        Tag="standard"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Standard preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetStandardText"
                                                                   Text="Standard"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetStandardCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetFullAccessOption"
                                                        Tag="full_access"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Full Access preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetFullAccessText"
                                                                   Text="Full Access"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetFullAccessCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Models / Providers Panel -->
            <ScrollViewer x:Name="PanelModelsScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <!-- Main Provider & Keys Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <!-- Provider Dropdown Row -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Active Provider" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Choose cloud AI provider or custom server" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ProviderButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Active provider">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ProviderButtonLabel"
                                                   Text="No provider"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Spacing="0">
                                                <!--
                                                  Search is the way through a ~190-row
                                                  catalog, so it carries the weight: full-width,
                                                  accent icon, hairline under it.
                                                -->
                                                <Grid ColumnDefinitions="Auto,*" Margin="12,12,12,8">
                                                    <FontIcon Glyph="&#xE721;"
                                                              FontSize="14"
                                                              Foreground="{StaticResource RuMutedBrush}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <TextBox x:Name="ProviderSearchBox"
                                                             Grid.Column="1"
                                                             AutomationProperties.Name="Search providers"
                                                             PlaceholderText="Search providers"
                                                             TextChanged="OnProviderSearchChanged"
                                                             FontFamily="{StaticResource RuUiFontFamily}"
                                                             FontSize="13"
                                                             MinHeight="0"
                                                             Padding="0"
                                                             Margin="0"
                                                             VerticalAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             IsSpellCheckEnabled="False"
                                                             Foreground="{StaticResource RuInkBrush}">
                                                        <TextBox.Resources>
                                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                            <Thickness x:Key="TextControlThemePadding">0</Thickness>
                                                        </TextBox.Resources>
                                                    </TextBox>
                                                </Grid>
                                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.5" />
                                                <!--
                                                  Small, letter-spaced, muted: a section label
                                                  that names the list and then gets out of the
                                                  way. It carries the count because the count is
                                                  what tells the user this is a search box and
                                                  not a short list still loading.
                                                -->
                                                <TextBlock x:Name="FixedProvidersHeader"
                                                           Text="PROVIDERS"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           CharacterSpacing="80"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           Margin="12,8,12,4" />
                                                <Grid>
                                                    <!--
                                                      The catalog is ~190 rows. They go through a
                                                      ListView so the list is virtualized: only the
                                                      visible rows become UI elements. Building a
                                                      Button per provider in a StackPanel threw
                                                      0x800F1000 partway through the catalog and the
                                                      picker silently stopped in the C's.
                                                      VerticalAlignment is Top and the height comes
                                                      from the code-behind: a ListView measured by an
                                                      unbounded parent never virtualizes.
                                                    -->
                                                    <ListView x:Name="ProviderListView"
                                                              VerticalAlignment="Top"
                                                              MaxHeight="200"
                                                              SelectionMode="None"
                                                              IsItemClickEnabled="True"
                                                              ItemClick="OnProviderRowClicked"
                                                              Padding="0,0,0,6"
                                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListView.Resources>
                                                            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                                                            <x:Double x:Key="ScrollBarSize">8</x:Double>
                                                        </ListView.Resources>
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0" />
                                                                <Setter Property="MinHeight" Value="0" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ProviderRow">
                                                                <!--
                                                                  Row rhythm: a 32px line gives a long list a
                                                                  comfortable scanning cadence, and the 14px
                                                                  inset matches the header above so the first
                                                                  character of every name lines up with the
                                                                  section label over it, which is why nothing
                                                                  sits to the left of the label. The key dot
                                                                  lives in the trailing cluster instead: as a
                                                                  leading column it pushed labelled rows 16px
                                                                  right of unlabelled ones and broke the edge.
                                                                -->
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      MinHeight="32"
                                                                      Padding="12,0,8,0"
                                                                      Visibility="{x:Bind RowVisibility, Mode=OneWay}">
                                                                     <TextBlock Text="{x:Bind DisplayName}"
                                                                               FontFamily="{StaticResource RuUiFontFamily}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource RuInkBrush}"
                                                                               FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8"
                                                                                VerticalAlignment="Center">
                                                                        <Ellipse Width="6" Height="6"
                                                                                 Fill="{StaticResource RuSuccessBrush}"
                                                                                 Visibility="{x:Bind KeyDotVisibility, Mode=OneWay}"
                                                                                 AutomationProperties.Name="Key stored" />
                                                                        <FontIcon Glyph="&#xE73E;"
                                                                                  FontSize="11.5"
                                                                                  Foreground="{StaticResource RuInkBrush}"
                                                                                  Visibility="{x:Bind CheckVisibility, Mode=OneWay}"
                                                                                  AutomationProperties.Name="Selected provider" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                     <TextBlock x:Name="ProviderNoMatchText"
                                                               Text="No provider matches"
                                                               FontFamily="{StaticResource RuUiFontFamily}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource RuMutedBrush}"
                                                               Margin="12,8,12,12"
                                                               Visibility="Collapsed" />
                                                 </Grid>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- Provider API key row: the key comes before the test. -->
                            <StackPanel x:Name="ModelsDevApiKeyRow" Spacing="16">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="ModelsDevApiKeyLabel" Text="API key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="Stored in Windows Credential Manager; saving is automatic." Style="{StaticResource SettingDescStyle}" />
                                        <TextBlock x:Name="ModelsDevKeyStatus"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource RuMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="CloudflareAccountIdBox"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=ModelsDevApiKeyLabel}"
                                                 PlaceholderText="Account ID"
                                                 ToolTipService.ToolTip="Cloudflare dashboard → Account ID (Workers AI)."
                                                 Width="150"
                                                 Height="36"
                                                 CornerRadius="{StaticResource AppControlCornerRadius}"
                                                 Visibility="Collapsed" />
                                        <PasswordBox x:Name="ModelsDevApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=ModelsDevApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource AppControlCornerRadius}"
                                                     PasswordRevealMode="Hidden"
                                                     PasswordChanged="OnModelsDevKeyPasswordChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--
                              A stored key is not a working key; this asks the endpoint.
                              The status sits in the same grid so it reads as the result
                              of the button beside it.
                            -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Connection" Style="{StaticResource SettingLabelStyle}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <FontIcon x:Name="ProviderTestStatusIcon"
                                                  Glyph="&#xE946;"
                                                  FontSize="12"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:Name="ProviderTestStatusText"
                                                   Grid.Column="1"
                                                   Text="Not tested yet. The test checks the key and loads the model list."
                                                   Style="{StaticResource SettingDescStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="ProviderTestButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Content="Test connection"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource RuPrimaryButtonStyle}"
                                        AutomationProperties.Name="Test provider connection"
                                        Click="OnProviderTestClick" />
                            </Grid>

                            <!-- Custom Endpoint URL Row -->
                            <StackPanel x:Name="CustomEndpointRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomServerUrlLabel" Text="Custom Server URL" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="OpenAI-compatible endpoint URL" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="CustomEndpointUrlBox"
                                             Grid.Column="1"
                                             AutomationProperties.LabeledBy="{Binding ElementName=CustomServerUrlLabel}"
                                             PlaceholderText="http://localhost:8000/v1"
                                             Width="260"
                                             Height="36"
                                             CornerRadius="{StaticResource AppControlCornerRadius}" />
                                </Grid>
                            </StackPanel>

                            <!-- Custom API Key Row -->
                            <StackPanel x:Name="CustomApiKeyRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomApiKeyLabel" Text="Custom API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="CustomApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=CustomApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource AppControlCornerRadius}"
                                                     PasswordRevealMode="Hidden" />
                                        <Button x:Name="CustomSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="custom"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderCustom"
                                                CornerRadius="{StaticResource AppControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                            <TextBlock Text="Keys are stored in Windows Credential Manager and sent only to the provider you choose."
                                       Style="{StaticResource SettingDescStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
