<UserControl
    x:Class="RuApp.Views.ControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:RuApp.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Coding Agent Control Panel"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource RuInkBrush}" />

        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
            <TextBox x:Name="InstructionBox"
                     Header="Instruction"
                     PlaceholderText="Describe tasks for the agent..." />
            <TextBox x:Name="WorkspaceBox"
                     Header="Workspace"
                     Text="{x:Bind DefaultWorkspace, Mode=OneTime}" />
            <ComboBox x:Name="PresetBox"
                      Header="Permission Preset"
                      SelectedIndex="0">
                <ComboBoxItem Content="Standard" Tag="standard" />
                <ComboBoxItem Content="Full Access" Tag="full_access" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Content="Create &amp; Run" Click="OnStartClick" />
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
                <Button x:Name="ContinueButton" Content="Continue" Click="OnContinueClick" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource RuMutedBrush}" />

        <Border Grid.Row="3"
                x:Name="TrustPanel"
                Visibility="Collapsed"
                Background="{StaticResource RuSurfaceBrush}"
                BorderBrush="{StaticResource RuAccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Workspace requires confirmation"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock x:Name="TrustText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RuInkBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TrustDenyButton"
                            Content="Deny workspace"
                            Click="OnTrustDenyClick" />
                    <Button x:Name="TrustApproveButton"
                            Content="Trust workspace"
                            Click="OnTrustApproveClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                x:Name="ApprovalPanel"
                Visibility="Collapsed"
                Background="{StaticResource RuSurfaceBrush}"
                BorderBrush="{StaticResource RuAccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Agent requires approval for an action"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock x:Name="ApprovalText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource RuInkBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApprovalDenyButton"
                            Content="Deny"
                            Click="OnApprovalDenyClick" />
                    <Button x:Name="ApprovalApproveButton"
                            Content="Approve once"
                            Click="OnApprovalApproveClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView Grid.Row="5"
                  x:Name="EventList"
                  Header="Security Events">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:AgentEventModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Sequence}"
                                   Foreground="{StaticResource RuMutedBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind EventType}"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind SafeSummary}"
                                   Foreground="{StaticResource RuAccentBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
