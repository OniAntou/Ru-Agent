<UserControl
    x:Class="RuApp.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,16" HorizontalAlignment="Stretch">
                <Border MaxWidth="560"
                        HorizontalAlignment="Right"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuAccentBrush}"
                        BorderThickness="0,0,2,0"
                        Padding="14,10">
                    <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                            FontSize="16"
                                            Foreground="{StaticResource RuInkBrush}"
                                            FontFamily="{StaticResource RuUiFontFamily}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,18" HorizontalAlignment="Stretch">
                <Grid MaxWidth="700"
                      HorizontalAlignment="Left"
                      ColumnDefinitions="2,*">
                    <Rectangle x:Name="AssistantAccentRule"
                               Grid.Column="0"
                               Width="2"
                               Fill="{StaticResource RuAccentBrush}"
                               Opacity="0.72"
                               VerticalAlignment="Stretch" />
                    <StackPanel Grid.Column="1"
                                Spacing="6"
                                Margin="12,0,0,0">
                        <TextBlock Text="Ru"
                                   FontFamily="{StaticResource RuDisplayFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource RuAccentBrush}" />
                        <Rectangle x:Name="TypingCaret"
                                   Width="1"
                                   Height="20"
                                   Fill="{StaticResource RuAccentBrush}"
                                   Visibility="{x:Bind ShowTypingDots, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                                FontSize="16"
                                                Foreground="{x:Bind IsError, Converter={StaticResource ErrorColorConverter}}"
                                                FontFamily="{StaticResource RuUiFontFamily}"
                                                Visibility="{x:Bind ShowContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <views:ChatMessageTemplateSelector x:Key="ChatTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Background="{StaticResource RuCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InputContainer.Padding" Value="0,6,0,18" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="16,12" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SuggestionPanel.Orientation" Value="Vertical" />
                        <Setter Target="SuggestionPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="InputContainer.Padding" Value="0,4,0,12" />
                        <Setter Target="InputBorder.Padding" Value="4,2" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:MeteorShowerField x:Name="MeteorShowerField"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />

        <Grid x:Name="ReadingColumn"
              Grid.Row="0"
              HorizontalAlignment="Center"
              Background="Transparent">
            <StackPanel x:Name="WelcomeHeroPanel"
                        MaxWidth="820"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="18"
                        Margin="24,16"
                        Visibility="Visible">
                <TextBlock x:Name="WelcomeEyebrow"
                           Text="RU / CONVERSATIONAL RUNTIME"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{StaticResource RuMutedBrush}" />
                <TextBlock Text="Ru"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="14"
                           Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock x:Name="WelcomeIntro"
                           Text="Chào anh. Hôm nay mình bắt đầu từ đâu?"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="28"
                           Foreground="{StaticResource RuInkBrush}"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SuggestionPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="24">
                    <Button Tag="Hỏi về một việc đang làm"
                            Click="OnSuggestionClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource RuMutedBrush}"
                            Padding="0,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}"
                            ToolTipService.ToolTip="Hỏi về một việc đang làm">
                        <TextBlock Text="Hỏi về một việc đang làm"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                    <Button Tag="Nói cho Ru nghe"
                            Click="OnSuggestionClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource RuMutedBrush}"
                            Padding="0,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}"
                            ToolTipService.ToolTip="Nói cho Ru nghe">
                        <TextBlock Text="Nói cho Ru nghe"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="ChatScrollHost"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Bottom"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Grid x:Name="ChatContentGrid" HorizontalAlignment="Center">
                    <ListView x:Name="ChatListView"
                              AutomationProperties.AutomationId="ChatMessages"
                              Padding="16,16,16,16"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical"
                                                 HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="InputContainer"
              Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto"
              Width="820"
              MaxWidth="820"
              Background="Transparent"
              Padding="0,8,0,24"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center">
            <TextBlock x:Name="VoiceConversationStatusText"
                       Grid.Row="0"
                       Text=""
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="VoiceConversationStatus"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{StaticResource RuMutedBrush}"
                       Margin="8,0,8,6" />
            <Border x:Name="AgentApprovalCard"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RuControlCornerRadius}"
                    Padding="12,10"
                    Margin="8,0,8,8"
                    AutomationProperties.AutomationId="AgentApprovalCard"
                    AutomationProperties.Name="Yêu cầu phê duyệt một lần cho hành động của Agent"
                    AutomationProperties.LiveSetting="Polite">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Text="Ru cần anh duyệt một hành động"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RuAccentBrush}" />
                    <TextBlock x:Name="AgentApprovalActionText"
                               Grid.Row="1"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource RuInkBrush}" />
                    <TextBlock x:Name="AgentApprovalPreviewText"
                               Grid.Row="2"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12"
                               IsTextSelectionEnabled="False"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="AgentApprovalPreviewText"
                               Foreground="{StaticResource RuMutedBrush}" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="AgentApprovalScopeText"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <TextBlock x:Name="AgentApprovalExpiryText"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource RuMutedBrush}" />
                        </StackPanel>
                        <Button x:Name="AgentRejectButton"
                                Grid.Column="1"
                                Content="Từ chối"
                                Click="OnAgentRejectClick"
                                Padding="12,6"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="Transparent"
                                BorderBrush="{StaticResource RuLineBrush}"
                                Foreground="{StaticResource RuMutedBrush}"
                                AutomationProperties.AutomationId="AgentRejectButton"
                                AutomationProperties.Name="Từ chối hành động này một lần" />
                        <Button x:Name="AgentApproveButton"
                                Grid.Column="2"
                                Content="Duyệt một lần"
                                Click="OnAgentApproveClick"
                                Padding="12,6"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="{StaticResource RuAccentBrush}"
                                BorderThickness="0"
                                Foreground="White"
                                AutomationProperties.AutomationId="AgentApproveButton"
                                AutomationProperties.Name="Duyệt hành động này một lần" />
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="InputBorder"
                    Grid.Row="2"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RuControlCornerRadius}"
                    Padding="10,10,10,8">
                <Grid RowDefinitions="Auto,Auto">
                    <TextBox x:Name="ChatInputTextBox"
                             Grid.Row="0"
                             AutomationProperties.AutomationId="ChatInput"
                             PlaceholderText="Viết cho Ru..."
                             PreviewKeyDown="OnChatInputPreviewKeyDown"
                             AcceptsReturn="True"
                             MinHeight="44"
                             MaxHeight="150"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="{StaticResource RuUiFontFamily}"
                             FontSize="15"
                             Padding="4,2,4,6"
                             Foreground="{StaticResource RuInkBrush}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,Auto,*,Auto"
                          Margin="0,4,0,0">
                        <Button x:Name="MicButton"
                                Grid.Column="0"
                                Click="OnMicClick"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="MicButton"
                                AutomationProperties.Name="Bắt đầu trò chuyện bằng giọng nói"
                                ToolTipService.ToolTip="Nói chuyện với Ru bằng giọng nói">
                            <FontIcon x:Name="MicIcon"
                                      Glyph="&#xE720;"
                                      FontSize="14"
                                      Foreground="{StaticResource RuMutedBrush}" />
                        </Button>

                        <StackPanel x:Name="ModeSelector"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                            <Button x:Name="ModeChatButton"
                                    Click="OnModeChatClick"
                                    Height="32"
                                    Padding="10,0"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    AutomationProperties.AutomationId="ModeChatButton"
                                    AutomationProperties.Name="Chế độ trò chuyện thông thường, chỉ đọc workspace"
                                    ToolTipService.ToolTip="Chế độ trò chuyện thông thường, chỉ đọc workspace"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource RuMutedBrush}">
                                <TextBlock Text="Chat" FontSize="12" FontFamily="{StaticResource RuUiFontFamily}" VerticalAlignment="Center" />
                            </Button>
                            <ToggleButton x:Name="ModeAgentButton" Click="OnModeAgentClick"
                                          Height="32"
                                          Padding="10,0"
                                          CornerRadius="{StaticResource RuControlCornerRadius}"
                                          AutomationProperties.AutomationId="AgentModeButton"
                                          AutomationProperties.Name="Bật chế độ Agent cho session này với workspace và terminal giới hạn"
                                          ToolTipService.ToolTip="Bật/tắt chế độ Agent"
                                          Background="Transparent"
                                          BorderBrush="{StaticResource RuLineBrush}"
                                          BorderThickness="1"
                                          Foreground="{StaticResource RuMutedBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" />
                                    <TextBlock Text="Agent" FontSize="12" FontFamily="{StaticResource RuUiFontFamily}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="ModeFullButton"
                                    Click="OnModeFullClick"
                                    Height="32"
                                    Padding="10,0"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    AutomationProperties.AutomationId="ModeFullButton"
                                    AutomationProperties.Name="Bật Full Access với shell tự do trên toàn hệ thống và mạng được phép"
                                    ToolTipService.ToolTip="Bật Full Access với shell tự do trên toàn hệ thống và mạng được phép"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource RuMutedBrush}">
                                <TextBlock Text="Full" FontSize="12" FontFamily="{StaticResource RuUiFontFamily}" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="AgentActivity"
                                   Grid.Column="2"
                                   Text=""
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"
                                   Margin="10,0,8,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="AgentActivity"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{StaticResource RuMutedBrush}" />

                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                AutomationProperties.AutomationId="SendButton"
                                Click="OnSendClick"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="{StaticResource RuAccentBrush}"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Gửi tin nhắn">
                            <FontIcon Glyph="&#xE725;" FontSize="13" Foreground="White" Margin="-1,1,0,0" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
