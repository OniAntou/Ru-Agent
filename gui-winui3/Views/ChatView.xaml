<UserControl
    x:Class="RuApp.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:services="using:RuApp.Services"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d"
    KeyDown="OnChatSurfaceKeyDown"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!--
          Row-detail toggle: an activity row's header with none of the button
          chrome in any state. Hover and press change nothing; the chevron flip is
          the only affordance. Keyboard focus still draws the system rectangle.
          It serves every row that has something to fold away — today the thinking
          quote block and the edit diff.
        -->
        <Style x:Key="RowDetailToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter x:Name="Content"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="Center">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked" />
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,16" HorizontalAlignment="Stretch">
                <Grid x:Name="MessageColumn"
                      HorizontalAlignment="Center"
                      Loaded="OnMessageColumnLoaded">
                <!-- The user bubble is a tail, not a card: the bottom-right
                     corner pulls in to 4 so the message points back at the
                     composer. Every other corner stays on the flyout step. -->
                <Border MaxWidth="620"
                        HorizontalAlignment="Right"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="14,14,4,14"
                        Padding="16,12">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy Content" Click="OnCopyMessageContentClick" Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rewind to Here" Click="OnRewindToMessageClick" Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind Attachments, Mode=OneWay}"
                                      Visibility="{x:Bind HasAttachments, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageAttachmentItem">
                                    <Grid Margin="0,0,0,4">
                                        <!-- Image Rendering -->
                                        <Border Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 MaxWidth="240" MaxHeight="180" Width="140" Height="105" CornerRadius="{StaticResource AppCardCornerRadius}"
                                                Background="{StaticResource RuCanvasBrush}"
                                                BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                ToolTipService.ToolTip="Click to view full image">
                                            <HyperlinkButton Click="OnImageAttachmentClick" Tag="{x:Bind}"
                                                             AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                                                             Padding="0" Background="Transparent" BorderThickness="0"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                                            </HyperlinkButton>
                                        </Border>

                                        <!-- Document / Code File Pill Badge -->
                                        <Border Visibility="{x:Bind IsDocument, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                                Background="{StaticResource RuCanvasBrush}"
                                                BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind FileIconGlyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource RuAccentBrush}" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MarkdownBlock x:Name="AgentLegacyTextBlock"
                                                MarkdownText="{x:Bind Content, Mode=OneWay}"
                                                Foreground="{StaticResource RuInkBrush}"
                                                FontFamily="{StaticResource RuUiFontFamily}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AgentActivityTemplate" x:DataType="models:AgentActivityItem">
            <Grid Margin="0,8"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind IsVisibleInFeed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  Loaded="OnActivityItemLoaded"
                  Unloaded="OnActivityItemUnloaded"
                   DataContextChanged="OnActivityItemDataContextChanged"
                   AutomationProperties.LiveSetting="Polite">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                      <TextBlock Grid.Column="0"
                                 x:Name="AgentActivityText"
                                 Text="{x:Bind DisplayText, Mode=OneWay}"
                                 Visibility="{x:Bind ShowPlainHeader, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 FontFamily="{StaticResource RuUiFontFamily}"
                                FontWeight="SemiBold"
                               Foreground="{StaticResource RuInkBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0" />
                      <!--
                        The 20px is the fold chevron's place, kept even when the row has
                        no toggle: a hidden box that still takes width (14px) plus its
                        spacing (6px). Without it a run of terminal and thinking rows
                        starts every other line at a different x, which reads as two
                        columns that belong to different things.
                      -->
                      <!--
                        Thinking header is its own toggle: the chevron opens the
                        quote block below. A plain header here would duplicate the
                        label and leave nothing clickable.
                      -->
                      <ToggleButton Grid.Column="0"
                                    x:Name="ThinkingToggle"
                                    Visibility="{x:Bind HasThinkingDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    IsChecked="{x:Bind IsThinkingExpanded, Mode=TwoWay}"
                                    Style="{StaticResource RowDetailToggleStyle}"
                                    VerticalAlignment="Center"
                                    PointerEntered="OnActivityTogglePointerEntered"
                                    PointerExited="OnActivityTogglePointerExited"
                                    GotFocus="OnActivityToggleGotFocus"
                                    LostFocus="OnActivityToggleLostFocus"
                                    AutomationProperties.Name="Toggle thinking details">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Grid Width="14" VerticalAlignment="Center">
                                  <FontIcon Glyph="{x:Bind ThinkingChevronGlyph, Mode=OneWay}"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Visibility="Collapsed"
                                            Foreground="{StaticResource RuMutedBrush}"
                                            VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock x:Name="ThinkingLabel"
                                         Text="{x:Bind DisplayText, Mode=OneWay}"
                                         FontFamily="{StaticResource RuUiFontFamily}"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource RuInkBrush}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                          </StackPanel>
                       </ToggleButton>
                       <!--
                         The edit row's header is a toggle for the same reason: a long
                         diff below it is worth folding, and the panel no longer
                         carries a header of its own to click, so the line the reader
                         is already looking at is the one that opens it.
                       -->
                       <ToggleButton Grid.Column="0"
                                     x:Name="EditPreviewToggle"
                                     Visibility="{x:Bind ShowRowDetailToggle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     IsChecked="{x:Bind IsEditPreviewExpanded, Mode=TwoWay}"
                                     Style="{StaticResource RowDetailToggleStyle}"
                                     VerticalAlignment="Center"
                                     PointerEntered="OnActivityTogglePointerEntered"
                                     PointerExited="OnActivityTogglePointerExited"
                                     GotFocus="OnActivityToggleGotFocus"
                                     LostFocus="OnActivityToggleLostFocus"
                                     AutomationProperties.Name="Toggle edit preview">
                           <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                               <Grid Width="14" VerticalAlignment="Center">
                                   <FontIcon Glyph="{x:Bind EditPreviewChevronGlyph, Mode=OneWay}"
                                             FontFamily="Segoe MDL2 Assets"
                                             FontSize="12"
                                             Visibility="Collapsed"
                                             Foreground="{StaticResource RuMutedBrush}"
                                             VerticalAlignment="Center" />
                               </Grid>
                               <TextBlock x:Name="EditPreviewLabel"
                                          Text="{x:Bind DisplayText, Mode=OneWay}"
                                          FontFamily="{StaticResource RuUiFontFamily}"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource RuInkBrush}"
                                          TextWrapping="Wrap"
                                          VerticalAlignment="Center" />
                           </StackPanel>
                       </ToggleButton>
                      <!--
                        The subject and its line counts are two different things: the pill
                        frames the file, and the counts stand beside it. A border around both
                        made the numbers read as part of the frame instead of as the change.
                      -->
                      <StackPanel Grid.Column="1"
                                  x:Name="ActivityMetaPanel"
                                  Orientation="Horizontal"
                                  Spacing="6"
                                  VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind OccurredAtLabel, Mode=OneWay}"
                                         ToolTipService.ToolTip="When this step happened"
                                         FontFamily="{StaticResource RuMonoFontFamily}"
                                         FontSize="11"
                                         Foreground="{StaticResource RuMutedBrush}"
                                         VerticalAlignment="Center" />
                      <Border Visibility="{x:Bind HasMetadata, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              Background="{StaticResource RuSurfaceBrush}"
                              BorderBrush="{StaticResource RuLineBrush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource AppControlCornerRadius}"
                              Padding="8,3"
                              VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="4"
                                  VerticalAlignment="Center">
                           <TextBlock Text="{x:Bind MetadataText, Mode=OneWay}"
                                      Visibility="{x:Bind HasNoLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      FontFamily="{StaticResource RuMonoFontFamily}"
                                      FontSize="12.5"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource RuInkBrush}"
                                      VerticalAlignment="Center" />
                           <TextBlock Text="{x:Bind BaseMetadataText, Mode=OneWay}"
                                      Visibility="{x:Bind HasLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      FontFamily="{StaticResource RuMonoFontFamily}"
                                      FontSize="12.5"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource RuInkBrush}"
                                      VerticalAlignment="Center" />
                      </StackPanel>
                      </Border>
                         <TextBlock Text="·"
                                    Visibility="{x:Bind HasLineDeltaAndBaseMetadata, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    FontFamily="{StaticResource RuMonoFontFamily}"
                                    FontSize="11"
                                    Foreground="{StaticResource RuMutedBrush}"
                                    VerticalAlignment="Center" />
                         <TextBlock Text="{x:Bind AddedDeltaText, Mode=OneWay}"
                                    Visibility="{x:Bind HasLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    FontFamily="{StaticResource RuMonoFontFamily}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource RuSuccessBrush}"
                                    VerticalAlignment="Center" />
                         <TextBlock Text="{x:Bind RemovedDeltaText, Mode=OneWay}"
                                    Visibility="{x:Bind HasLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    FontFamily="{StaticResource RuMonoFontFamily}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource RuDangerBrush}"
                                    VerticalAlignment="Center" />
                      </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1"
                           x:Name="ActivityDetailText"
                           Text="{x:Bind Detail, Mode=OneWay}"
                           Visibility="{x:Bind ShowPlainDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="11.5"
                           Foreground="{StaticResource RuMutedBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="560"
                           Margin="20,2,0,0" />
                <!--
                  Thinking deliberation as a quote block: canvas fill to set it off the
                  chat, muted text so the reply below stays the visual focus. Closed by
                  default. The accent bar down its left edge is gone: the fill already
                  separates it, and the bar read as one more line beside the words.
                -->
                <Border Grid.Row="1"
                        Visibility="{x:Bind ShowThinkingDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource RuCanvasBrush}"
                        CornerRadius="{StaticResource AppCardCornerRadius}"
                        Padding="12,10"
                        Margin="0,6,0,0"
                        MaxWidth="560"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12.5"
                               LineHeight="20"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" />
                </Border>
                  <controls:FileEditPreviewControl Grid.Row="2"
                                                    Visibility="{x:Bind ShowEditPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    BeforeText="{x:Bind EditBeforeText, Mode=OneWay}"
                                                    AfterText="{x:Bind EditAfterText, Mode=OneWay}"
                                                    StartLine="{x:Bind LineStart, Mode=OneWay}"
                                                    Margin="0,8,0,2"
                                                   AutomationProperties.Name="File edit preview" />
                  <!--
                    A terminal row's detail is what the command printed. Same clothes as the
                    diff panel (mono, hairline, folded until asked for) because both answer
                    the same question: what did this row actually do. Same row as the diff
                    since a row carries one detail or the other, never both.
                  -->
                  <Grid Grid.Row="2"
                      Visibility="{x:Bind ShowTerminalOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,8,0,2">
                      <Border
                              Background="{StaticResource RuSurfaceBrush}"
                              BorderBrush="{StaticResource RuLineBrush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource AppCardCornerRadius}"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Terminal output">
                          <ScrollViewer MaxHeight="220"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollMode="Enabled"
                                        Padding="12,8,12,8">
                              <TextBlock Text="{x:Bind TerminalPanelText, Mode=OneWay}"
                                         FontFamily="{StaticResource RuMonoFontFamily}"
                                         FontSize="12"
                                         Foreground="{StaticResource RuInkBrush}"
                                         TextWrapping="NoWrap"
                                         IsTextSelectionEnabled="True" />
                          </ScrollViewer>
                      </Border>
                      <!-- The copy button floats over the panel rather than taking a row
                            above it: the block keeps the height it had, and the icon only
                            paints on hover, so output stays readable underneath. -->
                      <Button HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="4"
                              Style="{StaticResource RuToolbarButtonStyle}"
                              Tag="{x:Bind TerminalPanelText, Mode=OneWay}"
                              Click="OnCopyTerminalOutputClick"
                              ToolTipService.ToolTip="Copy terminal output"
                              AutomationProperties.Name="Copy terminal output">
                              <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                      </Button>
                  </Grid>
                <!--
                  State bindings for automation and contract tests. They sit in their own row
                  and take no space. Anything without a Grid.Row lands in row 0 on top of the
                  header, which is exactly how the checklist used to overlap its own label.
                -->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Border Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                    <Border Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                    <Border Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                    <Border Visibility="{x:Bind IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,28" HorizontalAlignment="Stretch">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy Content" Click="OnCopyMessageContentClick" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Rewind to Here" Click="OnRewindToMessageClick" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid x:Name="MessageColumn"
                      HorizontalAlignment="Center"
                      Loaded="OnMessageColumnLoaded">
                <StackPanel MaxWidth="820"
                            HorizontalAlignment="Left"
                            Spacing="16">
                    <ItemsControl AutomationProperties.AutomationId="AgentActivitySegments"
                                  AutomationProperties.Name="Agent Activity Timeline"
                                  ItemsSource="{x:Bind Segments, Mode=OneWay}"
                                  ItemTemplateSelector="{StaticResource AssistantSegmentSelector}"
                                  Visibility="{x:Bind HasSegments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!--
                      Tool traffic is a timeline, not prose: a hairline down its left edge
                      and a small indent group it, so a reply's own words are not read as
                      one more tool row.
                    -->
                    <Border BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="12,2,0,2"
                            Visibility="{x:Bind ShowLegacyActivityFeed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl AutomationProperties.AutomationId="AgentActivityFeed"
                                  AutomationProperties.Name="Agent Activity Feed"
                                  AutomationProperties.LiveSetting="Polite"
                                  ItemsSource="{x:Bind AgentActivities, Mode=OneWay}"
                                  ItemTemplate="{StaticResource AgentActivityTemplate}"
                                  Visibility="{x:Bind ShowLegacyActivityFeed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    </Border>
                    <controls:MarkdownBlock x:Name="AgentReplyTextBlock"
                                            MarkdownText="{x:Bind Content, Mode=OneWay}"
                                            Visibility="{x:Bind ShowLegacyText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Foreground="{x:Bind IsError, Converter={StaticResource ErrorColorConverter}}"
                                            FontFamily="{StaticResource RuUiFontFamily}" />
                    <!--
                      An error that has somewhere to go next offers that place. A
                      missing provider key is the case this exists for: the message
                      names the fix and the button opens the screen that performs it.
                    -->
                    <Button AutomationProperties.AutomationId="ChatMessageActionButton"
                            Content="{x:Bind ActionLabel, Mode=OneWay}"
                            Tag="{x:Bind ActionKind, Mode=OneWay}"
                            Click="OnMessageActionClick"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Background="{StaticResource RuSurfaceBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource RuInkBrush}"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            Visibility="{x:Bind HasAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTextSegmentTemplate" x:DataType="models:TextSegment">
            <controls:MarkdownBlock MarkdownText="{x:Bind Text, Mode=OneWay}"
                                    Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    FontSize="14"
                                    Foreground="{x:Bind IsError, Converter={StaticResource ErrorColorConverter}}"
                                    FontFamily="{StaticResource RuUiFontFamily}" />
        </DataTemplate>

        <DataTemplate x:Key="AssistantActivitySegmentTemplate" x:DataType="models:ActivitySegment">
            <ContentPresenter Content="{x:Bind Item, Mode=OneWay}"
                              ContentTemplate="{StaticResource AgentActivityTemplate}" />
        </DataTemplate>

        <views:AssistantSegmentTemplateSelector x:Key="AssistantSegmentSelector"
                                                       TextTemplate="{StaticResource AssistantTextSegmentTemplate}"
                                                       ActivityTemplate="{StaticResource AssistantActivitySegmentTemplate}" />

        <views:ChatMessageTemplateSelector x:Key="ChatTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Background="{StaticResource RuCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InputContainer.Padding" Value="0,6,0,18" />
                        <Setter Target="InputContainer.Margin" Value="16,0" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="16,12" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SuggestionPanel.Orientation" Value="Vertical" />
                        <Setter Target="SuggestionPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="InputContainer.Padding" Value="0,4,0,12" />
                        <Setter Target="InputContainer.Margin" Value="12,0" />
                        <Setter Target="InputBorder.Padding" Value="4,2" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:MeteorShowerField x:Name="MeteorShowerField"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />

        <!-- Starry Night welcome backdrop: Van Gogh's 1889 painting, public
             domain (Google Art Project scan), with a canvas scrim so the hero
             greeting stays readable over the bright swirls. Visible only for
             the Starry Night theme while no session is open. -->
        <Image x:Name="StarryPainting"
               Grid.Row="0"
               Grid.RowSpan="2"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Stretch="UniformToFill"
               Source="ms-appx:///Assets/StarryNight.jpg"
               Visibility="Collapsed"
               IsHitTestVisible="False"
               AutomationProperties.Name="The Starry Night by Vincent van Gogh" />
        <!-- Living layer: twinkles pinned to the painted stars plus slow glows
             around the two vortexes. Cover-fit mapped, so it tracks the Image
             above at any window size. -->
        <controls:StarryLivingField x:Name="StarryLivingField"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />
        <Border x:Name="StarryScrim"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#00232F4C" />
                    <GradientStop Offset="0.55" Color="#66232F4C" />
                    <GradientStop Offset="1.0" Color="#B3232F4C" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="ReadingColumn"
              Grid.Row="0"
              HorizontalAlignment="Stretch"
              Background="Transparent">
            <StackPanel x:Name="WelcomeHeroPanel"
                        MaxWidth="820"
                        HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         Spacing="16"
                         Margin="24,16"
                        Visibility="Visible">

                <TextBlock
                           Text="Hello. Where should we start today?"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RuInkBrush}"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SuggestionPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="12">
                    <Button Tag="Ask about a task in progress"
                            Click="OnSuggestionClick"
                            Background="{StaticResource RuSurfaceBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource RuInkBrush}"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" />
                            <TextBlock Text="Ask about a task in progress"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="13"
                                       Foreground="{StaticResource RuInkBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Virtualized history: the ListView owns its scroll host so long
                 conversations realize only visible rows instead of the whole feed. -->
            <Grid x:Name="ChatContentGrid"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed">
                <ListView x:Name="ChatListView"
                           AutomationProperties.AutomationId="ChatMessages"
                           Padding="20,20,20,12"
                          SelectionMode="None"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.IsVerticalRailEnabled="True">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuAccentColor}" />
                        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                        <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                        <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                        <x:Double x:Key="ScrollBarSize">8</x:Double>
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical"
                                             HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

            </Grid>
        </Grid>

        <Button x:Name="NewMessagesPill"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                Visibility="Collapsed"
                Click="OnNewMessagesPillClick"
                AutomationProperties.AutomationId="NewMessagesPill"
                AutomationProperties.Name="Jump to latest messages"
                Background="{StaticResource RuSurfaceBrush}"
                Foreground="{StaticResource RuInkBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppPillCornerRadius}"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE74B;" FontSize="12" Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock Text="New messages"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RuInkBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Approval overlay: declared before the input (XAML parse fails when
          it trails the composer) and raised above it with a ZIndex, so a
          pending decision floats over the todo panel and the input instead
          of shoving them upward. -->
        <Grid Grid.Row="1"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              MaxWidth="820"
              Margin="16,0,16,24"
              Canvas.ZIndex="20">
            <controls:AgentApprovalPanelControl x:Name="ApprovalPanel" />
        </Grid>

            <Grid x:Name="InputContainer"
              Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto,Auto"
              MaxWidth="820"
              Margin="16,0"
              Background="Transparent"
              Padding="0,8,0,24"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch">
            <controls:TerminalPanelControl x:Name="TerminalPanelControl"
                                        Grid.Row="0" />

            <!--
              The agent's standing task list. Its own card above the composer,
              never fused with it: a gap separates the two, depth comes from
              shadow, per the app card style. A count pill, the current task,
              and a progress hairline lead; expanded adds the full read-only
              list, collapsed keeps the header only. Hidden until the first
              todo write, cleared on session switch.
            -->
            <Border x:Name="TodoPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="8,0,8,8"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppCardCornerRadius}"
                    Translation="0,0,4"
                    Shadow="{StaticResource RuRestShadow}"
                    AutomationProperties.Name="Agent task list">
                <Border.Resources>
                    <!-- Collapse toggle: no surface of its own in any state, only
                      the icon tints accent on hover and dims on press. -->
                    <Style x:Key="TodoToggleButtonStyle" TargetType="Button">
                        <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter x:Name="Content"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      Padding="{TemplateBinding Padding}"
                                                      CornerRadius="{StaticResource AppControlCornerRadius}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="Content.Foreground" Value="{StaticResource RuAccentBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="Content.Foreground" Value="{StaticResource RuAccentBrush}" />
                                                        <Setter Target="Content.Opacity" Value="0.7" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Target="Content.Opacity" Value="0.4" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </ContentPresenter>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel Spacing="6" Padding="12,10,12,10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TodoPanelCount"
                                       Grid.Column="0"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuAccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TodoPanelHeader"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <Button x:Name="TodoPanelToggle"
                                    Grid.Column="2"
                                    Click="OnTodoPanelToggleClick"
                                    Style="{StaticResource TodoToggleButtonStyle}"
                                    AutomationProperties.Name="Expand or collapse task list">
                                <FontIcon x:Name="TodoPanelToggleIcon" Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                        </Grid>
                        <ProgressBar x:Name="TodoPanelProgress"
                                     Height="4"
                                     CornerRadius="0"
                                     Background="{StaticResource RuAccentSoftBrush}"
                                     BorderThickness="0">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{ThemeResource RuAccentColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource RuVioletColor}" />
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                        <controls:TodoChecklistControl x:Name="TodoPanelList"
                                                       HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="AgentInlinePanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Spacing="6"
                        Margin="8,0,8,6">
                <!-- Status pill removed per user directive; placeholders preserved for accessibility/automation -->
                <TextBlock x:Name="AgentStatusText"
                           Visibility="Collapsed"
                           AutomationProperties.AutomationId="AgentStatusText"
                           AutomationProperties.LiveSetting="Polite" />
                 <Button x:Name="AgentStopButton"
                         Visibility="Collapsed"
                         Click="OnAgentStopClick"
                         AutomationProperties.AutomationId="AgentStopButton"
                         AutomationProperties.Name="Stop Coding Agent" />

            </StackPanel>

            <Border x:Name="InputBorder"
                    Grid.Row="3"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppCardCornerRadius}"
                    Translation="0,0,6"
                    Shadow="{StaticResource RuRestShadow}"
                    Padding="12,10,12,8"
                    AllowDrop="True"
                    DragOver="OnInputDragOver"
                    Drop="OnInputDrop">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <!--
                      Queued turns: what the user typed while a run was in hand.
                      The composer used to swallow that second thought — Enter did
                      nothing until the turn ended. It waits here instead, in the
                      order it was typed, and goes out when the run ends.
                    -->
                    <Border x:Name="QueuedTurnsPanel"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Queued messages">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="QueuedTurnsHeader"
                                           Grid.Column="0"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="QueuedTurnsSendButton"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Click="OnSendQueuedTurnsClick"
                                        Style="{StaticResource RuToolbarButtonStyle}"
                                        AutomationProperties.Name="Send queued messages">
                                    <TextBlock Text="Send now"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="11"
                                               Foreground="{StaticResource RuAccentBrush}"
                                               VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <ItemsControl x:Name="QueuedTurnsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:QueuedAgentTurn">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="26">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Label}"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource RuInkBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Width="18"
                                                    Height="18"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource RuMutedBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="{StaticResource AppPillCornerRadius}"
                                                    Click="OnRemoveQueuedTurnClick"
                                                    Tag="{x:Bind}"
                                                    AutomationProperties.Name="Remove queued message">
                                                <FontIcon Glyph="&#xE711;" FontSize="8" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Image Attachment Preview Strip -->
                    <ScrollViewer x:Name="AttachmentPreviewContainer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  Margin="0,0,0,8"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="AttachmentPreviewList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageAttachmentItem">
                                    <Grid Margin="0,0,4,0">
                                        <!-- Image Thumbnail Box -->
                                         <Grid Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Width="60" Height="60"
                                              ToolTipService.ToolTip="{x:Bind FormattedSize, Mode=OneWay}">
                                             <Border CornerRadius="{StaticResource AppControlCornerRadius}" Background="{StaticResource RuCanvasBrush}"
                                                     BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1">
                                                 <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"/>
                                             </Border>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Width="18" Height="18" Padding="0" Margin="2"
                                                    Background="{StaticResource RuAccentBrush}" Foreground="{StaticResource RuOnAccentBrush}"
                                                    BorderThickness="0" CornerRadius="{StaticResource AppPillCornerRadius}"
                                                    Click="OnRemoveAttachmentClick" Tag="{x:Bind Id}"
                                                    AutomationProperties.Name="Remove attachment">
                                                <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                            </Button>
                                        </Grid>

                                        <!-- Document / Code File Pill Badge -->
                                         <Grid Visibility="{x:Bind IsDocument, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Height="34">
                                            <Border CornerRadius="{StaticResource AppControlCornerRadius}"
                                                    Background="{StaticResource RuCanvasBrush}"
                                                    BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                    Padding="8,4,4,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind FileIconGlyph, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RuAccentBrush}"/>
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" Margin="0,0,2,0"/>
                                                    <Button Width="18" Height="18" Padding="0"
                                                            Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                                            BorderThickness="0" CornerRadius="{StaticResource AppPillCornerRadius}"
                                                            Click="OnRemoveAttachmentClick" Tag="{x:Bind Id}"
                                                            AutomationProperties.Name="Remove attachment">
                                                        <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBox x:Name="ChatInputTextBox"
                              Grid.Row="2"
                              AutomationProperties.AutomationId="ChatInput"
                              AutomationProperties.Name="Message input"
                              PlaceholderText="Message Ru…"
                             PreviewKeyDown="OnChatInputPreviewKeyDown"
                              AcceptsReturn="True"
                              MinHeight="56"
                              MaxHeight="180"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                              FontFamily="{StaticResource RuUiFontFamily}"
                              FontSize="16"
                              Padding="4,2,4,6"
                             Foreground="{StaticResource RuInkBrush}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Row="3"
                          ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                          Margin="0,4,0,0">
                        <Button x:Name="AttachImageButton"
                                Grid.Column="0"
                                Click="OnAttachImageClick"
                                Width="30"
                                Height="30"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Margin="0"
                                AutomationProperties.AutomationId="AttachImageButton"
                                AutomationProperties.Name="Attach files or images">
                            <FontIcon x:Name="AttachImageIcon"
                                      Glyph="&#xE710;"
                                      FontSize="14"
                                      Foreground="{StaticResource RuMutedBrush}" />
                        </Button>

                        <Button x:Name="HandoffWorkStateButton"
                                Grid.Column="1"
                                Click="OnHandoffWorkStateClick"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Choose a saved run context to hand off">
                            <TextBlock Text="Handoff" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                        </Button>

                        <Button x:Name="AgentModeButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                IsTabStop="False"
                                AutomationProperties.AutomationId="AgentModeButton"
                                AutomationProperties.Name="Coding Agent">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="AgentModeIcon"
                                          Glyph="&#xEC25;"
                                          FontSize="12"
                                          Foreground="{StaticResource RuMutedBrush}" />
                                <TextBlock x:Name="AgentModeLabel"
                                           Text="Agent"
                                           FontSize="12"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <ComboBox x:Name="AgentPresetBox"
                                      Grid.Column="2"
                                      Visibility="Collapsed"
                                       SelectedIndex="1"
                                      SelectionChanged="OnAgentPresetChanged"
                                      AutomationProperties.AutomationId="AgentPresetBox"
                                      AutomationProperties.Name="Agent permission preset"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      Margin="2,0,0,0"
                                      CornerRadius="{StaticResource AppControlCornerRadius}"
                                      FontFamily="{StaticResource RuUiFontFamily}"
                                      FontSize="12"
                                      Foreground="{StaticResource RuMutedBrush}"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Plan" Tag="plan" />
                                <ComboBoxItem Content="Standard" Tag="standard" />
                                <ComboBoxItem Content="Full Access" Tag="full_access" />
                            </ComboBox>

                            <Button x:Name="ChatModelButton"
                                    AutomationProperties.AutomationId="ChatModelButton"
                                    AutomationProperties.Name="Select AI Model"
                                    Padding="6,4"
                                    Margin="0"
                                    CornerRadius="{StaticResource AppControlCornerRadius}"
                                    Style="{StaticResource RuToolbarButtonStyle}"
                                    VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatModelLabel"
                                                Text="Model…"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}"
                                               MaxWidth="160"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChatModelSaveStatusText"
                                               Foreground="{StaticResource RuDangerBrush}"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="120"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <FontIcon Glyph="&#xE70D;"
                                               FontSize="9"
                                               Foreground="{StaticResource RuMutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="ChatModelFlyout" Placement="Top" Opened="OnChatModelFlyoutOpened">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="{StaticResource AppFlyoutCornerRadius}" />
                                                <Setter Property="Padding" Value="3" />
                                                <Setter Property="Width" Value="336" />
                                                <Setter Property="MinWidth" Value="336" />
                                                <Setter Property="MaxWidth" Value="336" />
                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <views:ProviderModelPicker x:Name="ModelPicker"
                                                                   Width="328"
                                                                   SearchTextChanged="OnModelPickerSearchTextChanged"
                                                                   ModelSelected="OnModelPickerModelSelected"
                                                                   DismissRequested="OnModelPickerDismissRequested" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

<Border Width="1" Height="14" Background="{StaticResource RuLineBrush}" Opacity="0.6" Margin="2,0" VerticalAlignment="Center"/>

                            <Button x:Name="ChatReasoningButton"
                                    AutomationProperties.AutomationId="ChatReasoningButton"
                                    AutomationProperties.Name="Select Reasoning Effort"
                                    Padding="6,4"
                                    Margin="0"
                                    CornerRadius="{StaticResource AppControlCornerRadius}"
                                    Style="{StaticResource RuToolbarButtonStyle}"
                                    VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatReasoningLabel"
                                               Text="default"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}"
                                               MaxWidth="100"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;"
                                              FontSize="9"
                                              Foreground="{StaticResource RuMutedBrush}"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="ChatReasoningFlyout" Placement="Top" Opened="OnChatReasoningFlyoutOpened">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="{StaticResource AppFlyoutCornerRadius}" />
                                                <Setter Property="Padding" Value="3" />
                                                <Setter Property="MinWidth" Value="200" />
                                                <Setter Property="MaxWidth" Value="240" />
                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel x:Name="ReasoningOptionsContainer"
                                                    Spacing="0"
                                                    IsTabStop="True"
                                                    KeyDown="OnReasoningContainerKeyDown" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ContextMeterButton"
                                    AutomationProperties.AutomationId="ContextMeterButton"
                                    AutomationProperties.Name="View Context Window capacity"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource AppPillCornerRadius}"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="{StaticResource AppPillCornerRadius}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="{StaticResource AppPillCornerRadius}"
                                                            Width="26"
                                                            Height="26">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressRing x:Name="ContextProgressRing"
                                                  IsIndeterminate="False"
                                                  Value="0"
                                                  Minimum="0"
                                                  Maximum="100"
                                                  Width="18"
                                                  Height="18"
                                                  Foreground="{StaticResource RuAccentBrush}"
                                                  Background="{StaticResource RuLineBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout x:Name="ContextWindowFlyout" Placement="Top">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="{StaticResource AppFlyoutCornerRadius}" />
                                                <Setter Property="Padding" Value="8,6" />
                                                <Setter Property="MinWidth" Value="130" />
                                                <Setter Property="MaxWidth" Value="180" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="RetainedRunIdentityText"
                                                       Visibility="Collapsed"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource RuMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="ContextUsedLabel"
                                                           Text="0 / 128K"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="ContextPercentLabel"
                                                           Grid.Column="1"
                                                           Text="0%"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="4"
                                                    CornerRadius="0"
                                                    Background="{StaticResource RuLineBrush}"
                                                    Opacity="0.9">
                                                <Grid x:Name="ContextBreakdownBar"
                                                      ColumnDefinitions="*,*">
                                                    <Border x:Name="ContextBreakdownFill"
                                                            Grid.Column="0"
                                                            CornerRadius="0"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Offset="0" Color="{ThemeResource RuAccentColor}" />
                                                                <GradientStop x:Name="ContextStopMsg1" Offset="1" Color="{ThemeResource RuAccentColor}" />
                                                                <GradientStop x:Name="ContextStopOv0" Offset="1" Color="{ThemeResource RuVioletColor}" />
                                                                <GradientStop Offset="1" Color="{ThemeResource RuVioletColor}" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Border Width="8"
                                                        Height="8"
                                                        CornerRadius="{StaticResource AppPillCornerRadius}"
                                                        Background="{StaticResource RuAccentBrush}"
                                                        VerticalAlignment="Center" />
                                                <TextBlock x:Name="ContextMessagesLegendLabel"
                                                           Grid.Column="1"
                                                           Text="Visible text/image estimate"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="ContextMessagesLabel"
                                                           Grid.Column="2"
                                                           Text="0"
                                                           FontFamily="{StaticResource RuMonoFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid x:Name="ContextOverheadRow"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="8">
                                                <Border Width="8"
                                                        Height="8"
                                                        CornerRadius="{StaticResource AppPillCornerRadius}"
                                                        Background="{StaticResource RuVioletBrush}"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="System + tools"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="ContextOverheadLabel"
                                                           Grid.Column="2"
                                                           Text="0"
                                                           FontFamily="{StaticResource RuMonoFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="SendButton"
                                    AutomationProperties.AutomationId="SendButton"
                                    AutomationProperties.Name="{x:Bind SendFaceName}"
                                    Click="OnSendClick"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="{StaticResource AppControlCornerRadius}"
                                    Style="{StaticResource RuPrimaryButtonStyle}"
                                    VerticalAlignment="Center">
                                <FontIcon x:Name="SendButtonIcon" Glyph="{x:Bind SendFaceGlyph}" FontSize="14" Foreground="{StaticResource RuOnAccentBrush}" Margin="-1,1,0,0" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
