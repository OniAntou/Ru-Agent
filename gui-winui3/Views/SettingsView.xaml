<UserControl
    x:Class="RuApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDescStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SidebarCategoryHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Margin" Value="8,16,8,4" />
            </Style>

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main 2-Column Settings Modal Container -->
    <Grid x:Name="SettingsRootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="200" />
            <!-- Right Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN: SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="12,16,12,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource SidebarCategoryHeadingStyle}" Margin="8,0,8,6" />
                    <!-- General Tab Button -->
                    <Button x:Name="NavGeneralBtn"
                            Content="General"
                            Click="OnNavGeneralClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <!-- Models / AI Providers Tab Button -->
                    <Button x:Name="NavModelsBtn"
                            Content="Models &amp; Providers"
                            Click="OnNavModelsClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== RIGHT COLUMN: CONTENT ==================== -->
        <Grid Grid.Column="1" Background="{StaticResource RuSurfaceBrush}" RowDefinitions="Auto,*">
            <!-- Header Bar (Category Title & Subtitle) -->
            <Grid Grid.Row="0" Padding="28,20,56,16" BorderBrush="{StaticResource RuLineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CategoryTitleText"
                               Text="General"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource RuDisplayFontFamily}"
                               Foreground="{StaticResource RuInkBrush}" />
                    <TextBlock x:Name="CategorySubtitleText"
                               Text="Manage application theme and agent defaults."
                               FontSize="12.5"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Panels Area -->
            <!-- General Settings Panel -->
            <ScrollViewer x:Name="PanelGeneralScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Visible">
                <StackPanel Spacing="16">
                    <!-- Appearance Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Appearance" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Switch between Dark and Light mode theme" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ThemeButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Appearance theme">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ThemeButtonLabel"
                                                   Text="Dark"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="ThemeDarkOption"
                                                        Tag="dark"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Dark theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeDarkText"
                                                                   Text="Dark"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeDarkCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeLightOption"
                                                        Tag="light"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Light theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeLightText"
                                                                   Text="Light"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeLightCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Agent Capabilities Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Permission Preset" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Standard asks before mutations; Trusted auto-allows workspace actions" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="PresetButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Permission preset">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="PresetButtonLabel"
                                                   Text="Standard"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="PresetStandardOption"
                                                        Tag="standard"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Standard preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetStandardText"
                                                                   Text="Standard"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetStandardCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetTrustedOption"
                                                        Tag="trusted"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Trusted preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="PresetTrustedText"
                                                                   Text="Trusted"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="PresetTrustedCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Models / Providers Panel -->
            <ScrollViewer x:Name="PanelModelsScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <!-- Main Provider & Keys Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- Provider Dropdown Row -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Active Provider" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Choose cloud AI provider or custom server" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ProviderButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Active provider">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ProviderButtonLabel"
                                                   Text="OpenCode Zen (Cloud API)"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="ProviderOpencodeOption"
                                                        Tag="opencode"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="OpenCode Zen provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderOpencodeText"
                                                                   Text="OpenCode Zen (Cloud API)"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderOpencodeCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ProviderKiloOption"
                                                        Tag="kilo"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Kilo Gateway provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderKiloText"
                                                                   Text="Kilo Gateway (Cloud API)"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderKiloCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ProviderOpenaiOption"
                                                        Tag="openai"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="OpenAI provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderOpenaiText"
                                                                   Text="OpenAI (Official API)"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderOpenaiCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ProviderAnthropicOption"
                                                        Tag="anthropic"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Anthropic provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderAnthropicText"
                                                                   Text="Anthropic Claude (Official API)"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderAnthropicCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ProviderCustomOption"
                                                        Tag="custom"
                                                        Click="OnProviderOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Custom server provider">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ProviderCustomText"
                                                                   Text="Custom OpenAI Server"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ProviderCustomCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- OpenCode API Key Row -->
                            <StackPanel x:Name="OpenCodeApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="OpenCodeApiKeyLabel" Text="OpenCode API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="OpenCodeApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=OpenCodeApiKeyLabel}"
                                                     PlaceholderText="sk-opencode-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="OpenCodeSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="opencode"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderOpenCode"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Kilo API Key Row -->
                            <StackPanel x:Name="KiloApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="KiloApiKeyLabel" Text="Kilo API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="Connection key for Kilo Gateway" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="KiloApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=KiloApiKeyLabel}"
                                                     PlaceholderText="sk-kilo-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="KiloSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="kilo"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderKilo"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- OpenAI API Key Row -->
                            <StackPanel x:Name="OpenAiApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="OpenAiApiKeyLabel" Text="OpenAI API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="OpenAiApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=OpenAiApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="OpenAiSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="openai"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderOpenAi"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Anthropic API Key Row -->
                            <StackPanel x:Name="AnthropicApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="AnthropicApiKeyLabel" Text="Anthropic API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="AnthropicApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=AnthropicApiKeyLabel}"
                                                     PlaceholderText="sk-ant-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="AnthropicSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="anthropic"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderAnthropic"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Custom Endpoint URL Row -->
                            <StackPanel x:Name="CustomEndpointRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomServerUrlLabel" Text="Custom Server URL" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="OpenAI-compatible endpoint URL" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="CustomEndpointUrlBox"
                                             Grid.Column="1"
                                             AutomationProperties.LabeledBy="{Binding ElementName=CustomServerUrlLabel}"
                                             PlaceholderText="http://localhost:8000/v1"
                                             Width="260"
                                             Height="36"
                                             CornerRadius="{StaticResource RuControlCornerRadius}" />
                                </Grid>
                            </StackPanel>

                            <!-- Custom API Key Row -->
                            <StackPanel x:Name="CustomApiKeyRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomApiKeyLabel" Text="Custom API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="CustomApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=CustomApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource RuControlCornerRadius}" />
                                        <Button x:Name="CustomSignOutButton"
                                                Content="Đăng xuất"
                                                Tag="custom"
                                                Click="OnRemoveProviderClick"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderCustom"
                                                CornerRadius="{StaticResource RuControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
