<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Controls.SessionUsagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="Session usage">

    <!--
      What one session's runs were billed for. The context meter answers "how full is
      the window right now" from a single step; this answers "what has this session
      cost", which the meter cannot know. Everything here is measured against the
      session's own largest step: the panel has no idea which model each run used, and
      a share of a limit it guessed would be a number nobody could act on.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,22,80,16" Spacing="4">
            <TextBlock Text="SESSION USAGE"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource RuMutedBrush}" />
            <TextBlock x:Name="SessionTitleText"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource RuInkBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <TextBlock x:Name="CoverageText"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="12"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />

        <ScrollViewer Grid.Row="2"
                      Padding="24,20,24,20"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Spacing="24">
                <!-- Two headline figures. Each is a nested enclosure: the shell is the
                     well, the core is the card that holds the number. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Background="{StaticResource RuCanvasBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="4">
                        <StackPanel Background="{StaticResource RuSurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Spacing="2">
                            <TextBlock Text="Billed"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <TextBlock x:Name="BilledValueText"
                                       Text="0"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}" />
                            <TextBlock Text="Input plus output, over every step that reported"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource RuCanvasBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="4">
                        <StackPanel Background="{StaticResource RuSurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Spacing="2">
                            <TextBlock Text="Peak context"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <TextBlock x:Name="PeakValueText"
                                       Text="0"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}" />
                            <TextBlock x:Name="PeakCaptionText"
                                       Text="Largest single step"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Where the measured tokens went. The legend names every part, so the
                     bar is never the only channel carrying the split. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Split of measured tokens"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RuMutedBrush}" />
                    <Border Height="8"
                            CornerRadius="{StaticResource AppPillCornerRadius}"
                            Background="{StaticResource RuCanvasBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1">
                        <Grid x:Name="ShareBarGrid" ColumnSpacing="2" />
                    </Border>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="{StaticResource AppPillCornerRadius}"
                                    Background="{StaticResource RuAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Input"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="InputValueText"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="{StaticResource AppPillCornerRadius}"
                                    Background="{StaticResource RuVioletBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Output"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="OutputValueText"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="CacheLegendRow" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="{StaticResource AppPillCornerRadius}"
                                    Background="{StaticResource RuInfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Cache"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CacheValueText"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="RunsHeaderText"
                               Text="Runs"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RuMutedBrush}" />
                    <StackPanel x:Name="RowsPanel" Spacing="2" />
                    <TextBlock x:Name="EmptyText"
                               Text="No provider report yet."
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <TextBlock x:Name="FooterText"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="11"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
