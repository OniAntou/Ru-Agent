<UserControl
    x:Class="RuApp.Views.VoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="ResponsiveRoot" Padding="36,28,36,36" Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ResponsiveRoot.Padding" Value="24,20,24,28"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ResponsiveRoot.Padding" Value="12,16,12,24"/>
                        <Setter Target="ActionButtonsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="VtsActionButtonsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="TestTextBox.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TestVoiceButton.(Grid.Row)" Value="1"/>
                        <Setter Target="TestVoiceButton.(Grid.Column)" Value="0"/>
                        <Setter Target="TestVoiceButton.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TestTextBox.Margin" Value="0,0,0,8"/>
                        <Setter Target="TestVoiceButton.HorizontalAlignment" Value="Stretch"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Page Title -->
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Cài đặt Giọng nói &amp; VTS" FontSize="22" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                <TextBlock Text="Tùy chỉnh giọng đọc OmniVoice, phụ đề tự động và tích hợp mô hình ảo VTube Studio" FontSize="13.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <!-- OmniVoice Configuration Card Group -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Cấu hình OmniVoice TTS" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                    <!-- Voice Profile Picker -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Hồ sơ giọng đọc (Voice Profile)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="Chọn chất giọng chuẩn hóa tiếng Việt của Ru hoặc Ái Vy" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="VoiceProfileComboBox" Grid.Column="1" Width="260" SelectionChanged="OnVoiceProfileChanged">
                            <ComboBoxItem Content="Ru (OmniVoice)" Tag="Ru (OmniVoice)"/>
                            <ComboBoxItem Content="Ái Vy (OmniVoice)" Tag="Ái Vy (OmniVoice)"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                    <!-- Speed Slider -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Tốc độ nói cơ bản (Base Speed)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="Điều chỉnh nhịp điệu phát âm từ 0.75x đến 1.20x" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="SpeedSlider" Minimum="0.75" Maximum="1.20" StepFrequency="0.05" Value="1.0" Width="180" ValueChanged="OnSpeedSliderChanged"/>
                            <Border Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource AppAccentBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="8,3" MinWidth="52">
                                <TextBlock x:Name="SpeedText" Text="1.00x" FontSize="12.5" FontWeight="Bold" 
                                           Foreground="{StaticResource AppAccentHoverBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                    <!-- Auto Pace Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Tự động điều chỉnh nhịp nói (Auto-pace ±0.08x)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="Tăng hoặc giảm nhẹ tốc độ nói theo cảm xúc của ngữ cảnh" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoPaceToggle" Grid.Column="1" IsOn="False" Toggled="OnAutoPaceToggled"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                    <!-- Auto Read Aloud Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Tự động đọc nội dung câu trả lời (Read replies aloud)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="Phát âm thanh streaming theo từng câu ngay khi Ru sinh tin nhắn" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoReadToggle" Grid.Column="1" IsOn="True" Toggled="OnAutoReadToggled"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                    <!-- Subtitles Overlay Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Hiện phụ đề Subtitle trên mô hình VTube Studio" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="Hiển thị phụ đề chữ nổi trong suốt tự bám theo chuyển động mô hình Live2D" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="SubtitleToggle" Grid.Column="1" IsOn="False" Toggled="OnSubtitleToggled"/>
                    </Grid>

                    <!-- Subtitle Customization Panel -->
                    <StackPanel x:Name="SubtitleCustomizationPanel" Spacing="14" Margin="0,4,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                        <!-- Font Size Selector -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Cỡ chữ phụ đề" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="Điều chỉnh độ lớn của dòng phụ đề trên màn hình" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="SubtitleSizeCombo" Grid.Column="1" Width="150" SelectionChanged="OnSubtitleSizeChanged">
                                <ComboBoxItem Content="Nhỏ (Small)" Tag="small"/>
                                <ComboBoxItem Content="Vừa (Medium)" Tag="medium" IsSelected="True"/>
                                <ComboBoxItem Content="Lớn (Large)" Tag="large"/>
                                <ComboBoxItem Content="Rất lớn (XLarge)" Tag="xlarge"/>
                            </ComboBox>
                        </Grid>

                        <!-- Color Selector -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Màu sắc chữ phụ đề" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="Màu chữ nổi bật kết hợp viền tương phản cao" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="SubtitleColorCombo" Grid.Column="1" Width="150" SelectionChanged="OnSubtitleColorChanged">
                                <ComboBoxItem Content="Trắng tinh khiết" Tag="#FFFFFF" IsSelected="True"/>
                                <ComboBoxItem Content="Vàng Pastel" Tag="#FFE082"/>
                                <ComboBoxItem Content="Hồng Sakura" Tag="#FF80AB"/>
                                <ComboBoxItem Content="Xanh Sky Blue" Tag="#80D8FF"/>
                                <ComboBoxItem Content="Xanh Bạc Hà" Tag="#B9F6CA"/>
                            </ComboBox>
                        </Grid>

                        <!-- Hold Duration Slider -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Thời gian giữ phụ đề" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock x:Name="SubtitleDurationLabel" Text="Thời gian hiển thị sau khi đọc xong: 2.0s" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                            <Slider x:Name="SubtitleDurationSlider" Grid.Column="1" Width="150" Minimum="1.0" Maximum="5.0" StepFrequency="0.5" Value="2.0" ValueChanged="OnSubtitleDurationChanged"/>
                        </Grid>

                        <!-- Subtitle Position Mode & Drag-Drop Controls -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Vị trí hiển thị phụ đề" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock x:Name="SubtitlePositionStatusLabel" Text="Trạng thái: Tự động bám theo Avatar Live2D" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SubtitleDragButton" Click="OnSubtitleDragButtonClicked" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="SubtitleDragIcon" Glyph="&#xE7C2;" FontSize="13"/>
                                        <TextBlock x:Name="SubtitleDragButtonText" Text="Kéo thả vị trí"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SubtitleResetPosButton" Click="OnSubtitleResetPosClicked" ToolTipService.ToolTip="Đặt lại vị trí tự động bám theo Live2D">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="Mặc định"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- GPU Lifecycle Controls Card -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Quản lý vòng đời GPU Voice" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Khởi động trước trọng số mô hình OmniVoice vào VRAM để giảm độ trễ câu đầu tiên, hoặc giải phóng GPU khi cần dùng ứng dụng khác." 
                               FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}"/>

                    <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                        <Button x:Name="WarmupButton" Click="OnWarmupClick" Padding="18,10" 
                                CornerRadius="{StaticResource AppControlCornerRadius}" 
                                Background="{StaticResource AppAccentBrush}" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="Khởi động Voice GPU" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReleaseButton" Click="OnReleaseClick" Padding="18,10" 
                                CornerRadius="{StaticResource AppControlCornerRadius}" 
                                Background="{StaticResource AppDangerSubtleBrush}" BorderBrush="{StaticResource AppDangerBrush}" 
                                BorderThickness="1" Foreground="{StaticResource AppDangerBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                <TextBlock Text="Giải phóng GPU VRAM" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Voice Sample Tester Card -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                            <StackPanel x:Name="VtsActionButtonsPanel" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Phát thử âm thanh mẫu" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="TestVoiceRow" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBox x:Name="TestTextBox" Grid.Column="0" Text="Xin chào, em là Ru! Hôm nay bạn thế nào rồi?" 
                                 Margin="0,0,16,0" VerticalAlignment="Center" Padding="12,10"
                                 CornerRadius="{StaticResource AppControlCornerRadius}"/>
                        <Button x:Name="TestVoiceButton" Grid.Column="1" Click="OnTestVoiceClick" Padding="20,10" 
                                CornerRadius="{StaticResource AppControlCornerRadius}" 
                                Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource AppAccentBrush}" 
                                BorderThickness="1" Foreground="{StaticResource AppAccentHoverBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE767;" FontSize="14"/>
                                <TextBlock Text="Phát thử" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
