<Window
    x:Class="RuApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RuApp.Models">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot" Background="{StaticResource RuCanvasBrush}" PreviewKeyDown="OnShellPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent" Padding="24,0,24,0">
            <Grid x:Name="BrandLockup"
                  ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="9"
                  VerticalAlignment="Center">
                <TextBlock x:Name="BrandName"
                           Text="Ru"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RuInkBrush}"
                           VerticalAlignment="Center" />
                <Rectangle x:Name="BrandRule"
                           Grid.Column="1"
                           Width="16"
                           Height="1"
                           Fill="{StaticResource RuAccentBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.82" />
                <TextBlock x:Name="BrandDescriptor"
                           Grid.Column="2"
                           Text="conversational runtime"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="11"
                           Foreground="{StaticResource RuMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <Grid x:Name="RootLayoutGrid" Grid.Row="1" SizeChanged="RootLayoutGrid_SizeChanged">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1280"/>
                        </VisualState.StateTriggers>
                    </VisualState>

                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="NavNewChat.Padding" Value="10,8"/>
                            <Setter Target="NavChat.Padding" Value="10,7"/>
                            <Setter Target="NavVoice.Padding" Value="10,7"/>
                            <Setter Target="NavSettings.Padding" Value="10,7"/>
                            <Setter Target="ThemeToggleButton.Padding" Value="10,7"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LabelNewChat.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelChat.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelVoice.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelThemeToggle.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelSettings.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelRecents.Visibility" Value="Collapsed"/>
                            <Setter Target="NavNewChat.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavChat.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavVoice.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="ThemeToggleButton.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavSettings.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavNewChat.Padding" Value="8"/>
                            <Setter Target="NavChat.Padding" Value="8"/>
                            <Setter Target="NavVoice.Padding" Value="8"/>
                            <Setter Target="ThemeToggleButton.Padding" Value="8"/>
                            <Setter Target="NavSettings.Padding" Value="8"/>
                            <Setter Target="SidebarResizer.Visibility" Value="Collapsed"/>
                            <Setter Target="StatusText.Visibility" Value="Collapsed"/>
                            <Setter Target="StatusServiceDetails.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="180" MaxWidth="400"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource RuSidebarBrush}" BorderThickness="0" CornerRadius="0,6,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Navigation Items -->
                        <StackPanel x:Name="SidebarTopPanel" Grid.Row="0" Padding="14,16,14,0" Spacing="2">
                            <!-- New Chat Button -->
                            <Button x:Name="NavNewChat" Click="OnNewChatClick" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Background="{StaticResource RuAccentSoftBrush}" BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1" Foreground="{StaticResource RuAccentBrush}" Padding="10,8"
                                    CornerRadius="{StaticResource RuControlCornerRadius}" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="NewSessionButton"
                                    ToolTipService.ToolTip="Đoạn chat mới" AutomationProperties.Name="Đoạn chat mới">
                                <StackPanel x:Name="ContentNewChat" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconNewChat" Glyph="&#xE710;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelNewChat" Text="Đoạn chat mới" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Navigation Tabs -->
                            <Button x:Name="NavChat" Tag="chat" Click="OnNavClick" HorizontalAlignment="Stretch"
                                    Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                    Padding="10,8" CornerRadius="{StaticResource RuControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                    ToolTipService.ToolTip="Trò chuyện" AutomationProperties.Name="Trò chuyện">
                                <StackPanel x:Name="ContentChat" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconChat" Glyph="&#xE8F2;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelChat" Text="Trò chuyện" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavVoice" Tag="voice" Click="OnNavClick" HorizontalAlignment="Stretch"
                                    Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                    Padding="10,8" CornerRadius="{StaticResource RuControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                    ToolTipService.ToolTip="Giọng nói &amp; VTS" AutomationProperties.Name="Giọng nói và VTS">
                                <StackPanel x:Name="ContentVoice" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconVoice" Glyph="&#xE720;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelVoice" Text="Giọng nói &amp; VTS" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Recent Chats Header -->
                        <Grid Grid.Row="1" Margin="14,20,14,6" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="LabelRecents" Grid.Column="0" Text="GẦN ĐÂY" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Sessions List -->
                        <ListView x:Name="SidebarSessionList" Grid.Row="2" SelectionMode="Single"
                                  AutomationProperties.AutomationId="SessionList"
                                  SelectionChanged="OnSessionSelectionChanged" Margin="8,0" Padding="0,0,0,16"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="34" />
                                    <Setter Property="Padding" Value="10,4" />
                                    <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionInfo">
                                    <Grid PointerEntered="SessionItem_PointerEntered" PointerExited="SessionItem_PointerExited" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13" Foreground="{StaticResource RuInkBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" 
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="2" 
                                                Width="24" Height="24" CornerRadius="{StaticResource RuControlCornerRadius}" Click="OnDeleteSessionClick"
                                                Tag="{x:Bind Id}" ToolTipService.ToolTip="Xóa đoạn chat" Opacity="0">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppDangerBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Status and settings -->
                    <StackPanel x:Name="SidebarBottomPanel" Grid.Row="1" Padding="14,8,14,14" Spacing="4">
                        <StackPanel x:Name="ShellStatusRow"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Padding="10,8,10,12"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Đang kiểm tra trạng thái dịch vụ">
                            <Ellipse x:Name="StatusDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource RuSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText"
                                       AutomationProperties.AutomationId="BackendStatus"
                                       Text="Hệ thống đã sẵn sàng"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <StackPanel x:Name="StatusServiceDetails" Visibility="Collapsed">
                                <TextBlock x:Name="TextBackend" Text=".NET Backend" />
                                <TextBlock x:Name="TextWorker" Text="AI Worker" />
                                <TextBlock x:Name="TextVts" Text="VTS Live2D" />
                                <Ellipse x:Name="DotBackend" />
                                <Ellipse x:Name="DotWorker" />
                                <Ellipse x:Name="DotVts" />
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="SidebarBottomDivider" Height="1" Background="{StaticResource RuLineBrush}" Margin="0,0,0,8"/>

                        <Button x:Name="ThemeToggleButton"
                                Click="OnThemeToggleClick"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                Foreground="{StaticResource RuMutedBrush}"
                                Padding="10,8"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                ToolTipService.ToolTip="Chuyển sang tối"
                                AutomationProperties.Name="Chuyển sang tối">
                            <StackPanel x:Name="ContentThemeToggle" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon x:Name="ThemeToggleIcon"
                                          Glyph="&#xE706;"
                                          FontSize="15"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelThemeToggle"
                                           Text="Chuyển sang tối"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettings" Tag="settings" Click="OnNavClick" HorizontalAlignment="Stretch"
                                Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                Padding="10,8" CornerRadius="{StaticResource RuControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                ToolTipService.ToolTip="Cài đặt hệ thống" AutomationProperties.Name="Cài đặt hệ thống">
                            <StackPanel x:Name="ContentSettings" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon x:Name="IconSettings" Glyph="&#xE713;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelSettings" Text="Cài đặt hệ thống" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar Divider / Resizer (9px hit-target with 1px active indicator line) -->
            <Grid x:Name="SidebarResizer" Grid.Column="1" Width="9" Margin="-4,0,-4,0" Canvas.ZIndex="10"
                  Background="Transparent"
                  PointerEntered="Resizer_PointerEntered"
                  PointerExited="Resizer_PointerExited"
                  PointerPressed="Resizer_PointerPressed"
                  PointerMoved="Resizer_PointerMoved"
                  PointerReleased="Resizer_PointerReleased"
                  DoubleTapped="Resizer_DoubleTapped"
                  ToolTipService.ToolTip="Kéo để chỉnh độ rộng / Nhấp đúp để thu gọn hoặc mở rộng">
                <Border x:Name="SidebarResizerLine" Width="1" HorizontalAlignment="Center"
                        Background="{StaticResource RuLineBrush}" Opacity="0.4"/>
            </Grid>

            <!-- Content Frame with Smooth Native Transition -->
            <ContentControl x:Name="ContentFrame" Grid.Column="2" Margin="0" 
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
            </ContentControl>
        </Grid>

    </Grid>
</Window>
