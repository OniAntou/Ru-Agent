<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Controls.SessionUsagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="Session usage">

    <!--
      What one session's runs cost. The context meter answers "how full is the window
      right now" from a single step; this answers "what has this session cost", which
      the meter cannot know, so the panel shows both on one line and the two figures
      stop looking like a disagreement: a session re-sends its whole context on every
      step, so the total is many windows, not one.

      Minimal on purpose: cost and token total, one bar for where the tokens went, the
      current context when this session is open, and the runs folded behind a header.
      Every bar is square; the legend swatches are the same shape as the bar they name.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,20,60,14" Spacing="2">
            <TextBlock x:Name="SessionTitleText"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource RuInkBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <!-- How many runs, and how long they took: facts about the data. -->
            <TextBlock x:Name="CoverageText"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="12"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />

        <ScrollViewer Grid.Row="2"
                      Padding="24,18,24,18"
                      MaxHeight="440"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel x:Name="BodyPanel" Spacing="16">
                <StackPanel x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ProgressRing x:Name="UsageLoadingRing"
                                  Width="16" Height="16"
                                  IsActive="True" />
                    <TextBlock Text="Đang đọc usage…"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource RuMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- The answer first: what it cost, then how many tokens that was. -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="CostValueText"
                                   Text="—"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuInkBrush}"
                                   VerticalAlignment="Bottom" />
                        <TextBlock x:Name="BilledValueText"
                                   Text="—"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="13"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,4" />
                    </StackPanel>
                    <TextBlock x:Name="CostCoverageText"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="10.5"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Where the tokens went: one bar, one legend. Each segment is sized by
                     its measured share; a part nobody measured draws nothing. -->
                <StackPanel Spacing="8">
                    <Grid x:Name="ShareBarGrid" Height="6" ColumnDefinitions="*,*,*,*"
                          Background="{StaticResource RuCanvasBrush}">
                        <Border x:Name="InputShareBar" Grid.Column="0" Background="{StaticResource RuAccentBrush}" />
                        <Border x:Name="OutputShareBar" Grid.Column="1" Background="{StaticResource RuVioletBrush}" />
                        <Border x:Name="CacheReadShareBar" Grid.Column="2" Background="{StaticResource RuInfoBrush}" />
                        <Border x:Name="CacheWriteShareBar" Grid.Column="3" Background="{StaticResource RuPinkBrush}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel x:Name="InputLegendItem" Orientation="Horizontal" Spacing="5">
                            <Border Width="7" Height="7" Background="{StaticResource RuAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="InputValueText" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="OutputLegendItem" Orientation="Horizontal" Spacing="5">
                            <Border Width="7" Height="7" Background="{StaticResource RuVioletBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="OutputValueText" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="CacheReadLegendItem" Orientation="Horizontal" Spacing="5">
                            <Border Width="7" Height="7" Background="{StaticResource RuInfoBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CacheReadValueText" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="CacheWriteLegendItem" Orientation="Horizontal" Spacing="5">
                            <Border Width="7" Height="7" Background="{StaticResource RuPinkBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CacheWriteValueText" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- The window right now, beside the session total: the two answer different
                     questions. Shown only for the session that is open in the chat. -->
                <Grid x:Name="ContextNowRow" ColumnDefinitions="*,Auto" Visibility="Collapsed">
                    <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" VerticalAlignment="Top" Margin="0,-8,0,0" Grid.ColumnSpan="2" />
                    <TextBlock Text="Context now" Margin="0,8,0,0"
                               FontFamily="{StaticResource RuUiFontFamily}" FontSize="12.5"
                               Foreground="{StaticResource RuMutedBrush}" />
                    <TextBlock x:Name="ContextNowValueText" Grid.Column="1" Margin="0,8,0,0"
                               FontFamily="{StaticResource RuMonoFontFamily}" FontSize="12.5"
                               Foreground="{StaticResource RuInkBrush}" />
                </Grid>

                <!-- The runs, folded. The header is the toggle; the rows open beneath it. -->
                <StackPanel Spacing="0">
                    <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" Margin="0,0,0,2" />
                    <Button x:Name="RunsToggleButton"
                            Click="OnRunsToggleClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Show runs">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock x:Name="RunsHeaderText"
                                       Grid.Column="0"
                                       Text="Runs"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <TextBlock x:Name="RunsScaleText"
                                       Grid.Column="1"
                                       Text="newest first · bar against the largest"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <FontIcon x:Name="RunsChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="11"
                                      Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="RowsPanel" Visibility="Collapsed" />
                    <TextBlock x:Name="EmptyText"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,2"
                               Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <TextBlock x:Name="FooterText"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="10.5"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
