<UserControl
    x:Class="RuApp.Controls.AgentActivitySummaryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" Visibility="Collapsed">
    <Button x:Name="SummaryButton" Click="OnExpandClick"
            AutomationProperties.AutomationId="CompactAgentActivitySummary"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Background="Transparent" BorderThickness="0" Padding="8,5" MinHeight="32"
            CornerRadius="{StaticResource AppControlCornerRadius}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock x:Name="SummaryText" FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="{x:Bind Typography.ActivityFontSize, Mode=OneWay}"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <FontIcon x:Name="ExpandIcon" Grid.Column="1" Glyph="&#xE70D;"
                      FontSize="10" Foreground="{StaticResource RuMutedBrush}"
                      VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </Button>
</UserControl>
