<Window
    x:Class="RuApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:services="using:RuApp.Services"
    xmlns:views="using:RuApp.Views"
    xmlns:viewmodels="using:RuApp.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot" Background="{StaticResource RuCanvasBrush}" PreviewKeyDown="OnShellPreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="SidebarNewChatButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource RuNewChatStartColor}" Offset="0" />
                            <GradientStop Color="{ThemeResource RuNewChatMiddleColor}" Offset="0.5" />
                            <GradientStop Color="{ThemeResource RuNewChatEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value><SolidColorBrush Color="{ThemeResource RuNewChatBorderColor}" /></Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverLayer.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Border x:Name="HoverLayer" Background="{StaticResource RuAccentSoftBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar (Clean draggable titlebar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.Resources>
                <Style x:Key="TitleBarIconButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="Root" Background="{TemplateBinding Background}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Root.Background" Value="{StaticResource RuAccentSoftBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Root.Background" Value="{StaticResource RuLineBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="Root.Opacity" Value="0.4" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Keep interactive actions immediately left of the system captions. -->
            <StackPanel x:Name="TitleBarActions" Orientation="Horizontal" Spacing="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="TitleBarUpdateButton" Content="Update"
                        Height="24" MinHeight="0" MinWidth="0" Padding="10,0"
                        VerticalAlignment="Center" CornerRadius="{StaticResource AppMicroPillCornerRadius}" BorderThickness="0"
                        FontFamily="{StaticResource RuUiFontFamily}" FontSize="12"
                        Background="{StaticResource RuAccentSoftBrush}"
                        Foreground="{StaticResource RuAccentBrush}"
                        IsEnabled="{x:Bind Shell.IsSettingsReady, Mode=OneWay}"
                        Visibility="{x:Bind Shell.IsUpdateAvailable, Mode=OneWay}" Click="OnTitleBarUpdateClick"
                        ToolTipService.ToolTip="Check for updates"
                        AutomationProperties.Name="Check for updates" />
                <Button x:Name="NavigationSidebarToggleButton"
                        Click="OnNavigationSidebarToggleClick"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Hide workspace sidebar"
                        AutomationProperties.Name="Hide workspace sidebar">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M4.5,3.5 H11.5 A2,2 0 0 1 13.5,5.5 V10.5 A2,2 0 0 1 11.5,12.5 H4.5 A2,2 0 0 1 2.5,10.5 V5.5 A2,2 0 0 1 4.5,3.5 Z M5.5,3.5 V12.5"
                              Stroke="{StaticResource RuInkBrush}" StrokeThickness="1.2" />
                    </Viewbox>
                </Button>
                <Button x:Name="SidePanelToggleButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsEnabled="{x:Bind Shell.CanToggleSidePanel, Mode=OneWay}"
                        Click="OnSidePanelToggleClick"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Shell.SidePanelToggleLabel, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Shell.SidePanelToggleLabel, Mode=OneWay}">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M4.5,3.5 H11.5 A2,2 0 0 1 13.5,5.5 V10.5 A2,2 0 0 1 11.5,12.5 H4.5 A2,2 0 0 1 2.5,10.5 V5.5 A2,2 0 0 1 4.5,3.5 Z M10.5,3.5 V12.5"
                              Stroke="{StaticResource RuInkBrush}"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <ContentControl x:Name="ShellInteractionHost" Grid.Row="1" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="RootLayoutGrid" SizeChanged="RootLayoutGrid_SizeChanged">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1280"/>
                        </VisualState.StateTriggers>
                    </VisualState>

                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="NavNewChat.Padding" Value="10,8"/>
                            <Setter Target="NavChat.Padding" Value="10,7"/>
                            <Setter Target="NavSettings.Padding" Value="10,7"/>
                            <Setter Target="ThemeToggleButton.Padding" Value="10,7"/>
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="220" MaxWidth="360"/>
                <ColumnDefinition x:Name="SidebarDividerColumn" Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar. Asymmetric on purpose: the left edge is the
                 window edge, so only the two corners that meet the content get
                 the control radius. -->
            <Border x:Name="NavigationSidebar" Grid.Column="0" Background="{StaticResource RuSidebarBrush}" BorderThickness="0" CornerRadius="0,6,6,0">
                <Border.Resources>
        <DataTemplate x:Key="WorkspaceSessionTemplate" x:DataType="models:SessionInfo">
            <Grid Margin="{x:Bind ItemMargin, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}"
                  PointerEntered="SessionItem_PointerEntered" PointerExited="SessionItem_PointerExited"
                  GotFocus="SessionItem_GotFocus" LostFocus="SessionItem_LostFocus" Background="Transparent" Padding="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Title, Mode=OneWay}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13" Foreground="{StaticResource RuInkBrush}"
                           Loaded="OnSessionTitleLoaded" Unloaded="OnSessionTitleUnloaded" DataContextChanged="OnSessionTitleDataContextChanged"
                           AutomationProperties.ItemStatus="{x:Bind AgentStatusText, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <!-- The clock owns the right edge. The row's … control shares the
                     same cell and stays hidden until the row is hovered, at which
                     point the clock steps aside for it: everything is right-aligned
                     in one place, so the row never reflows, and the clock never
                     paints underneath a glyph. The control is hidden by opacity
                     rather than by collapsing it so its width still reserves the
                     cell's edge. -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTimeText" HorizontalAlignment="Right"
                               Text="{x:Bind DisplayTimeText, Mode=OneWay}"
                               FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" Foreground="{StaticResource RuMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The row's only hover control. Clicking it opens the
                             row menu (export/import/usage/delete), so there is
                             no right-click path anymore. It stays focusable so
                             keyboard users reach the same menu without a pointer. -->
                        <Button x:Name="SessionMoreButton" HorizontalAlignment="Right"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Width="22" Height="22" CornerRadius="{StaticResource AppControlCornerRadius}"
                                 Tag="{x:Bind Id, Mode=OneTime}" Opacity="0" IsHitTestVisible="False" IsTabStop="True"
                                 ToolTipService.ToolTip="More actions"
                                 AutomationProperties.Name="More actions">
                            <TextBlock Text="…" FontFamily="{StaticResource RuUiFontFamily}" FontSize="14"
                                       Foreground="{StaticResource RuInkBrush}" Margin="0,-6,0,0" />
                            <Button.Flyout>
                                <MenuFlyout Opening="OnSessionMenuOpening" Closed="OnSessionMenuClosed">
                                    <MenuFlyoutSubItem Text="Move to" Tag="{x:Bind Id}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="ExportClaudeCodeItem"
                                                    Text="Export as Claude Code"
                                                    Click="OnExportSessionMenuClick"
                                                    Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <!-- Handing the session to another agent's own directory. -->
                                            <FontIcon Glyph="&#xE74E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="ExportCodexItem"
                                                    Text="Export as Codex"
                                                    Click="OnExportSessionMenuClick"
                                                    Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="ImportSessionItem"
                                                    Text="Import session from another agent…"
                                                    Click="OnImportSessionMenuClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8E5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="SessionUsageItem"
                                                    Text="Session usage"
                                                    Click="OnSessionUsageClick"
                                                    Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE712;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="SessionDeleteButton" HorizontalAlignment="Right"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Width="22" Height="22" CornerRadius="{StaticResource AppControlCornerRadius}" Click="OnDeleteSessionClick"
                                 Tag="{x:Bind Id}" Opacity="0" IsHitTestVisible="False" IsTabStop="True"
                                 ToolTipService.ToolTip="Delete session"
                                 AutomationProperties.Name="Delete session">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource RuInkBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <Style x:Key="WorkspaceAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent"/>
                                            <Setter Target="Glyph.Foreground" Value="{StaticResource RuAccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent"/>
                                            <Setter Target="Glyph.Foreground" Value="{StaticResource RuAccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent"/>
                                            <Setter Target="Glyph.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon x:Name="Glyph" Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Row buttons inside the session list paint nothing themselves:
             the ListViewItem container owns the single rounded hover fill.
             A default Button template would add its own square PointerOver
             fill on top of it, which reads as a double border. -->
        <Style x:Key="WorkspaceRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WorkspaceGroupTemplate" x:DataType="services:WorkspaceGroupRow">
            <Button x:Name="WorkspaceGroupToggle" Click="OnWorkspaceGroupClick" Tag="{x:Bind Group.Key}" CommandParameter="{x:Bind IsExpanded, Mode=OneTime}" PointerEntered="WorkspaceGroupToggle_PointerEntered" PointerExited="WorkspaceGroupToggle_PointerExited"
                    Style="{StaticResource WorkspaceRowButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Group.Path}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Remove workspace" Click="OnWorkspaceRemoveClick" Tag="{x:Bind Group.Key}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AppDangerBrush}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource RuAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Group.Label}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="WorkspaceGroupAddButton" Grid.Column="2" Click="OnWorkspaceGroupAddClick" Tag="{x:Bind Group.Key}" Opacity="0.55" IsTabStop="True" Style="{StaticResource WorkspaceAddButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="New chat here" AutomationProperties.Name="New chat here"/>
                    <FontIcon x:Name="WorkspaceGroupChevron" Grid.Column="3" Opacity="0.55" Glyph="{x:Bind ChevronGlyph}" FontSize="10" Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceShowMoreTemplate" x:DataType="services:WorkspaceShowMoreRow">
            <Button Click="OnWorkspaceShowMoreClick" Tag="{x:Bind GroupKey}" Style="{StaticResource WorkspaceRowButtonStyle}" Padding="10,4"
                    HorizontalContentAlignment="Left">
                <TextBlock Text="{x:Bind DisplayText}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuAccentBrush}"/>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SidebarRecentsTemplate" x:DataType="services:SidebarSectionRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="6,0">
                <Button Click="OnSidebarSectionToggleClick" Tag="{x:Bind Key}" Padding="0" Style="{StaticResource WorkspaceRowButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Toggle Recents">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="12" Width="14" Height="14" Foreground="{StaticResource RuMutedBrush}"
                                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Name="RecentsHeader" Text="RECENTS" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="{x:Bind ChevronGlyph}" FontSize="10" Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Click="OnWorkspaceGroupAddClick" Tag="{x:Bind Key}" Width="28" Height="28" Style="{StaticResource WorkspaceAddButtonStyle}" AutomationProperties.Name="New recent session" ToolTipService.ToolTip="New session"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SidebarCliTemplate" x:DataType="services:SidebarSectionRow">
            <Grid Margin="6,0">
                <Button Click="OnSidebarSectionToggleClick" Tag="{x:Bind Key}" Padding="0" Style="{StaticResource WorkspaceRowButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Toggle CLI Session">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Data="M2,3.5 L6,7 L2,10.5 M8,10.5 H12"
                                  Stroke="{StaticResource RuMutedBrush}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="{x:Bind ChevronGlyph}" FontSize="10" Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SidebarWorkspacesTemplate" x:DataType="services:SidebarSectionRow">
            <Grid Margin="6,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Path Width="14" Height="14"
                                          Data="M2,2 H6 V6 H2 Z M8,2 H12 V6 H8 Z M2,8 H6 V12 H2 Z M8,8 H12 V12 H8 Z"
                                          Stroke="{StaticResource RuMutedBrush}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="WorkspaceHeader" Text="WORKSPACES" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="WorkspaceNewButton" Grid.Column="1" Click="OnWorkspaceAddClick" Background="Transparent" BorderThickness="0" Padding="6,4"
                                        ToolTipService.ToolTip="Add workspace" AutomationProperties.Name="Add workspace">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource RuMutedBrush}"/>
                                </Button>
                            </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SidebarEmptyTemplate" x:DataType="services:SidebarEmptyRow">
            <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuMutedBrush}" Margin="10,4"/>
        </DataTemplate>
        <Style x:Key="SidebarSessionContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="SessionChrome" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SessionChrome.Background" Value="{StaticResource RuSurfaceBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SessionChrome.Background" Value="{StaticResource RuLineBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SessionChrome.Background" Value="{StaticResource RuAccentSoftBrush}" /><Setter Target="SessionChrome.BorderBrush" Value="{StaticResource RuLineBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="SessionChrome.Background" Value="{StaticResource RuLineBrush}" /><Setter Target="SessionChrome.BorderBrush" Value="{StaticResource RuMutedBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="SessionChrome.Background" Value="{StaticResource RuLineBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SessionChrome.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarHeadingContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AppControlCornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarRecentsContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource SidebarHeadingContainerStyle}">
            <Setter Property="Margin" Value="0,36,0,6"/>
        </Style>
        <Style x:Key="SidebarEmptyContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource SidebarHeadingContainerStyle}">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <views:SidebarRowContainerStyleSelector x:Key="SidebarContainerSelector"
                                              SessionStyle="{StaticResource SidebarSessionContainerStyle}"
                                              HeadingStyle="{StaticResource SidebarHeadingContainerStyle}"
                                              RecentsStyle="{StaticResource SidebarRecentsContainerStyle}"
                                              EmptyStyle="{StaticResource SidebarEmptyContainerStyle}"/>
        <views:SidebarRowTemplateSelector x:Key="SidebarRowSelector"
                                          CliTemplate="{StaticResource SidebarCliTemplate}"
                                          RecentsTemplate="{StaticResource SidebarRecentsTemplate}"
                                          WorkspacesTemplate="{StaticResource SidebarWorkspacesTemplate}"
                                          EmptyTemplate="{StaticResource SidebarEmptyTemplate}"
                                          GroupTemplate="{StaticResource WorkspaceGroupTemplate}"
                                          SessionTemplate="{StaticResource WorkspaceSessionTemplate}"
                                          ShowMoreTemplate="{StaticResource WorkspaceShowMoreTemplate}" />
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Navigation Items -->
                        <StackPanel x:Name="SidebarTopPanel" Grid.Row="0" Padding="14,16,14,0" Spacing="2">
                            <!-- New Chat Button -->
                            <Button x:Name="NavNewChat" Click="OnNewChatClick" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Padding="10,8"
                                    CornerRadius="{StaticResource AppControlCornerRadius}" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SidebarNewChatButtonStyle}"
                                    AutomationProperties.AutomationId="NewSessionButton"
                                    AutomationProperties.Name="New Chat">
                                <StackPanel x:Name="ContentNewChat" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconNewChat" Glyph="&#xE710;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelNewChat" Text="New Chat" Style="{StaticResource RuNavLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Navigation Tabs -->
                            <Button x:Name="NavChat" Tag="chat" Click="OnNavClick" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                    Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                    Padding="10,8" CornerRadius="{StaticResource AppControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Chat">
                                <StackPanel x:Name="ContentChat" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconChat" Glyph="&#xE8F2;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelChat" Text="Chat" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>


                        <!-- Workspaces Header -->
                        <Grid x:Name="WorkspaceHeaderPanel" Grid.Row="1" Margin="14,0,14,0">
                            <TextBlock x:Name="SidebarSessionTruncationWarning" Margin="2,4,0,0"
                                       Text="Session list is limited; some sessions are hidden."
                                       FontFamily="{StaticResource RuUiFontFamily}" FontSize="11"
                                       Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- Sessions List -->
                        <Grid x:Name="SidebarListOverlay" Grid.Row="2">
                        <ListView x:Name="SidebarSessionList" SelectionMode="Single"
                                  CanDragItems="True" AllowDrop="True" CanReorderItems="False"
                                  DragItemsStarting="OnSidebarDragItemsStarting" DragItemsCompleted="OnSidebarDragItemsCompleted"
                                  DragOver="OnSidebarDragOver" DragLeave="OnSidebarDragLeave" Drop="OnSidebarDrop"
                                  AutomationProperties.AutomationId="SessionList"
                                  SelectionChanged="OnSessionSelectionChanged" Margin="8,0" Padding="0,0,0,16"
                                  Background="Transparent" BorderThickness="0" ItemTemplateSelector="{StaticResource SidebarRowSelector}"
                                  ItemContainerStyleSelector="{StaticResource SidebarContainerSelector}">

                        </ListView>
                        <Border x:Name="SidebarDropIndicator" Height="2" VerticalAlignment="Top" Margin="8,0,8,0"
                                Background="{StaticResource RuAccentBrush}" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- Status and settings -->
                    <StackPanel x:Name="SidebarBottomPanel" Grid.Row="1" Padding="14,8,14,14" Spacing="4">
                        <StackPanel x:Name="ShellStatusRow" Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Padding="10,8,10,12"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{x:Bind StatusBrush(Shell.StatusTone), Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText"
                                       AutomationProperties.AutomationId="BackendStatus"
                                       Text="{x:Bind Shell.StatusText, Mode=OneWay}"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </StackPanel>

                        <Button x:Name="ThemeToggleButton"
                                Visibility="Collapsed"
                                Click="OnThemeToggleClick"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                Foreground="{StaticResource RuMutedBrush}"
                                Padding="10,8"
                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Switch to dark mode">
                            <StackPanel x:Name="ContentThemeToggle" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon x:Name="ThemeToggleIcon"
                                          Glyph="&#xE706;"
                                          FontSize="15"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelThemeToggle"
                                           Text="Switch to dark mode"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettings" Tag="settings" Click="OnNavClick" HorizontalAlignment="Stretch"
                                Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                Padding="10,8" CornerRadius="{StaticResource AppControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Settings">
                            <StackPanel x:Name="ContentSettings" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon x:Name="IconSettings" Glyph="&#xE713;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelSettings" Text="Settings" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Invisible sidebar resizer: keep the full hit-target and native resize cursor. -->
            <controls:SidebarResizerControl x:Name="SidebarResizer" Grid.Column="1" Width="10" Canvas.ZIndex="10"
                  Background="Transparent"
                  PointerPressed="Resizer_PointerPressed"
                  PointerMoved="Resizer_PointerMoved"
                  PointerReleased="Resizer_PointerReleased"
                  PointerCanceled="Resizer_PointerCanceled"
                  PointerCaptureLost="Resizer_PointerCaptureLost"
                  Unloaded="Resizer_Unloaded"
                  DoubleTapped="Resizer_DoubleTapped"
                  IsTabStop="True"
                  UseSystemFocusVisuals="True"
                  AutomationProperties.Name="Resize workspace sidebar">
                <Grid Background="Transparent" />
            </controls:SidebarResizerControl>

            <!-- Content Frame with Smooth Native Transition -->
            <ContentControl x:Name="ContentFrame" Grid.Column="2" Margin="0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
            </ContentControl>
        </Grid>

        </ContentControl>

        <!-- Settings Modal Overlay Popup -->
        <Grid x:Name="SettingsModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="500"
              TabFocusNavigation="Cycle"
              AutomationProperties.Name="Settings dialog"
              Visibility="Collapsed"
              SizeChanged="OnSettingsModalOverlaySizeChanged">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Dimmed Backdrop (Click outside card to close) -->
            <Border
                    Background="{StaticResource RuCanvasBrush}"
                    Opacity="0.75"
                    PointerPressed="OnSettingsBackdropPointerPressed" />

            <!-- Dialog Card Container (Fixed stable dimension avoids jitter/shifting) -->
            <Border x:Name="SettingsModalCard"
                    Width="880"
                    Height="560"
                    MaxWidth="1080"
                    MaxHeight="780"
                    Margin="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppModalCornerRadius}"
                    Translation="0,0,16"
                    Shadow="{StaticResource RuRaisedShadow}"
                    PointerPressed="OnSettingsCardPointerPressed">
                <Grid>
                    <!-- Modal Body (Hosts SettingsView with Sidebar + Content) -->
                    <ContentControl x:Name="SettingsModalContent"
                                    IsTabStop="False"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent" />

                    <!-- Top-Right Close Button -->
                    <Button x:Name="CloseSettingsButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            Canvas.ZIndex="10"
                            Click="OnCloseSettingsButtonClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Width="32"
                            Height="32"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            AutomationProperties.Name="Close settings"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Session usage modal (opened from a session row's menu) -->
        <Grid x:Name="SessionUsageOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="510"
              Visibility="Collapsed"
              SizeChanged="OnSessionUsageOverlaySizeChanged">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Dimmed Backdrop (Click outside card to close) -->
            <Border x:Name="SessionUsageBackdrop"
                    Background="{StaticResource RuCanvasBrush}"
                    Opacity="0.75"
                    PointerPressed="OnSessionUsageBackdropPointerPressed" />

            <!-- Dialog Card Container: the height follows the panel, the code only
                 caps it at the window's height. -->
            <Border x:Name="SessionUsageCard"
                    Width="560"
                    MinHeight="300"
                    MaxHeight="780"
                    Margin="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppModalCornerRadius}"
                    Translation="0,0,16"
                    Shadow="{StaticResource RuRaisedShadow}"
                    PointerPressed="OnSessionUsageCardPointerPressed">
                <Grid>
                    <controls:SessionUsagePanel x:Name="SessionUsagePanelControl"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />

                    <!-- Top-Right Close Button -->
                    <Button x:Name="CloseSessionUsageButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            Canvas.ZIndex="10"
                            Click="OnCloseSessionUsageClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Width="32"
                            Height="32"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            AutomationProperties.Name="Close session usage"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!--
          Command palette (Ctrl+K). It opens near the top so the list grows downward under
          the query, the way a launcher reads; the transcript stays visible, dimmed, behind it.
        -->
        <Grid x:Name="CommandPaletteOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="520"
              TabFocusNavigation="Cycle"
              SizeChanged="OnCommandPaletteOverlaySizeChanged"
              Visibility="Collapsed"
              AutomationProperties.Name="Command palette">
            <Border Background="{StaticResource RuCanvasBrush}"
                    Opacity="0.6"
                    PointerPressed="OnCommandPaletteBackdropPointerPressed" />
            <Border x:Name="CommandPaletteCard"
                    MaxWidth="620"
                    MaxHeight="480"
                    Margin="24,88,24,24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppCardCornerRadius}"
                    Translation="0,0,24"
                    Shadow="{StaticResource RuRaisedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="16,4,12,4">
                        <FontIcon Glyph="&#xE721;"
                                  FontSize="14"
                                  Foreground="{StaticResource RuMutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBox x:Name="CommandPaletteQuery"
                                 Grid.Column="1"
                                 Text="{x:Bind Palette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Type a command or a session name"
                                 FontFamily="{StaticResource RuUiFontFamily}"
                                 FontSize="15"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,10,4,10"
                                 PreviewKeyDown="OnCommandPaletteQueryKeyDown"
                                 AutomationProperties.Name="Search commands and sessions" />
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{StaticResource RuLineBrush}" />
                    <ListView x:Name="CommandPaletteList"
                              Grid.Row="2"
                              Padding="6"
                              ItemsSource="{x:Bind Palette.Results}"
                              SelectedIndex="{x:Bind Palette.SelectedIndex, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnCommandPaletteItemClick"
                              IsTabStop="False"
                              AutomationProperties.Name="Commands">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PaletteCommand">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,6">
                                    <FontIcon Glyph="{x:Bind Glyph}"
                                              FontSize="14"
                                              Foreground="{StaticResource RuMutedBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <TextBlock Text="{x:Bind Hint}"
                                                   Visibility="{x:Bind HasHint}"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource RuMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Visibility="{x:Bind HasShortcut}"
                                                Padding="6,2"
                                                BorderBrush="{StaticResource RuLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource AppMicroPillCornerRadius}">
                                            <TextBlock Text="{x:Bind Shortcut}"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource RuMutedBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Group}"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource RuMutedBrush}"
                                                   MinWidth="64"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2"
                               Visibility="{x:Bind Palette.HasNoResults, Mode=OneWay}"
                               Text="No command or session matches."
                               Margin="20,16"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="13"
                               Foreground="{StaticResource RuMutedBrush}" />
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,8">
                        <TextBlock Text="&#x2191; &#x2193; to move &#xB7; Enter to run &#xB7; Esc to close"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource RuMutedBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Native GUI wordmark and live startup state above the shell. -->
        <controls:WelcomeOverlay x:Name="WelcomeOverlay"
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Canvas.ZIndex="1000" />
    </Grid>
</Window>
