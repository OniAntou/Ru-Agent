<UserControl x:Class="RuApp.Views.SubagentTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RuApp.Controls" xmlns:services="using:RuApp.Services"
    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" KeyDown="OnBrowserKeyDown">
    <UserControl.Resources>
        <services:SubagentStateBrushConverter x:Key="StateBrush" />
        <Style x:Key="TaskItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <DataTemplate x:Key="TaskRowTemplate" x:DataType="services:SubagentRow">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" AutomationProperties.Name="{x:Bind AutomationLabel}">
                <controls:SubagentGlyph AgentId="{x:Bind AgentId}" Role="{x:Bind Role}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4" ToolTipService.ToolTip="{x:Bind AutomationLabel}">
                    <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{StaticResource RuMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Ellipse Grid.Column="2" Width="5" Height="5" Margin="4,0" VerticalAlignment="Center"
                         Fill="{x:Bind Tone, Converter={StaticResource StateBrush}}" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="Feedback" Margin="8,0,8,10" FontSize="12" Foreground="{StaticResource RuWarningBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ListBody" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="2,0,2,24" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
                        <TextBlock Text="Subagents" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="OnRefresh" Style="{StaticResource RuToolbarButtonStyle}"
                                AutomationProperties.Name="Refresh subagents" ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="SnapshotSummary" Margin="6,0,6,8" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource RuMutedBrush}" />
                    <StackPanel x:Name="EmptyState" Margin="8,28,8,0" Spacing="8">
                        <controls:SubagentGlyph AgentId="empty" HorizontalAlignment="Left" Opacity="0.65" />
                        <TextBlock x:Name="EmptyTitle" Text="No delegated work yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                        <TextBlock x:Name="EmptyDescription" Text="Coding and review tasks appear here when Ru delegates work."
                                   FontSize="12" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="TaskGroups" Visibility="Collapsed" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="WorkingHeading" Margin="8,4,0,4" Text="Working · 0" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                            <TextBlock x:Name="WorkingEmpty" Text="No subagents running." Margin="8,0,8,8" FontSize="12"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <ListView x:Name="WorkingList" ItemsSource="{x:Bind Working, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnTaskClick" ItemContainerStyle="{StaticResource TaskItemStyle}" ItemTemplate="{StaticResource TaskRowTemplate}"
                                      AutomationProperties.Name="Working subagents" />
                        </StackPanel>
                        <StackPanel x:Name="AttentionGroup" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="AttentionHeading" Margin="8,0,0,4" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RuWarningBrush}" />
                            <ListView x:Name="AttentionList" ItemsSource="{x:Bind Attention, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnTaskClick" ItemContainerStyle="{StaticResource TaskItemStyle}" ItemTemplate="{StaticResource TaskRowTemplate}"
                                      AutomationProperties.Name="Subagents needing attention" />
                        </StackPanel>
                        <StackPanel x:Name="FinishedGroup" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="FinishedHeading" Margin="8,0,0,4" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}" />
                            <ListView x:Name="FinishedList" ItemsSource="{x:Bind Finished, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnTaskClick" ItemContainerStyle="{StaticResource TaskItemStyle}" ItemTemplate="{StaticResource TaskRowTemplate}"
                                      AutomationProperties.Name="Finished subagents" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="PreparationStatus" Margin="8,8" FontSize="12" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="DetailBody" Visibility="Collapsed" RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto"
                      ColumnSpacing="8" RowSpacing="4" Margin="2,2,2,12">
                    <Button x:Name="BackButton" Grid.RowSpan="2" Click="OnBack"
                            Width="28" Height="32" VerticalAlignment="Top"
                            Style="{StaticResource RuToolbarButtonStyle}"
                            AutomationProperties.Name="Back to subagent list" ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <controls:SubagentGlyph x:Name="SelectedGlyph" Grid.Column="1" VerticalAlignment="Top" />
                    <TextBlock x:Name="SelectedTitle" Grid.Column="2" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource RuInkBrush}" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="SelectedModel" Grid.Column="2" Grid.Row="1" FontSize="11"
                               Foreground="{StaticResource RuMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="DetailActionsButton" Grid.Column="3" Grid.RowSpan="2" Width="28" Height="32"
                            VerticalAlignment="Top" Style="{StaticResource RuToolbarButtonStyle}"
                            AutomationProperties.Name="Subagent task details and export" ToolTipService.ToolTip="Task details and export">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="280" Spacing="12">
                                    <TextBlock Text="Task details" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource RuInkBrush}" />
                                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Task brief" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                                                <TextBlock x:Name="TaskBrief" FontSize="13" TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True" Foreground="{StaticResource RuInkBrush}" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Run details" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                                                <TextBlock x:Name="RunDetails" FontSize="12" TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True" Foreground="{StaticResource RuInkBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Height="1" Background="{StaticResource RuLineBrush}" />
                                    <Button x:Name="ExportButton" Click="OnExportResult" HorizontalAlignment="Left"
                                            Style="{StaticResource RuToolbarButtonStyle}" AutomationProperties.Name="Export subagent result">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                                            <TextBlock Text="Export result" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Margin="8,0,8,0" Padding="0,0,0,10"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuLineBrush}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="SelectedStatus" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource RuInfoBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SingleResultLabel" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource RuMutedBrush}" />
                        <ComboBox x:Name="ResultVersions" Grid.Column="1" MaxWidth="136" MinWidth="0" MinHeight="28"
                                  FontSize="11" Padding="8,0,24,0" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource RuMutedBrush}" DisplayMemberPath="Label" Visibility="Collapsed"
                                  SelectionChanged="OnResultVersionChanged" AutomationProperties.Name="Subagent result version" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="DetailScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,18,8,32" MaxWidth="720" Spacing="12">
                        <TextBlock x:Name="ResultStatus" FontSize="11" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PendingResult" Text="Working on this task. The result will appear here."
                                   FontSize="13" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultLoading" Text="Loading result…" Visibility="Collapsed" FontSize="12"
                                   Foreground="{StaticResource RuMutedBrush}" AutomationProperties.LiveSetting="Polite" />
                        <controls:MarkdownBlock x:Name="ResultBody" MarkdownText="" FontSize="14" Foreground="{StaticResource RuInkBrush}"
                                                AutomationProperties.Name="Subagent result" />
                        <Button x:Name="MoreButton" Content="Read more" Visibility="Collapsed" Click="OnNextPage"
                                Style="{StaticResource RuToolbarButtonStyle}" HorizontalAlignment="Left"
                                AutomationProperties.Name="Read more subagent result" />
                        <TextBlock x:Name="PreviewNotice" FontSize="12" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
