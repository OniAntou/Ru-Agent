<UserControl
    x:Class="RuApp.Controls.TurnProcessDisclosure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel>
        <!--
          Same quiet line as the compact agent activity row: a kind glyph that
          becomes the chevron on hover/focus/open, a sentence title and a short
          meta tail. No surface, no rule.
        -->
        <Button x:Name="HeaderButton"
                Click="OnHeaderClick"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Padding="2,4"
                MinHeight="28"
                CornerRadius="{StaticResource AppControlCornerRadius}"
                PointerEntered="OnHeaderPointerEntered"
                PointerExited="OnHeaderPointerExited"
                GotFocus="OnHeaderGotFocus"
                LostFocus="OnHeaderLostFocus"
                AutomationProperties.Name="Toggle turn process">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            </Button.Resources>
            <!-- The recap tail can outgrow a narrow column (the side panel); it trims, the title stays. -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <FontIcon x:Name="LeadingIcon" FontSize="13"
                              Foreground="{StaticResource RuMutedBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <FontIcon x:Name="ChevronIcon" Glyph="&#xE70D;" FontSize="12" Opacity="0"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="{StaticResource RuMutedBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <TextBlock x:Name="HeaderTextBlock" Grid.Column="1"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           Foreground="{StaticResource RuMutedBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="MetaText" Grid.Column="2"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           Foreground="{StaticResource RuMutedBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Button>
        <Grid x:Name="BodyHost" VerticalAlignment="Top" SizeChanged="OnBodySizeChanged">
            <Grid.Clip>
                <RectangleGeometry x:Name="BodyClip" Rect="0,0,0,0" />
            </Grid.Clip>
            <ContentPresenter Content="{x:Bind BodyContent, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</UserControl>
