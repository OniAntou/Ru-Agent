<UserControl
    x:Class="RuApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d">

    <Grid x:Name="ResponsiveRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SystemSettingsScrollViewer.Padding" Value="24,12,24,28"/>
                        <Setter Target="ObservationScrollViewer.Padding" Value="24,12,24,28"/>
                        <Setter Target="VtsSettingsScrollViewer.Padding" Value="24,12,24,28"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SystemSettingsScrollViewer.Padding" Value="12,12,12,24"/>
                        <Setter Target="ObservationScrollViewer.Padding" Value="12,12,12,24"/>
                        <Setter Target="VtsSettingsScrollViewer.Padding" Value="12,12,12,24"/>
                        <Setter Target="ConnectVtsButton.(Grid.Row)" Value="1"/>
                        <Setter Target="ConnectVtsButton.(Grid.Column)" Value="0"/>
                        <Setter Target="ConnectVtsButton.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="ConnectVtsButton.HorizontalAlignment" Value="Stretch"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <Pivot x:Name="SettingsPivot" Margin="0,8,0,0">
        <!-- Tab 1: System Settings -->
        <PivotItem Header="Hệ thống &amp; Mô hình" Margin="0,12,0,0">
            <ScrollViewer x:Name="SystemSettingsScrollViewer" Padding="36,12,36,36" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Cấu hình Hệ thống &amp; Mô hình" FontSize="22" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="Quản lý provider OpenAI-compatible, tham số sinh và tính năng bộ nhớ" FontSize="13.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Backend Model Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Mô hình &amp; Runtime Backend" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Loại Backend" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Chọn dịch vụ đám mây hoặc provider ngoài" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="BackendComboBox" Grid.Column="1" Width="300" SelectionChanged="OnBackendSelectionChanged">
                                    <ComboBoxItem Content="OpenCode Zen (Cloud API)" Tag="opencode"/>
                                    <ComboBoxItem Content="Kilo Gateway (Cloud API)" Tag="kilo"/>
                                    <ComboBoxItem Content="Ollama (Local: localhost:11434)" Tag="ollama"/>
                                    <ComboBoxItem Content="LM Studio (Local: localhost:1234)" Tag="lmstudio"/>
                                    <ComboBoxItem Content="Custom OpenAI Server" Tag="custom"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel x:Name="ModelRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                        <TextBlock Text="Model Name" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock x:Name="ModelLoadingText" Text="Đang tải danh sách model từ API..." Foreground="{StaticResource AppAccentHoverBrush}" FontSize="12.5" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Width="300">
                                        <TextBox x:Name="ModelSearchBox" PlaceholderText="Tìm kiếm model..." TextChanged="OnModelSearchBoxTextChanged"
                                                 CornerRadius="{StaticResource AppControlCornerRadius}"/>
                                        <ComboBox x:Name="ModelComboBox" Width="300" IsEditable="False"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="OpenCodeApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="OpenCode API Key" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Khóa API lưu an toàn trong Windows Credential Manager" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <PasswordBox x:Name="OpenCodeApiKeyBox" Grid.Column="1" PlaceholderText="sk-opencode-..." Width="300"
                                                 CornerRadius="{StaticResource AppControlCornerRadius}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="ApiVariantRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Reasoning Effort" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Mức độ suy luận cho mô hình hỗ trợ reasoning" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ApiVariantComboBox" Grid.Column="1" Width="300">
                                        <ComboBoxItem Content="Default" Tag="Default"/>
                                        <ComboBoxItem Content="Low" Tag="low"/>
                                        <ComboBoxItem Content="Medium" Tag="medium"/>
                                        <ComboBoxItem Content="High" Tag="high"/>
                                        <ComboBoxItem Content="Max" Tag="max"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="KiloApiRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Kilo API Key" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Khóa kết nối đến Kilo Gateway" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <PasswordBox x:Name="KiloApiKeyBox" Grid.Column="1" PlaceholderText="sk-kilo-..." Width="300"
                                                 CornerRadius="{StaticResource AppControlCornerRadius}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="KiloReasoningRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Reasoning cho tác vụ phức tạp" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Tắt để giảm thời gian chờ câu phản hồi đầu tiên" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="KiloReasoningToggle" Grid.Column="1" IsOn="False"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="CustomEndpointRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Custom Server URL" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Đường dẫn OpenAI-compatible endpoint" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBox x:Name="CustomEndpointUrlBox" Grid.Column="1" PlaceholderText="http://localhost:8000/v1" Width="300"
                                             CornerRadius="{StaticResource AppControlCornerRadius}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="CustomApiKeyRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Custom API Key" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Khóa API lưu an toàn trong Windows Credential Manager (tùy chọn)" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <PasswordBox x:Name="CustomApiKeyBox" Grid.Column="1" PlaceholderText="sk-..." Width="300"
                                                 CornerRadius="{StaticResource AppControlCornerRadius}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Generation Parameters Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE7BE;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Tham số sinh văn bản (Generation)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Temperature (Độ sáng tạo)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Giá trị cao cho phản hồi sinh động hơn, thấp cho câu trả lời chuẩn xác" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="TemperatureNumberBox" Grid.Column="1" Text="0.7" Width="140" TextAlignment="Center"
                                         CornerRadius="{StaticResource AppControlCornerRadius}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Top-K" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Giới hạn số token khả dĩ nhất trong mỗi bước dự đoán" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="TopKNumberBox" Grid.Column="1" Text="40" Width="140" TextAlignment="Center"
                                         CornerRadius="{StaticResource AppControlCornerRadius}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Max New Tokens (Độ dài tối đa)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Số lượng token tối đa mà Ru sinh ra trong 1 lượt trả lời" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="MaxTokensNumberBox" Grid.Column="1" Text="512" Width="140" TextAlignment="Center"
                                         CornerRadius="{StaticResource AppControlCornerRadius}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Extended Features Card (Visible for Cloud backends) -->
                    <Border x:Name="ExtendedFeaturesCard" Style="{StaticResource FluentCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Tính năng thông minh &amp; Bộ nhớ đám mây" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="OnlineSearchRow" Spacing="16">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Tìm kiếm Web trực tuyến" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Cho phép Ru tra cứu thông tin thời gian thực qua công cụ tìm kiếm" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AllowOnlineSearchToggle" Grid.Column="1" IsOn="True"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="SelfLearningRow" Spacing="16">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Tự động học &amp; ghi nhớ (Self-Learning)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Tự động trích xuất sở thích và thông tin từ hội thoại vào bộ nhớ dài hạn" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SelfLearningToggle" Grid.Column="1" IsOn="True"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="CloudMemoryRow" Spacing="16" Visibility="Collapsed">
                                <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Chia sẻ bộ nhớ với Cloud Models" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Cho phép truyền thông tin ngữ cảnh đã nhớ khi chat với Cloud API" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CloudMemoryConsentToggle" Grid.Column="1" IsOn="True"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="AutoSaveStatusText" Text="" FontSize="13" Foreground="{StaticResource AppSuccessBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Tab 2: Screen Observation -->
        <PivotItem Header="Nhận thức Màn hình" Margin="0,12,0,0">
            <ScrollViewer x:Name="ObservationScrollViewer" Padding="36,12,36,36" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7B3;" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Nhận thức Màn hình (Gemini Flash Live Observer)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                    <TextBlock Text="Bật Nhận thức Màn hình (Live Screen Observer)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock x:Name="ScreenObserverStatusText" Text="Trạng thái: Đang tắt" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12.5"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ScreenObserverToggle" Grid.Column="1" Toggled="OnScreenObserverToggled"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <Grid x:Name="GeminiVisionRow" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                    <TextBlock Text="Gemini Vision API Key" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Dùng cho Gemini Flash Screen Observation. Lấy key miễn phí tại aistudio.google.com" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12.5"/>
                                </StackPanel>
                                <PasswordBox x:Name="GeminiVisionKeyBox" Grid.Column="1" PlaceholderText="AIza..." Width="300"
                                             CornerRadius="{StaticResource AppControlCornerRadius}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Tab 3: VTube Studio -->
        <PivotItem Header="VTube Studio" Margin="0,12,0,0">
            <ScrollViewer x:Name="VtsSettingsScrollViewer" Padding="36,12,36,36" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="20">
                            <Grid x:Name="VtsConnectRow" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Avatar Live2D VTube Studio" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock x:Name="VtsStatusText" Text="Trạng thái: Chưa kết nối" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock x:Name="VtsStateText" Text="" Foreground="{StaticResource AppTextTertiaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <Button x:Name="ConnectVtsButton" Grid.Column="1" Click="OnConnectVtsClick" Padding="18,10" 
                                        CornerRadius="{StaticResource AppControlCornerRadius}" 
                                        Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE703;" FontSize="14" Foreground="{StaticResource AppAccentHoverBrush}"/>
                                        <TextBlock Text="Kết nối VTS" FontWeight="SemiBold" Foreground="{StaticResource AppAccentHoverBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <TextBlock Text="Cường độ chuyển động avatar (áp dụng ngay):" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Sway (Thân lắc lư)" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <Slider x:Name="SwaySlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" Value="100" Width="260" ValueChanged="OnVtsConfigSliderChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Đầu (Head motion)" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <Slider x:Name="HeadSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="1" Value="100" Width="260" ValueChanged="OnVtsConfigSliderChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Mắt (Eye movement)" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <Slider x:Name="EyeSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="1" Value="100" Width="260" ValueChanged="OnVtsConfigSliderChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Tần suất micro-action" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <Slider x:Name="MicroSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" Value="100" Width="260" ValueChanged="OnVtsConfigSliderChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Tần suất pose" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <Slider x:Name="PoseSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" Value="100" Width="260" ValueChanged="OnVtsConfigSliderChanged"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppCardBorderSubtleBrush}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Overlay desktop (Avatar nổi trong suốt)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Hiển thị avatar trên toàn màn hình desktop" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="OverlayToggle" Grid.Column="1" IsOn="False" Toggled="OnOverlayToggleChanged"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Nhìn theo con trỏ chuột (Mouse Look)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="Avatar tự quay đầu và mắt nhìn theo tọa độ chuột" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="MouseLookToggle" Grid.Column="1" IsOn="False" Toggled="OnMouseLookToggleChanged"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Độ nhạy nhìn theo chuột" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="MouseSensitivitySlider" Minimum="0" Maximum="200" StepFrequency="1" Value="100" Width="200" IsEnabled="False" ValueChanged="OnMouseSensitivityChanged"/>
                                    <TextBlock x:Name="MouseSensitivityText" Text="100%" Width="44" VerticalAlignment="Center" Foreground="{StaticResource AppAccentHoverBrush}" TextAlignment="Right" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="VtsOverlayErrorText" Text="" Foreground="{StaticResource AppDangerBrush}" FontSize="12.5" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Tab 4: Memory -->
        <PivotItem Header="Bộ nhớ ghi nhớ" Margin="0,12,0,0">
            <views:MemoryView x:Name="MemoryControl" />
        </PivotItem>
    </Pivot>
    </Grid>
</UserControl>
