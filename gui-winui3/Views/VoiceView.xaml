<UserControl
    x:Class="RuApp.Views.VoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDescStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="ResponsiveRoot" Padding="44,16,44,40" Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VoiceContentStack.MaxWidth" Value="1360"/>
                        <Setter Target="ResponsiveRoot.Padding" Value="44,16,44,40"/>
                        <!-- Bento 2-Column -->
                        <Setter Target="VoiceBentoGrid.ColumnDefinitions" Value="*,*"/>
                        <Setter Target="VoiceConfigCard.(Grid.Row)" Value="0"/>
                        <Setter Target="VoiceConfigCard.(Grid.Column)" Value="0"/>
                        <Setter Target="VoiceConfigCard.Margin" Value="0,0,8,0"/>
                        <Setter Target="VoiceRightColumn.(Grid.Row)" Value="0"/>
                        <Setter Target="VoiceRightColumn.(Grid.Column)" Value="1"/>
                        <Setter Target="VoiceRightColumn.Margin" Value="10,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VoiceContentStack.MaxWidth" Value="1000"/>
                        <Setter Target="ResponsiveRoot.Padding" Value="28,12,28,32"/>
                        <!-- Single Column -->
                        <Setter Target="VoiceBentoGrid.ColumnDefinitions" Value="*"/>
                        <Setter Target="VoiceConfigCard.(Grid.Row)" Value="0"/>
                        <Setter Target="VoiceConfigCard.(Grid.Column)" Value="0"/>
                        <Setter Target="VoiceConfigCard.Margin" Value="0,0,0,20"/>
                        <Setter Target="VoiceRightColumn.(Grid.Row)" Value="1"/>
                        <Setter Target="VoiceRightColumn.(Grid.Column)" Value="0"/>
                        <Setter Target="VoiceRightColumn.Margin" Value="0,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ResponsiveRoot.Padding" Value="14,8,14,24"/>
                        <Setter Target="ActionButtonsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="VtsActionButtonsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="TestTextBox.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TestVoiceButton.(Grid.Row)" Value="1"/>
                        <Setter Target="TestVoiceButton.(Grid.Column)" Value="0"/>
                        <Setter Target="TestVoiceButton.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TestTextBox.Margin" Value="0,0,0,8"/>
                        <Setter Target="TestVoiceButton.HorizontalAlignment" Value="Stretch"/>
                        <!-- Single Column -->
                        <Setter Target="VoiceBentoGrid.ColumnDefinitions" Value="*"/>
                        <Setter Target="VoiceConfigCard.(Grid.Row)" Value="0"/>
                        <Setter Target="VoiceConfigCard.(Grid.Column)" Value="0"/>
                        <Setter Target="VoiceConfigCard.Margin" Value="0,0,0,16"/>
                        <Setter Target="VoiceRightColumn.(Grid.Row)" Value="1"/>
                        <Setter Target="VoiceRightColumn.(Grid.Column)" Value="0"/>
                        <Setter Target="VoiceRightColumn.Margin" Value="0,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel x:Name="VoiceContentStack" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="1360">
            <!-- Header Banner -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                <StackPanel Grid.Column="0" Spacing="4">
                    <Border HorizontalAlignment="Left"
                            Padding="8,3"
                            Background="{StaticResource RuAccentSoftBrush}"
                            BorderBrush="{StaticResource RuAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RuControlCornerRadius}">
                        <TextBlock Text="AUDIO &amp; EXPRESSION"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   Foreground="{StaticResource RuAccentBrush}"/>
                    </Border>
                    <TextBlock Text="Voice &amp; VTS Settings"
                               FontSize="24"
                               FontFamily="{StaticResource RuDisplayFontFamily}"
                               FontWeight="Bold"
                               Foreground="{StaticResource RuInkBrush}"/>
                    <TextBlock Text="Customize OmniVoice speech, live subtitles, and VTube Studio virtual avatar integration"
                               FontSize="12.5"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               Foreground="{StaticResource RuMutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Bento 2-Column Grid -->
            <Grid x:Name="VoiceBentoGrid" ColumnDefinitions="*,*">
                
                <!-- Left Column: OmniVoice TTS Configuration -->
                <Border x:Name="VoiceConfigCard" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="16">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,2">
                            <Border Width="36" Height="36"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    Background="{StaticResource RuAccentSoftBrush}"
                                    BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1">
                                <FontIcon Glyph="&#xE720;" FontSize="15" Foreground="{StaticResource RuAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="OmniVoice TTS Configuration"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           Foreground="{StaticResource RuInkBrush}"/>
                                <TextBlock Text="Voice quality and automatic speech playback"
                                           FontSize="11.5"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           Foreground="{StaticResource RuMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                        <!-- Voice Profile Picker -->
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="Voice Profile" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Select normalized voice profile for Ru or Ai Vy" Style="{StaticResource SettingDescStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="VoiceProfileComboBox"
                                      Grid.Column="1"
                                      Width="220"
                                      Height="36"
                                      CornerRadius="{StaticResource RuControlCornerRadius}"
                                      SelectionChanged="OnVoiceProfileChanged">
                                <ComboBoxItem Content="Ru (OmniVoice)" Tag="Ru (OmniVoice)"/>
                                <ComboBoxItem Content="Ai Vy (OmniVoice)" Tag="Ai Vy (OmniVoice)"/>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                        <!-- Speed Slider -->
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="Base Speech Speed" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Adjust playback rhythm from 0.75x to 1.20x" Style="{StaticResource SettingDescStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Slider x:Name="SpeedSlider" Minimum="0.75" Maximum="1.20" StepFrequency="0.05" Value="1.0" Width="140" ValueChanged="OnSpeedSliderChanged"/>
                                <Border Background="{StaticResource RuSurfaceBrush}" BorderBrush="{StaticResource RuLineBrush}" 
                                        BorderThickness="1" CornerRadius="{StaticResource RuControlCornerRadius}" Padding="8,4" MinWidth="52">
                                    <TextBlock x:Name="SpeedText" Text="1.00x" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource RuInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                        <!-- Auto Pace Toggle -->
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="Auto-pace Speech (±0.08x)" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Subtly adjust speed based on contextual emotions" Style="{StaticResource SettingDescStyle}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoPaceToggle" Grid.Column="1" IsOn="False" Toggled="OnAutoPaceToggled"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                        <!-- Auto Read Aloud Toggle -->
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="Read replies aloud" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Stream speech audio sentence by sentence as replies arrive" Style="{StaticResource SettingDescStyle}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoReadToggle" Grid.Column="1" IsOn="True" Toggled="OnAutoReadToggled"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                        <!-- Subtitles Overlay Toggle -->
                        <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="Display subtitles on VTube Studio model" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Floating subtitles follow Live2D model motion automatically" Style="{StaticResource SettingDescStyle}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="SubtitleToggle" Grid.Column="1" IsOn="False" Toggled="OnSubtitleToggled"/>
                        </Grid>

                        <!-- Subtitle Customization Panel -->
                        <StackPanel x:Name="SubtitleCustomizationPanel" Spacing="16" Margin="0,4,0,0" Visibility="Collapsed">
                            <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                            <!-- Font Size Selector -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                <TextBlock Grid.Column="0" Text="Subtitle Font Size" Style="{StaticResource SettingLabelStyle}"/>
                                <ComboBox x:Name="SubtitleSizeCombo" Grid.Column="1" Width="160" Height="36" CornerRadius="{StaticResource RuControlCornerRadius}" SelectionChanged="OnSubtitleSizeChanged">
                                    <ComboBoxItem Content="Small" Tag="small"/>
                                    <ComboBoxItem Content="Medium" Tag="medium" IsSelected="True"/>
                                    <ComboBoxItem Content="Large" Tag="large"/>
                                    <ComboBoxItem Content="Extra Large" Tag="xlarge"/>
                                </ComboBox>
                            </Grid>

                            <!-- Color Selector -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                <TextBlock Grid.Column="0" Text="Subtitle Text Color" Style="{StaticResource SettingLabelStyle}"/>
                                <ComboBox x:Name="SubtitleColorCombo" Grid.Column="1" Width="160" Height="36" CornerRadius="{StaticResource RuControlCornerRadius}" SelectionChanged="OnSubtitleColorChanged">
                                    <ComboBoxItem Content="Pure White" Tag="#FFFFFF" IsSelected="True"/>
                                    <ComboBoxItem Content="Pastel Yellow" Tag="#FFE082"/>
                                    <ComboBoxItem Content="Sakura Pink" Tag="#FF80AB"/>
                                    <ComboBoxItem Content="Xanh Sky Blue" Tag="#80D8FF"/>
                                    <ComboBoxItem Content="Mint Green" Tag="#B9F6CA"/>
                                </ComboBox>
                            </Grid>

                            <!-- Hold Duration Slider -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Subtitle Hold Duration" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock x:Name="SubtitleDurationLabel" Text="Display duration after speech: 2.0s" Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>
                                <Slider x:Name="SubtitleDurationSlider" Grid.Column="1" Width="140" Minimum="1.0" Maximum="5.0" StepFrequency="0.5" Value="2.0" ValueChanged="OnSubtitleDurationChanged"/>
                            </Grid>

                            <!-- Subtitle Position Mode & Drag-Drop Controls -->
                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock Text="Subtitle Position" Style="{StaticResource SettingLabelStyle}"/>
                                    <TextBlock x:Name="SubtitlePositionStatusLabel" Text="Status: Automatically following Avatar" Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SubtitleDragButton" Click="OnSubtitleDragButtonClicked"
                                            Padding="12,7"
                                            CornerRadius="{StaticResource RuControlCornerRadius}"
                                            Background="{StaticResource RuAccentSoftBrush}"
                                            BorderBrush="{StaticResource RuAccentBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="SubtitleDragIcon" Glyph="&#xE7C2;" FontSize="12" Foreground="{StaticResource RuAccentBrush}"/>
                                            <TextBlock x:Name="SubtitleDragButtonText" Text="Drag to position" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RuAccentBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SubtitleResetPosButton" Click="OnSubtitleResetPosClicked"
                                            Padding="10,7"
                                            CornerRadius="{StaticResource RuControlCornerRadius}"
                                            Background="{StaticResource RuSurfaceBrush}"
                                            BorderBrush="{StaticResource RuLineBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource RuInkBrush}"/>
                                            <TextBlock Text="Default" FontSize="12" Foreground="{StaticResource RuInkBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: GPU Lifecycle & Voice Tester Bento Cards -->
                <StackPanel x:Name="VoiceRightColumn" Grid.Column="1" Margin="8,0,0,0" Spacing="16">
                    
                    <!-- Voice Sample Tester Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel x:Name="VtsActionButtonsPanel" Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36"
                                        CornerRadius="{StaticResource RuControlCornerRadius}"
                                        Background="{StaticResource RuAccentSoftBrush}"
                                        BorderBrush="{StaticResource RuLineBrush}"
                                        BorderThickness="1">
                                    <FontIcon Glyph="&#xE767;" FontSize="15" Foreground="{StaticResource RuAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Sample Audio Preview"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               Foreground="{StaticResource RuInkBrush}"/>
                                    <TextBlock Text="Test speech voice and realistic intonation"
                                               FontSize="11.5"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               Foreground="{StaticResource RuMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                            <Grid x:Name="TestVoiceRow" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TestTextBox" Grid.Column="0" Text="Hello, I'm Ru! How are you doing today?" 
                                         Margin="0,0,12,0" VerticalAlignment="Center" Height="36" Padding="10,6"
                                         CornerRadius="{StaticResource RuControlCornerRadius}"/>
                                <Button x:Name="TestVoiceButton" Grid.Column="1" Click="OnTestVoiceClick" Padding="16,8" 
                                        CornerRadius="{StaticResource RuControlCornerRadius}" 
                                        Background="{StaticResource RuAccentSoftBrush}" BorderBrush="{StaticResource RuAccentBrush}" 
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{StaticResource RuAccentBrush}"/>
                                        <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource RuAccentBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GPU Lifecycle Controls Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36"
                                        CornerRadius="{StaticResource RuControlCornerRadius}"
                                        Background="{StaticResource RuAccentSoftBrush}"
                                        BorderBrush="{StaticResource RuLineBrush}"
                                        BorderThickness="1">
                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{StaticResource RuAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Voice GPU Lifecycle Management"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               Foreground="{StaticResource RuInkBrush}"/>
                                    <TextBlock Text="Initialize or release model VRAM"
                                               FontSize="11.5"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               Foreground="{StaticResource RuMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6"/>

                            <TextBlock Text="Pre-warm OmniVoice weights into VRAM to reduce first-sentence latency, or release GPU when running other apps." 
                                       Style="{StaticResource SettingDescStyle}"/>

                            <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button x:Name="WarmupButton" Click="OnWarmupClick" Padding="16,8" 
                                        CornerRadius="{StaticResource RuControlCornerRadius}" 
                                        Background="{StaticResource RuAccentBrush}" Foreground="White" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                        <TextBlock Text="Initialize GPU" FontWeight="SemiBold" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ReleaseButton" Click="OnReleaseClick" Padding="16,8" 
                                        CornerRadius="{StaticResource RuControlCornerRadius}" 
                                        Background="{StaticResource RuAccentSoftBrush}" BorderBrush="{StaticResource RuDangerBrush}" 
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="{StaticResource RuDangerBrush}"/>
                                        <TextBlock Text="Release VRAM" FontWeight="Medium" FontSize="12.5" Foreground="{StaticResource RuDangerBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
