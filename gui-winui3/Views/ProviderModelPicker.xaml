<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Views.ProviderModelPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnPickerKeyDown"
    Width="328">

    <StackPanel Spacing="0">
        <!-- The flyout already has a border, so a second border around the field made a
             box inside a box. The field is bounded by one rule instead, and that rule
             is the same line that used to sit below it, so the search costs one edge
             rather than three. Focus repaints it in code-behind: the field has to say
             where the caret is, and a TextBox with no border of its own cannot.

             The margins are not a number that looks right, they are two alignments:
             17 puts the magnifier's left edge on the same line as the model names, and
             12 puts the rule's right edge on the same line as the context figures. A
             panel whose whole argument is a column of numbers cannot open with its own
             field hanging 13px out of line with the column it filters. -->
        <Grid Margin="17,10,12,0" ColumnDefinitions="Auto,*">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon Grid.Row="0"
                      Glyph="&#xE721;"
                      FontSize="12"
                      Foreground="{StaticResource RuMutedBrush}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,5" />
            <Border x:Name="PickerSearchField"
                    Grid.Row="1"
                    Height="1"
                    Background="{StaticResource RuLineBrush}" />
            <TextBox x:Name="PickerSearchBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     AutomationProperties.AutomationId="ModelSearchBox"
                     AutomationProperties.Name="Search models"
                     PlaceholderText="Search models or providers"
                     TextChanged="OnPickerSearchTextChanged"
                     FontFamily="{StaticResource RuUiFontFamily}"
                     FontSize="13"
                     MinHeight="0"
                     Padding="0"
                     Margin="0,0,0,5"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     IsSpellCheckEnabled="False"
                     Foreground="{StaticResource RuInkBrush}">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <Thickness x:Key="TextControlThemePadding">0</Thickness>
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <!-- A catalog of several hundred models is a list, not a document, so the list
             is the panel's floor: anything taller than this and the flyout stops being a
             flyout. The scrollbar resources below stay as they are, tuned thin, because
             a stock WinUI scrollbar is wider than the row text beside it. -->
        <ScrollViewer MaxHeight="300"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      Padding="6,6,6,6">
            <ScrollViewer.Resources>
                <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuMutedColor}" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                <x:Double x:Key="ScrollBarSize">5</x:Double>
            </ScrollViewer.Resources>
            <StackPanel x:Name="PickerListContainer" Spacing="0" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
