<UserControl
    x:Class="RuApp.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,16" HorizontalAlignment="Stretch">
                <Border MaxWidth="560"
                        HorizontalAlignment="Right"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuAccentBrush}"
                        BorderThickness="0,0,2,0"
                        Padding="14,10">
                    <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                            FontSize="16"
                                            Foreground="{StaticResource RuInkBrush}"
                                            FontFamily="{StaticResource RuUiFontFamily}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,18" HorizontalAlignment="Stretch">
                <Grid MaxWidth="700"
                      HorizontalAlignment="Left"
                      ColumnDefinitions="2,*">
                    <Rectangle x:Name="AssistantAccentRule"
                               Grid.Column="0"
                               Width="2"
                               Fill="{StaticResource RuAccentBrush}"
                               Opacity="0.72"
                               VerticalAlignment="Stretch" />
                    <StackPanel Grid.Column="1"
                                Spacing="6"
                                Margin="12,0,0,0">
                        <TextBlock Text="Ru"
                                   FontFamily="{StaticResource RuDisplayFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource RuAccentBrush}" />
                        <Rectangle x:Name="TypingCaret"
                                   Width="1"
                                   Height="20"
                                   Fill="{StaticResource RuAccentBrush}"
                                   Visibility="{x:Bind ShowTypingDots, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                                FontSize="16"
                                                Foreground="{x:Bind IsError, Converter={StaticResource ErrorColorConverter}}"
                                                FontFamily="{StaticResource RuUiFontFamily}"
                                                Visibility="{x:Bind ShowContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <views:ChatMessageTemplateSelector x:Key="ChatTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Background="{StaticResource RuCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InputContainer.Padding" Value="0,6,0,18" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="16,12" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SuggestionPanel.Orientation" Value="Vertical" />
                        <Setter Target="SuggestionPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="InputContainer.Padding" Value="0,4,0,12" />
                        <Setter Target="InputBorder.Padding" Value="4,2" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:MeteorShowerField x:Name="MeteorShowerField"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />

        <Grid x:Name="ReadingColumn"
              Grid.Row="0"
              HorizontalAlignment="Stretch"
              Background="Transparent">
            <StackPanel x:Name="WelcomeHeroPanel"
                        MaxWidth="820"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="18"
                        Margin="24,16"
                        Visibility="Visible">
                <TextBlock x:Name="WelcomeEyebrow"
                           Text="RU / CONVERSATIONAL RUNTIME"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{StaticResource RuMutedBrush}" />
                <TextBlock Text="Ru"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="14"
                           Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock x:Name="WelcomeIntro"
                           Text="Chào anh. Hôm nay mình bắt đầu từ đâu?"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="28"
                           Foreground="{StaticResource RuInkBrush}"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SuggestionPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="24">
                    <Button Tag="Hỏi về một việc đang làm"
                            Click="OnSuggestionClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource RuMutedBrush}"
                            Padding="0,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}"
                            ToolTipService.ToolTip="Hỏi về một việc đang làm">
                        <TextBlock Text="Hỏi về một việc đang làm"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                    <Button Tag="Nói cho Ru nghe"
                            Click="OnSuggestionClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource RuMutedBrush}"
                            Padding="0,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}"
                            ToolTipService.ToolTip="Nói cho Ru nghe">
                        <TextBlock Text="Nói cho Ru nghe"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="ChatScrollHost"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Bottom"
                          Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuAccentColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                    <x:Double x:Key="ScrollBarSize">8</x:Double>
                </ScrollViewer.Resources>
                <Grid x:Name="ChatContentGrid" HorizontalAlignment="Center">
                    <ListView x:Name="ChatListView"
                              AutomationProperties.AutomationId="ChatMessages"
                              Padding="16,16,16,16"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical"
                                                 HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="InputContainer"
              Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto"
              Width="820"
              MaxWidth="820"
              Background="Transparent"
              Padding="0,8,0,24"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center">
            <TextBlock x:Name="VoiceConversationStatusText"
                       Grid.Row="0"
                       Text=""
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="VoiceConversationStatus"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{StaticResource RuMutedBrush}"
                       Margin="8,0,8,6" />

            <StackPanel x:Name="AgentInlinePanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Spacing="6"
                        Margin="8,0,8,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="AgentStatusText"
                               AutomationProperties.AutomationId="AgentStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource RuMutedBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="AgentStopButton"
                            Grid.Column="1"
                            Content="Dừng"
                            Click="OnAgentStopClick"
                            Visibility="Collapsed"
                            Padding="10,4"
                            AutomationProperties.AutomationId="AgentStopButton"
                            AutomationProperties.Name="Dừng Coding Agent"
                            ToolTipService.ToolTip="Dừng phiên Coding Agent" />
                </Grid>

                <Border x:Name="AgentTrustPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RuControlCornerRadius}"
                        Padding="10,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Workspace cần được xác nhận"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuAccentBrush}" />
                        <TextBlock x:Name="AgentTrustText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RuInkBrush}"
                                   AutomationProperties.AutomationId="AgentTrustText" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AgentTrustDenyButton"
                                    Content="Từ chối"
                                    Click="OnAgentTrustDenyClick"
                                    AutomationProperties.AutomationId="AgentTrustDenyButton"
                                    AutomationProperties.Name="Từ chối workspace" />
                            <Button x:Name="AgentTrustApproveButton"
                                    Content="Tin cậy workspace"
                                    Click="OnAgentTrustApproveClick"
                                    AutomationProperties.AutomationId="AgentTrustApproveButton"
                                    AutomationProperties.Name="Tin cậy workspace" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AgentApprovalPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RuControlCornerRadius}"
                        Padding="10,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Agent cần anh phê duyệt một hành động"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuAccentBrush}" />
                        <TextBlock x:Name="AgentApprovalSummaryText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RuInkBrush}"
                                   AutomationProperties.AutomationId="AgentApprovalSummaryText" />
                        <StackPanel x:Name="AgentApprovalScopePanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock Text="Phạm vi"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource RuMutedBrush}" />
                            <ComboBox x:Name="AgentApprovalScopeBox"
                                      SelectedIndex="0"
                                      MinWidth="190"
                                      AutomationProperties.AutomationId="AgentApprovalScopeBox"
                                      AutomationProperties.Name="Phạm vi phê duyệt Agent">
                                <ComboBoxItem Content="Chỉ lần này" Tag="once" />
                                <ComboBoxItem Content="Cho phiên hiện tại" Tag="run" />
                                <ComboBoxItem Content="Cho project này" Tag="project" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AgentDenyButton"
                                    Content="Từ chối"
                                    Click="OnAgentDenyClick"
                                    AutomationProperties.AutomationId="AgentDenyButton"
                                    AutomationProperties.Name="Từ chối hành động của Agent" />
                            <Button x:Name="AgentApproveButton"
                                    Content="Duyệt theo phạm vi"
                                    Click="OnAgentApproveClick"
                                    AutomationProperties.AutomationId="AgentApproveButton"
                                    AutomationProperties.Name="Duyệt theo phạm vi cho Agent" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="AgentContinueButton"
                        Content="Tiếp tục"
                        Click="OnAgentContinueClick"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        AutomationProperties.AutomationId="AgentContinueButton"
                        AutomationProperties.Name="Tiếp tục phiên Coding Agent" />
            </StackPanel>

            <Border x:Name="InputBorder"
                    Grid.Row="2"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RuControlCornerRadius}"
                    Padding="10,10,10,8">
                <Grid RowDefinitions="Auto,Auto">
                    <TextBox x:Name="ChatInputTextBox"
                             Grid.Row="0"
                             AutomationProperties.AutomationId="ChatInput"
                             PlaceholderText="Viết cho Ru..."
                             PreviewKeyDown="OnChatInputPreviewKeyDown"
                             AcceptsReturn="True"
                             MinHeight="44"
                             MaxHeight="150"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="{StaticResource RuUiFontFamily}"
                             FontSize="15"
                             Padding="4,2,4,6"
                             Foreground="{StaticResource RuInkBrush}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          Margin="0,4,0,0">
                        <Button x:Name="AgentModeButton"
                                Grid.Column="0"
                                Click="OnAgentModeButtonClick"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="AgentModeButton"
                                AutomationProperties.Name="Chọn chế độ Chat hoặc Coding Agent"
                                ToolTipService.ToolTip="Chọn chế độ Chat hoặc Coding Agent">
                             <Button.Flyout>
                                 <Flyout x:Name="AgentModeFlyout" Placement="Top">
                                     <Flyout.FlyoutPresenterStyle>
                                         <Style TargetType="FlyoutPresenter">
                                             <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                             <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                             <Setter Property="BorderThickness" Value="1" />
                                             <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                             <Setter Property="Padding" Value="6" />
                                             <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                         </Style>
                                     </Flyout.FlyoutPresenterStyle>
                                     <StackPanel Width="208" Spacing="2" Padding="0">
                                         <StackPanel.Resources>
                                             <SolidColorBrush x:Key="RadioButtonForeground" Color="{ThemeResource RuInkColor}" />
                                             <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{ThemeResource RuInkColor}" />
                                             <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{ThemeResource RuInkColor}" />
                                             <SolidColorBrush x:Key="RadioButtonBackground" Color="Transparent" />
                                             <StaticResource x:Key="RadioButtonBackgroundPointerOver" ResourceKey="RuAccentSoftBrush" />
                                             <StaticResource x:Key="RadioButtonBackgroundPressed" ResourceKey="RuAccentSoftBrush" />
                                             <StaticResource x:Key="RadioButtonOuterEllipseStroke" ResourceKey="RuMutedBrush" />
                                             <StaticResource x:Key="RadioButtonOuterEllipseStrokePointerOver" ResourceKey="RuAccentBrush" />
                                             <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="RuAccentBrush" />
                                             <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="RuAccentBrush" />
                                         </StackPanel.Resources>
                                         <RadioButton x:Name="AgentModeChatOption"
                                                      Content="Trò chuyện"
                                                      Tag="chat"
                                                      GroupName="RuResponseMode"
                                                      IsChecked="True"
                                                      Click="OnAgentModeOptionClick"
                                                      Padding="10,8"
                                                      MinHeight="38"
                                                      Margin="0"
                                                      HorizontalContentAlignment="Stretch"
                                                      FontFamily="{StaticResource RuUiFontFamily}"
                                                      FontSize="13"
                                                      Foreground="{StaticResource RuInkBrush}"
                                                      AutomationProperties.AutomationId="AgentModeChatOption"
                                                      AutomationProperties.Name="Chế độ Trò chuyện" />
                                         <RadioButton x:Name="AgentModeAgentOption"
                                                      Content="Coding Agent"
                                                      Tag="agent"
                                                      GroupName="RuResponseMode"
                                                      Click="OnAgentModeOptionClick"
                                                      Padding="10,8"
                                                      MinHeight="38"
                                                      Margin="0"
                                                      HorizontalContentAlignment="Stretch"
                                                      FontFamily="{StaticResource RuUiFontFamily}"
                                                      FontSize="13"
                                                      Foreground="{StaticResource RuInkBrush}"
                                                      AutomationProperties.AutomationId="AgentModeAgentOption"
                                                      AutomationProperties.Name="Chế độ Coding Agent" />
                                     </StackPanel>
                                 </Flyout>
                             </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="AgentModeIcon"
                                          Glyph="&#xE8F2;"
                                          FontSize="12"
                                          Foreground="{StaticResource RuMutedBrush}" />
                                <TextBlock x:Name="AgentModeLabel"
                                           Text="Chat"
                                           FontSize="12"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;"
                                          FontSize="10"
                                          Foreground="{StaticResource RuMutedBrush}"
                                          VerticalAlignment="Center" />
                             </StackPanel>
                         </Button>

                        <Button x:Name="AgentSettingsButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="AgentSettingsButton"
                                AutomationProperties.Name="Cài đặt Coding Agent"
                                ToolTipService.ToolTip="Cấu hình workspace và preset của Coding Agent">
                            <Button.Flyout>
                                <Flyout x:Name="AgentSettingsFlyout" Placement="Top">
                                    <StackPanel Width="300" Spacing="8" Padding="4">
                                        <TextBlock Text="Cấu hình Agent"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource RuInkBrush}" />
                                        <TextBox x:Name="AgentWorkspaceBox"
                                                 Header="Thư mục làm việc (tuỳ chọn)"
                                                 PlaceholderText="Để trống để dùng project root"
                                                 AutomationProperties.AutomationId="AgentWorkspaceBox"
                                                 AutomationProperties.Name="Thư mục làm việc của Agent" />
                                        <ComboBox x:Name="AgentPresetBox"
                                                  Header="Preset quyền"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnAgentPresetChanged"
                                                  AutomationProperties.AutomationId="AgentPresetBox"
                                                  AutomationProperties.Name="Preset quyền của Agent">
                                            <ComboBoxItem Content="Standard" Tag="standard" />
                                            <ComboBoxItem Content="Full Access" Tag="full_access" />
                                        </ComboBox>
                                        <TextBlock Text="Full Access vẫn chạy dưới quyền người dùng Windows hiện tại và luôn cần xác nhận."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource RuMutedBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE713;"
                                          FontSize="12"
                                          Foreground="{StaticResource RuMutedBrush}" />
                                <TextBlock Text="Cấu hình"
                                           FontSize="12"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="MicButton"
                                Grid.Column="2"
                                Click="OnMicClick"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="MicButton"
                                AutomationProperties.Name="Bắt đầu trò chuyện bằng giọng nói"
                                ToolTipService.ToolTip="Nói chuyện với Ru bằng giọng nói">
                            <FontIcon x:Name="MicIcon"
                                      Glyph="&#xE720;"
                                      FontSize="14"
                                      Foreground="{StaticResource RuMutedBrush}" />
                        </Button>



                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                AutomationProperties.AutomationId="SendButton"
                                Click="OnSendClick"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="{StaticResource RuAccentBrush}"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Gửi tin nhắn">
                            <FontIcon Glyph="&#xE725;" FontSize="13" Foreground="White" Margin="-1,1,0,0" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
