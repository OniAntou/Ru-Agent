<UserControl
    x:Class="RuApp.Views.CustomizeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RuApp.Models"
    AutomationProperties.Name="Customize">

    <UserControl.Resources>
        <Style x:Key="CustomizeTabStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        </Style>

        <!-- Plugins empty state: a whole card is one button, lifted on hover. -->
        <Style x:Key="PluginStartCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.BorderBrush" Value="{StaticResource RuAccentBrush}" />
                                            <Setter Target="HoverLayer.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.BorderBrush" Value="{StaticResource RuAccentBrush}" />
                                            <Setter Target="PressLayer.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="HoverLayer" Background="{StaticResource RuAccentSoftBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <Border x:Name="PressLayer" Background="{StaticResource RuLineBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PluginStartIconStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="Background" Value="{StaticResource RuAccentSoftBrush}" />
        </Style>
        <Style x:Key="PluginStartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
        </Style>
        <Style x:Key="PluginStartBodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
        </Style>

        <DataTemplate x:Key="SkillRowTemplate" x:DataType="models:CustomizeSkillRow">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="4,12"
                  BorderBrush="{StaticResource RuLineBrush}" BorderThickness="0,0,0,1">
                <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top"
                        CornerRadius="{StaticResource AppControlCornerRadius}"
                        Background="{StaticResource RuSurfaceBrush}">
                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{StaticResource RuMutedBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5"
                               FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Description}" FontSize="12.5" Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Origin}" FontSize="11.5" Foreground="{StaticResource RuMutedBrush}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Origin}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Enabled}" IsEnabled="{x:Bind CanManage}" Tag="{x:Bind}"
                              OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                              Toggled="OnSkillEnabledToggled"
                              AutomationProperties.Name="{x:Bind Name}" />
                <Button Grid.Column="3" Tag="{x:Bind}" VerticalAlignment="Center" Padding="8,6"
                        Style="{StaticResource RuToolbarButtonStyle}"
                        AutomationProperties.Name="Skill actions"
                        ToolTipService.ToolTip="Skill actions">
                    <FontIcon Glyph="&#xE712;" FontSize="13" />
                    <Button.Flyout>
                        <MenuFlyout Opening="OnSkillMenuOpening">
                            <MenuFlyoutItem Text="Use in chat" Tag="{x:Bind}" IsEnabled="{x:Bind CanUse}" Click="OnUseSkillClick" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="Ru may use it automatically" Tag="{x:Bind}" IsEnabled="{x:Bind CanManage}" Click="OnSkillAutomaticClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SkillSkeletonTemplate">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4,16"
                  BorderBrush="{StaticResource RuLineBrush}" BorderThickness="0,0,0,1">
                <Border Width="32" Height="32" CornerRadius="{StaticResource AppControlCornerRadius}"
                        Background="{StaticResource RuLineBrush}" Opacity="0.5" />
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <Border Height="10" MaxWidth="220" HorizontalAlignment="Left" Width="220"
                            CornerRadius="{StaticResource AppMicroPillCornerRadius}" Background="{StaticResource RuLineBrush}" Opacity="0.65" />
                    <Border Height="8" MaxWidth="360" CornerRadius="{StaticResource AppMicroPillCornerRadius}"
                            Background="{StaticResource RuLineBrush}" Opacity="0.4" />
                </StackPanel>
                <Border Grid.Column="2" Width="36" Height="18" CornerRadius="{StaticResource AppPillCornerRadius}"
                        Background="{StaticResource RuLineBrush}" Opacity="0.4" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="36,24,36,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16" Background="Transparent">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Customize" Style="{StaticResource RuViewHeaderStyle}" />
            <TextBlock x:Name="WorkspaceText" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Padding="4"
                        Background="{StaticResource RuSurfaceBrush}" CornerRadius="{StaticResource AppControlCornerRadius}">
                <ToggleButton x:Name="SkillsTab" Content="Skills" IsChecked="True" Click="OnTabClick" Tag="skills"
                              Style="{StaticResource CustomizeTabStyle}" AutomationProperties.AutomationId="CustomizeSkillsTab" />
                <ToggleButton x:Name="PluginsTab" Content="Plugins" Click="OnTabClick" Tag="plugins"
                              Style="{StaticResource CustomizeTabStyle}" AutomationProperties.AutomationId="CustomizePluginsTab" />
                <ToggleButton x:Name="InstructionsTab" Content="Instructions" Click="OnTabClick" Tag="instructions"
                              Style="{StaticResource CustomizeTabStyle}" AutomationProperties.AutomationId="CustomizeInstructionsTab" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="260" PlaceholderText="Search skills"
                     TextChanged="OnSearchChanged" AutomationProperties.Name="Search skills" />
            <Button x:Name="RefreshButton" Grid.Column="3" Click="OnRefreshClick" Padding="8,6"
                    Style="{StaticResource RuToolbarButtonStyle}"
                    AutomationProperties.Name="Reload skills" ToolTipService.ToolTip="Reload skills from disk">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
            <Button x:Name="AddButton" Grid.Column="4" Style="{StaticResource RuSecondaryButtonStyle}" Padding="12,6"
                    AutomationProperties.Name="Add skills">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Add" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Local skill folder…" Click="OnAddFolderClick" />
                        <MenuFlyoutItem Text="Install from GitHub…" Click="OnInstallPackageClick" />
                        <MenuFlyoutItem Text="Update a GitHub package…" Click="OnUpdatePackageClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Remove a skill folder…" Click="OnRemoveFolderClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="SkillsPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="SkillsSkeleton" Visibility="Collapsed" IsHitTestVisible="False"
                                  ItemTemplate="{StaticResource SkillSkeletonTemplate}"
                                  AutomationProperties.AccessibilityView="Raw" />
                    <ItemsControl x:Name="SkillsList" ItemTemplate="{StaticResource SkillRowTemplate}"
                                  AutomationProperties.Name="Skills" />
                    <TextBlock x:Name="SkillsEmptyText" Visibility="Collapsed" Margin="4,16"
                               FontSize="13" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap"
                               Text="No skills found. Add a local skill folder with Add." />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PluginsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          SizeChanged="OnPluginsPanelSizeChanged">
                <StackPanel Spacing="32" Padding="4,4,12,32">
                    <!-- User plugins (ADR 0044): bundles of skills and instructions, off
                         until enabled, applied to new turns. -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Your plugins" FontFamily="{StaticResource RuUiFontFamily}" FontSize="16"
                                           FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                                <TextBlock FontFamily="{StaticResource RuUiFontFamily}" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           Text="Bundles of skills, instructions and tools. Turn one on and Ru uses it from your next message." />
                            </StackPanel>
                            <Button x:Name="OpenPluginsFolderButton" Grid.Column="1" Click="OnOpenPluginsFolderClick"
                                    Style="{StaticResource RuToolbarButtonStyle}" Padding="8,6" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Open the plugins folder"
                                    AutomationProperties.Name="Open the plugins folder">
                                <FontIcon Glyph="&#xE838;" FontSize="13" />
                            </Button>
                            <Button x:Name="NewPluginButton" Grid.Column="2" VerticalAlignment="Center"
                                    Style="{StaticResource RuPrimaryButtonStyle}" Padding="12,6"
                                    AutomationProperties.Name="Add a plugin">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add plugin" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="New plugin…" Click="OnNewPluginClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Add from folder…" Click="OnImportPluginClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Install from GitHub…" Tag="install" Click="OnInstallPluginPackageClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Update from GitHub…" Tag="update" Click="OnInstallPluginPackageClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="PluginsList" Spacing="8" AutomationProperties.Name="Your plugins" />

                        <!-- Empty state: three ways to start, then what a plugin can hold. -->
                        <StackPanel x:Name="PluginsEmpty" Visibility="Collapsed" Spacing="24">
                            <Grid x:Name="PluginStartCards" ColumnSpacing="12" RowSpacing="12">
                                <Button Click="OnNewPluginClick" Style="{StaticResource PluginStartCardStyle}"
                                        AutomationProperties.Name="Start a plugin from scratch">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource PluginStartIconStyle}">
                                            <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{StaticResource RuAccentBrush}" />
                                        </Border>
                                        <TextBlock Text="Start from scratch" Style="{StaticResource PluginStartTitleStyle}" />
                                        <TextBlock Style="{StaticResource PluginStartBodyStyle}"
                                                   Text="Make a plugin folder with an example skill and instructions, then edit it." />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnAskRuForPluginClick" Style="{StaticResource PluginStartCardStyle}"
                                        AutomationProperties.Name="Ask Ru to build a plugin">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource PluginStartIconStyle}">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="{StaticResource RuAccentBrush}" />
                                        </Border>
                                        <TextBlock Text="Ask Ru to build it" Style="{StaticResource PluginStartTitleStyle}" />
                                        <TextBlock Style="{StaticResource PluginStartBodyStyle}"
                                                   Text="Describe it in chat. Ru writes a draft in your project that you add from a folder." />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnInstallPluginPackageClick" Tag="install" Style="{StaticResource PluginStartCardStyle}"
                                        AutomationProperties.Name="Install a plugin from GitHub">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource PluginStartIconStyle}">
                                            <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource RuAccentBrush}" />
                                        </Border>
                                        <TextBlock Text="Install from GitHub" Style="{StaticResource PluginStartTitleStyle}" />
                                        <TextBlock Style="{StaticResource PluginStartBodyStyle}"
                                                   Text="Paste a plugin folder URL pinned to a commit. Nothing runs while installing." />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Spacing="12">
                                <TextBlock Text="What a plugin can hold" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                                <Grid x:Name="PluginPartCards" ColumnSpacing="12" RowSpacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{StaticResource RuMutedBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Skills" Style="{StaticResource PluginStartTitleStyle}" FontSize="13" />
                                            <TextBlock Style="{StaticResource PluginStartBodyStyle}" Text="Workflows Ru loads when they help." />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{StaticResource RuMutedBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Instructions" Style="{StaticResource PluginStartTitleStyle}" FontSize="13" />
                                            <TextBlock Style="{StaticResource PluginStartBodyStyle}" Text="Rules Ru follows in every message." />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE945;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{StaticResource RuMutedBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Hooks" Style="{StaticResource PluginStartTitleStyle}" FontSize="13" />
                                            <TextBlock Style="{StaticResource PluginStartBodyStyle}" Text="Commands around tool calls. Ru asks before they run." />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE968;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{StaticResource RuMutedBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="MCP servers" Style="{StaticResource PluginStartTitleStyle}" FontSize="13" />
                                            <TextBlock Style="{StaticResource PluginStartBodyStyle}" Text="Extra tools. Ru asks before they start." />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <HyperlinkButton Content="Already have a draft folder? Add it from a folder" Padding="0"
                                                 Click="OnImportPluginClick" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="PluginsSkippedText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource RuWarningBrush}" IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Built in" FontFamily="{StaticResource RuUiFontFamily}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                            <TextBlock FontFamily="{StaticResource RuUiFontFamily}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource RuMutedBrush}" Text="Abilities that ship with Ru." />
                        </StackPanel>
                        <Border Style="{StaticResource FluentCardStyle}" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top"
                                        CornerRadius="{StaticResource AppControlCornerRadius}"
                                        Background="{StaticResource RuSurfaceBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{StaticResource RuMutedBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Computer use" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap"
                                               Text="Lets Ru see your screen and use apps you approve, for new turns with an image-capable model. Press Ctrl+Alt+Backspace (or Ctrl+Alt+Pause) to stop it." />
                                </StackPanel>
                                <ToggleSwitch x:Name="ComputerUseToggle" Grid.Column="2" VerticalAlignment="Center"
                                              OnContent="" OffContent="" MinWidth="0"
                                              Toggled="OnComputerUseToggled"
                                              AutomationProperties.Name="Computer use" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- The user's own instruction files: one card per scope. Guidance only:
                 they shape style and workflow and never grant permission. -->
            <ScrollViewer x:Name="InstructionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="4,4,12,24">
                    <StackPanel Spacing="8">
                        <TextBlock FontFamily="{StaticResource RuUiFontFamily}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource RuInkBrush}"
                                   Text="Tell Ru how you like to work: language, tools, conventions, things to avoid. Changes apply from your next message." />
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    ToolTipService.ToolTip="Instructions shape how Ru works. What it may run is still decided by your permission preset and approvals.">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource RuMutedBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuMutedBrush}"
                                       Text="Guidance, never permission." />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource FluentCardStyle}" Padding="20,16,20,16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="32" Height="32" CornerRadius="{StaticResource AppControlCornerRadius}"
                                        Background="{StaticResource RuSurfaceBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource RuMutedBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="All projects" FontFamily="{StaticResource RuUiFontFamily}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                                    <TextBlock x:Name="GlobalInstructionsPath" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12"
                                               Foreground="{StaticResource RuMutedBrush}" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Border x:Name="GlobalInstructionsBadge" Grid.Column="2" VerticalAlignment="Center" Padding="8,2"
                                        CornerRadius="{StaticResource AppControlCornerRadius}" Background="{StaticResource RuSurfaceBrush}">
                                    <TextBlock x:Name="GlobalInstructionsBadgeText" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11.5"
                                               Foreground="{StaticResource RuMutedBrush}" />
                                </Border>
                            </Grid>
                            <TextBox x:Name="GlobalInstructionsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="120" MaxHeight="360"
                                     FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="e.g. Reply in Vietnamese. Prefer pytest for Python tests. Never commit unless I ask."
                                     TextChanged="OnInstructionsTextChanged" KeyDown="OnInstructionsKeyDown" Tag="global"
                                     AutomationProperties.Name="Instructions for all projects" />
                            <Grid x:Name="GlobalInstructionsBoxFooter" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock x:Name="GlobalInstructionsStatus" VerticalAlignment="Center" FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="12" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" />
                                <Button x:Name="GlobalInstructionsRevert" Grid.Column="1" Content="Discard" Tag="global" IsEnabled="False"
                                        Click="OnInstructionsRevertClick" Style="{StaticResource RuToolbarButtonStyle}" Padding="12,6"
                                        ToolTipService.ToolTip="Go back to the saved file"
                                        AutomationProperties.Name="Discard changes to all projects instructions" />
                                <Button x:Name="GlobalInstructionsSave" Grid.Column="2" Content="Save" Tag="global" IsEnabled="False"
                                        Click="OnInstructionsSaveClick" Style="{StaticResource RuPrimaryButtonStyle}" Padding="16,6"
                                        ToolTipService.ToolTip="Save (Ctrl+S)"
                                        AutomationProperties.Name="Save all projects instructions" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FluentCardStyle}" Padding="20,16,20,16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="32" Height="32" CornerRadius="{StaticResource AppControlCornerRadius}"
                                        Background="{StaticResource RuSurfaceBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource RuMutedBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="This workspace" FontFamily="{StaticResource RuUiFontFamily}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" />
                                    <TextBlock x:Name="WorkspaceInstructionsPath" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12"
                                               Foreground="{StaticResource RuMutedBrush}" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Border x:Name="WorkspaceInstructionsBadge" Grid.Column="2" VerticalAlignment="Center" Padding="8,2"
                                        CornerRadius="{StaticResource AppControlCornerRadius}" Background="{StaticResource RuSurfaceBrush}">
                                    <TextBlock x:Name="WorkspaceInstructionsBadgeText" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11.5"
                                               Foreground="{StaticResource RuMutedBrush}" />
                                </Border>
                            </Grid>
                            <!-- Without a workspace there is nothing to edit: a short note
                                 replaces the editor instead of a dead text box. -->
                            <TextBlock x:Name="WorkspaceInstructionsEmpty" Visibility="Collapsed" Margin="44,0,0,0"
                                       FontFamily="{StaticResource RuUiFontFamily}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       Text="Open a session in a project folder to add rules that apply to that project only." />
                            <TextBox x:Name="WorkspaceInstructionsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="120" MaxHeight="360"
                                     FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Rules for this project only. Read after the ones above, so they win where both disagree."
                                     TextChanged="OnInstructionsTextChanged" KeyDown="OnInstructionsKeyDown" Tag="workspace"
                                     AutomationProperties.Name="Instructions for this workspace" />
                            <Grid x:Name="WorkspaceInstructionsBoxFooter" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock x:Name="WorkspaceInstructionsStatus" VerticalAlignment="Center" FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="12" Foreground="{StaticResource RuMutedBrush}" TextWrapping="Wrap" />
                                <Button x:Name="WorkspaceInstructionsRevert" Grid.Column="1" Content="Discard" Tag="workspace" IsEnabled="False"
                                        Click="OnInstructionsRevertClick" Style="{StaticResource RuToolbarButtonStyle}" Padding="12,6"
                                        ToolTipService.ToolTip="Go back to the saved file"
                                        AutomationProperties.Name="Discard changes to this workspace instructions" />
                                <Button x:Name="WorkspaceInstructionsSave" Grid.Column="2" Content="Save" Tag="workspace" IsEnabled="False"
                                        Click="OnInstructionsSaveClick" Style="{StaticResource RuPrimaryButtonStyle}" Padding="16,6"
                                        ToolTipService.ToolTip="Save (Ctrl+S)"
                                        AutomationProperties.Name="Save this workspace instructions" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- The project's shared files, read too but edited in the project itself. -->
                    <StackPanel x:Name="WorkspaceOtherSourcesPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Also read from this project" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource RuMutedBrush}" />
                        <StackPanel x:Name="WorkspaceOtherSources" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12.5" Foreground="{StaticResource RuMutedBrush}"
                   TextWrapping="Wrap" MaxLines="4" Visibility="Collapsed" IsTextSelectionEnabled="True"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
