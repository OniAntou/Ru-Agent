<UserControl
    x:Class="RuApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:RuApp.Views"
    xmlns:models="using:RuApp.Models"
    xmlns:viewmodels="using:RuApp.ViewModels"
    mc:Ignorable="d" IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDescStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SidebarCategoryHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Margin" Value="8,16,8,4" />
            </Style>

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource RuMutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuLineBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main 2-Column Settings Modal Container -->
    <Grid x:Name="SettingsLayout" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition x:Name="SettingsNavigationColumn" Width="200" />
            <!-- Right Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN: SIDEBAR ==================== -->
        <Border x:Name="SettingsNavigation" Grid.Column="0" Grid.RowSpan="2"
                Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="12,16,12,16">
                <StackPanel x:Name="SettingsNavigationButtons" Spacing="4">
                    <TextBlock x:Name="SettingsNavigationHeading" Text="Settings" Style="{StaticResource SidebarCategoryHeadingStyle}" Margin="8,0,8,6" />
                    <!-- General Tab Button -->
                    <Button x:Name="NavGeneralBtn"
                            Content="General"
                            AutomationProperties.Name="General settings"
                            Click="OnNavGeneralClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <!-- Models / AI Providers Tab Button -->
                    <Button x:Name="NavModelsBtn"
                            Content="Models &amp; Providers"
                            AutomationProperties.Name="Models and providers settings"
                            Click="OnNavModelsClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button x:Name="NavRulesBtn"
                            Content="Approval rules"
                            AutomationProperties.Name="Approval rules"
                            Click="OnNavRulesClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button x:Name="NavShortcutsBtn"
                            Content="Keyboard shortcuts"
                            AutomationProperties.Name="Keyboard shortcuts"
                            Click="OnNavShortcutsClick"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button x:Name="NavAboutBtn" Content="About"
                            AutomationProperties.Name="About Ru"
                            Click="OnNavAboutClick" Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== RIGHT COLUMN: CONTENT ==================== -->
        <Grid x:Name="SettingsBody" Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource RuSurfaceBrush}" RowDefinitions="Auto,*">
            <!-- Header Bar (Category Title & Subtitle) -->
            <Grid Grid.Row="0" Padding="28,20,56,16" BorderBrush="{StaticResource RuLineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CategoryTitleText"
                               Text="General"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource RuDisplayFontFamily}"
                               Foreground="{StaticResource RuInkBrush}" />
                    <TextBlock x:Name="CategorySubtitleText"
                               Text="Manage application theme and agent defaults."
                               FontSize="12.5"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               Foreground="{StaticResource RuMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Panels Area -->
            <!-- General Settings Panel -->
            <ScrollViewer x:Name="PanelGeneralScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Visible">
                <StackPanel Spacing="16">
                    <!-- Appearance Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <Grid Tag="SettingsRow" ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Appearance" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Choose Light, Dark, Meteor Shower, or Starry Night" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="ThemeButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Appearance theme">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ThemeButtonLabel"
                                                   Text="Dark"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="ThemeDarkOption"
                                                        Tag="dark"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Dark theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeDarkText"
                                                                   Text="Dark"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeDarkCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeLightOption"
                                                        Tag="light"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Light theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeLightText"
                                                                   Text="Light"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeLightCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeDarkMeteorOption"
                                                        Tag="dark-meteor"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Dark Meteor Shower theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeDarkMeteorText"
                                                                   Text="Dark Meteor Shower"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeDarkMeteorCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ThemeStarryNightOption"
                                                        Tag="starry-night"
                                                        Click="OnThemeOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Starry Night theme">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock x:Name="ThemeStarryNightText"
                                                                   Text="Starry Night"
                                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource RuInkBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <FontIcon x:Name="ThemeStarryNightCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                  <!--
                    Conversation Typography Card. No dropdown here: the four
                    sizes sit in the open as live specimens, each set in its
                    own size, so the choice is seen rather than read.
                  -->
                  <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                      <StackPanel Spacing="12">
                          <StackPanel Spacing="2">
                              <TextBlock Text="Message text size" Style="{StaticResource SettingLabelStyle}" />
                              <TextBlock Text="Conversation text size; activity lines stay two steps smaller"
                                         Style="{StaticResource SettingDescStyle}" />
                          </StackPanel>
                          <!-- Four equal columns: the specimens stretch the full
                            width instead of huddling left. -->
                          <Grid x:Name="TranscriptSizeOptionsPanel"
                                ColumnDefinitions="*,*,*,*"
                                ColumnSpacing="8" />
                        </StackPanel>
                    </Border>

                    <!-- Agent Capabilities Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Translation="0,0,4">
                        <StackPanel Spacing="16">
                            <Grid Tag="SettingsRow" ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Permission preset" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Applies to new turns. Full Access asks to confirm before the next one."
                                               Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <Button x:Name="PresetButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Style="{StaticResource RuDropdownButtonStyle}"
                                        AutomationProperties.Name="Permission preset">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="PresetButtonLabel"
                                                   Text="Standard"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Width="260" Spacing="2">
                                                <Button x:Name="PresetPlanOption"
                                                        Tag="plan"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Plan preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock x:Name="PresetPlanText"
                                                                       Text="Plan"
                                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                                       FontSize="12.5"
                                                                       Foreground="{StaticResource RuInkBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="Reads and web run automatically; edits and terminal are refused."
                                                                       Style="{StaticResource SettingDescStyle}" />
                                                        </StackPanel>
                                                        <FontIcon x:Name="PresetPlanCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetStandardOption"
                                                        Tag="standard"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Standard preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock x:Name="PresetStandardText"
                                                                       Text="Standard"
                                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                                       FontSize="12.5"
                                                                       Foreground="{StaticResource RuInkBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="Workspace edits and terminal commands run automatically. External working directories and explicit rules ask."
                                                                       Style="{StaticResource SettingDescStyle}" />
                                                        </StackPanel>
                                                        <FontIcon x:Name="PresetStandardCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="PresetFullAccessOption"
                                                        Tag="full_access"
                                                        Click="OnPresetOptionClick"
                                                        Style="{StaticResource RuDropdownItemButtonStyle}"
                                                        AutomationProperties.Name="Full Access preset">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock x:Name="PresetFullAccessText"
                                                                       Text="Full Access"
                                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                                       FontSize="12.5"
                                                                       Foreground="{StaticResource RuInkBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="Skips approval prompts; terminal runs as your Windows user."
                                                                       Style="{StaticResource SettingDescStyle}" />
                                                        </StackPanel>
                                                        <FontIcon x:Name="PresetFullAccessCheck"
                                                                  Grid.Column="1"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="{StaticResource RuAccentBrush}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Models / Providers Panel -->
            <ScrollViewer x:Name="PanelModelsScrollViewer"
                          Grid.Row="1"
                          Padding="28,20,28,32"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Spacing="24">
                    <StackPanel x:Name="ProviderOverview" Spacing="24"
                                Visibility="{x:Bind ViewModel.IsProviderOverviewVisible, Mode=OneWay}">
                        <StackPanel x:Name="ProviderActions" Orientation="Horizontal" Spacing="12">
                                <Button x:Name="ProviderButton"
                                        MinWidth="140"
                                        MinHeight="36"
                                        Padding="16,8" CornerRadius="8"
                                        Style="{StaticResource RuPrimaryButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.IsProviderManagementEnabled, Mode=OneWay}"
                                        AutomationProperties.Name="Add Provider">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ProviderButtonLabel"
                                                   Text="Add Provider"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource RuOnAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE70D;"
                                                  FontSize="9"
                                                  Foreground="{StaticResource RuOnAccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource RuDropdownFlyoutStyle}">
                                            <StackPanel Spacing="0">
                                                <!--
                                                  Search is the way through a ~190-row
                                                  catalog, so it carries the weight: full-width,
                                                  accent icon, hairline under it.
                                                -->
                                                <Grid ColumnDefinitions="Auto,*" Margin="12,12,12,8">
                                                    <FontIcon Glyph="&#xE721;"
                                                              FontSize="14"
                                                              Foreground="{StaticResource RuMutedBrush}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <TextBox x:Name="ProviderSearchBox"
                                                             Grid.Column="1"
                                                             AutomationProperties.Name="Search providers"
                                                             PlaceholderText="Search providers"
                                                             Text="{x:Bind ViewModel.ProviderFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="{StaticResource RuUiFontFamily}"
                                                             FontSize="13"
                                                             MinHeight="0"
                                                             Padding="0"
                                                             Margin="0"
                                                             VerticalAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             IsSpellCheckEnabled="False"
                                                             Foreground="{StaticResource RuInkBrush}">
                                                        <TextBox.Resources>
                                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                            <Thickness x:Key="TextControlThemePadding">0</Thickness>
                                                        </TextBox.Resources>
                                                    </TextBox>
                                                </Grid>
                                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.5" />
                                                <!--
                                                  Small, letter-spaced, muted: a section label
                                                  that names the list and then gets out of the
                                                  way. It carries the count because the count is
                                                  what tells the user this is a search box and
                                                  not a short list still loading.
                                                -->
                                                <TextBlock x:Name="FixedProvidersHeader"
                                                           Text="{x:Bind ViewModel.ProviderHeaderText, Mode=OneWay}"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           CharacterSpacing="80"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           Margin="12,8,12,4" />
                                                <Grid>
                                                    <!--
                                                      The catalog is ~190 rows. They go through a
                                                      ListView so the list is virtualized: only the
                                                      visible rows become UI elements. Building a
                                                      Button per provider in a StackPanel threw
                                                      0x800F1000 partway through the catalog and the
                                                      picker silently stopped in the C's.
                                                      VerticalAlignment is Top and the height comes
                                                      from the code-behind: a ListView measured by an
                                                      unbounded parent never virtualizes.
                                                    -->
                                                    <ListView x:Name="ProviderListView"
                                                              VerticalAlignment="Top"
                                                              MaxHeight="200"
                                                              SelectionMode="None"
                                                              IsItemClickEnabled="True"
                                                              ItemsSource="{x:Bind ViewModel.CatalogProviderRows}"
                                                              ItemClick="OnProviderRowClicked"
                                                              Padding="0,0,0,6"
                                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListView.Resources>
                                                            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuMutedColor}" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                                                            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                                                            <x:Double x:Key="ScrollBarSize">8</x:Double>
                                                        </ListView.Resources>
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0" />
                                                                <Setter Property="MinHeight" Value="0" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ProviderRow">
                                                                <!--
                                                                  Row rhythm: a 32px line gives a long list a
                                                                  comfortable scanning cadence, and the 14px
                                                                  inset matches the header above so the first
                                                                  character of every name lines up with the
                                                                  section label over it, which is why nothing
                                                                  sits to the left of the label. The key dot
                                                                  lives in the trailing cluster instead: as a
                                                                  leading column it pushed labelled rows 16px
                                                                  right of unlabelled ones and broke the edge.
                                                                -->
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      MinHeight="32"
                                                                      Padding="12,0,8,0"
                                                                      Visibility="{x:Bind RowVisibility, Mode=OneWay}">
                                                                     <TextBlock Text="{x:Bind DisplayName}"
                                                                               FontFamily="{StaticResource RuUiFontFamily}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource RuInkBrush}"
                                                                               FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8"
                                                                                VerticalAlignment="Center">
                                                                        <Ellipse Width="6" Height="6"
                                                                                 Fill="{StaticResource RuSuccessBrush}"
                                                                                 Visibility="{x:Bind KeyDotVisibility, Mode=OneWay}"
                                                                                 AutomationProperties.Name="Key stored" />
                                                                        <FontIcon Glyph="&#xE73E;"
                                                                                  FontSize="11.5"
                                                                                  Foreground="{StaticResource RuInkBrush}"
                                                                                  Visibility="{x:Bind CheckVisibility, Mode=OneWay}"
                                                                                  AutomationProperties.Name="Selected provider" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                     <TextBlock x:Name="ProviderNoMatchText"
                                                               Text="No provider matches"
                                                               FontFamily="{StaticResource RuUiFontFamily}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource RuMutedBrush}"
                                                               Margin="12,8,12,12"
                                                               Visibility="{x:Bind ViewModel.HasNoProviderMatches, Mode=OneWay}" />
                                                 </Grid>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            <Button x:Name="AddCustomProviderButton" Content="Add custom Provider"
                                    Command="{x:Bind ViewModel.AddCustomProviderCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProviderManagementEnabled, Mode=OneWay}"
                                    MinHeight="36" Padding="16,8" CornerRadius="8"
                                    AutomationProperties.Name="Add custom Provider" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                     AutomationProperties.Name="Loading providers" />
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasProviderOverviewMessage, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ProviderOverviewMessage, Mode=OneWay}"
                                       Style="{StaticResource SettingDescStyle}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Content="Retry" Command="{x:Bind ViewModel.ReloadProvidersCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProviderManagementEnabled, Mode=OneWay}"
                                    Style="{StaticResource RuToolbarButtonStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Your providers" Style="{StaticResource SettingLabelStyle}" />
                            <Border x:Name="ProvidersEmptyState" Padding="20" BorderThickness="1"
                                    BorderBrush="{StaticResource RuLineBrush}" CornerRadius="12"
                                    Visibility="{x:Bind ViewModel.HasNoConfiguredProviders, Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="No providers added yet" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Add a provider to connect its models, or use a custom OpenAI-compatible server."
                                               Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="ConfiguredProvidersList" ItemsSource="{x:Bind ViewModel.ConfiguredProviders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ConfiguredProviderRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,14"
                                              Background="{StaticResource RuCanvasBrush}" CornerRadius="12">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{x:Bind DisplayName}" FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Padding="5,1" CornerRadius="3" BorderThickness="1"
                                                            BorderBrush="{StaticResource RuLineBrush}" Visibility="{x:Bind IsCustom}">
                                                        <TextBlock Text="Custom" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="{StaticResource RuMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit" Tag="{x:Bind Choice}" Click="OnEditProviderClick"
                                                    Padding="12,5" CornerRadius="6" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind EditAutomationName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="Keys stay in Windows Credential Manager. Choose a model from the chat composer after connecting."
                                   Style="{StaticResource SettingDescStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="ProviderEditor" Spacing="24"
                                Visibility="{x:Bind ViewModel.IsProviderEditorOpen, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Button x:Name="ProviderBackButton" Content="Back" Command="{x:Bind ViewModel.ReturnToProvidersCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsProviderNavigationEnabled, Mode=OneWay}"
                                    Style="{StaticResource RuToolbarButtonStyle}" AutomationProperties.Name="Back to providers" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProviderButtonText, Mode=OneWay}" FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel Spacing="16">
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsLegacyProviderVisible, Mode=OneWay}">
                                <TextBlock Text="This existing provider configuration is preserved. To enter a new key, use Add Provider and choose it from the catalog."
                                           Style="{StaticResource SettingDescStyle}" />
                                <Button Content="Remove saved key" Command="{x:Bind ViewModel.SignOutCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsSignOutEnabled, Mode=OneWay}" />
                            </StackPanel>
                            <!-- Provider API key row: the key comes before the test. -->
                            <StackPanel x:Name="ModelsDevApiKeyRow" Spacing="16" Visibility="{x:Bind ViewModel.IsModelsDevKeyVisible, Mode=OneWay}">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid Tag="SettingsRow" ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="ModelsDevApiKeyLabel" Text="{x:Bind ViewModel.ModelsDevKeyLabel, Mode=OneWay}" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="Stored in Windows Credential Manager; saving is automatic." Style="{StaticResource SettingDescStyle}" />
                                        <TextBlock x:Name="ModelsDevKeyStatus"
                                                   Text="{x:Bind ViewModel.ModelsDevKeyStatus, Mode=OneWay}"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{x:Bind ToneBrush(ViewModel.ModelsDevKeyStatusTone), Mode=OneWay}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="CloudflareAccountIdBox"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=ModelsDevApiKeyLabel}"
                                                 Text="{x:Bind ViewModel.CloudflareAccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Account ID"
                                                 ToolTipService.ToolTip="Cloudflare dashboard → Account ID (Workers AI)."
                                                 Width="150"
                                                 Height="36"
                                                 CornerRadius="{StaticResource AppControlCornerRadius}"
                                                 Visibility="{x:Bind ViewModel.IsCloudflareAccountVisible, Mode=OneWay}" />
                                        <PasswordBox x:Name="ModelsDevApiKeyBox"
                                                     Password="{x:Bind ViewModel.ModelsDevApiKey, Mode=TwoWay}"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=ModelsDevApiKeyLabel}"
                                                     PlaceholderText="sk-&#x2026;"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource AppControlCornerRadius}"
                                                     PasswordRevealMode="Hidden" />
                                        <Button x:Name="ModelsDevSignOutButton"
                                                Content="Sign out"
                                                Command="{x:Bind ViewModel.SignOutCommand}"
                                                Height="36"
                                                MinWidth="96"
                                                Visibility="{x:Bind ViewModel.IsModelsDevSignOutVisible, Mode=OneWay}"
                                                AutomationProperties.Name="Sign out of the active provider"
                                                CornerRadius="{StaticResource AppControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Custom Endpoint URL Row -->
                            <StackPanel x:Name="CustomEndpointRow" Spacing="16" Visibility="{x:Bind ViewModel.IsCustomProviderVisible, Mode=OneWay}">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid Tag="SettingsRow" ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomServerUrlLabel" Text="Custom Server URL" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="OpenAI-compatible endpoint URL" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="CustomEndpointUrlBox"
                                             Grid.Column="1"
                                             AutomationProperties.LabeledBy="{Binding ElementName=CustomServerUrlLabel}"
                                             Text="{x:Bind ViewModel.CustomUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="http://localhost:8000/v1"
                                             Width="260"
                                             Height="36"
                                             CornerRadius="{StaticResource AppControlCornerRadius}" />
                                </Grid>
                            </StackPanel>

                            <!-- Custom API Key Row -->
                            <StackPanel x:Name="CustomApiKeyRow" Spacing="16" Visibility="{x:Bind ViewModel.IsCustomProviderVisible, Mode=OneWay}">
                                <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                                <Grid Tag="SettingsRow" ColumnDefinitions="*,Auto" MinHeight="44">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock x:Name="CustomApiKeyLabel" Text="Custom API Key" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="API key stored securely in Credential Manager" Style="{StaticResource SettingDescStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <PasswordBox x:Name="CustomApiKeyBox"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=CustomApiKeyLabel}"
                                                     Password="{x:Bind ViewModel.CustomApiKey, Mode=TwoWay}"
                                                     PlaceholderText="{x:Bind ViewModel.CustomApiKeyPlaceholder, Mode=OneWay}"
                                                     Width="260"
                                                     Height="36"
                                                     CornerRadius="{StaticResource AppControlCornerRadius}"
                                                     PasswordRevealMode="Hidden" />
                                        <Button x:Name="CustomSignOutButton"
                                                Visibility="{x:Bind ViewModel.IsCustomSignOutVisible, Mode=OneWay}"
                                                Content="Remove key"
                                                Command="{x:Bind ViewModel.RemoveProviderCommand}"
                                                CommandParameter="custom"
                                                Height="36"
                                                MinWidth="96"
                                                AutomationProperties.AutomationId="SignOutProviderCustom"
                                                CornerRadius="{StaticResource AppControlCornerRadius}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!--
                              A stored key is not a working key; this asks the endpoint.
                              The status sits in the same grid so it reads as the result
                              of the button beside it.
                            -->
                            <Grid Tag="SettingsRow" ColumnDefinitions="*,Auto" MinHeight="44">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Connection" Style="{StaticResource SettingLabelStyle}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <FontIcon x:Name="ProviderTestStatusIcon"
                                                  Glyph="{x:Bind ToneGlyph(ViewModel.ProviderTestTone), Mode=OneWay}"
                                                  FontSize="12"
                                                  Foreground="{x:Bind ToneBrush(ViewModel.ProviderTestTone), Mode=OneWay}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:Name="ProviderTestStatusText"
                                                   Grid.Column="1"
                                                   Text="{x:Bind ViewModel.ProviderTestMessage, Mode=OneWay}"
                                                   Foreground="{x:Bind ToneBrush(ViewModel.ProviderTestTone), Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.ProviderTestErrorCode, Mode=OneWay}"
                                                   Style="{StaticResource SettingDescStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="ProviderTestButton"
                                        Grid.Column="1"
                                        Width="260"
                                        MinHeight="36"
                                        Content="Test connection"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource RuPrimaryButtonStyle}"
                                        AutomationProperties.Name="Test provider connection"
                                        Command="{x:Bind ViewModel.TestConnectionCommand}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" />
                            <TextBlock Text="Keys are stored in Windows Credential Manager and sent only to the provider you choose."
                                       Style="{StaticResource SettingDescStyle}"
                                       TextWrapping="Wrap" />

                            </StackPanel>
                        </Border>
                        <TextBlock Text="Changes save automatically. This provider will be used for new runs; choose its model in chat."
                                   Style="{StaticResource SettingDescStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- Approval rules: what "Always allow" remembered, and the way to forget it. -->
            <ScrollViewer x:Name="PanelRulesScrollViewer" Grid.Row="1"
                          Padding="28,20,28,32" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="Remembered approvals" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Rules saved with Always allow on an approval card. Removing one makes Ru ask again."
                                               Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="RulesRefreshButton"
                                        Grid.Column="1"
                                        Content="Refresh"
                                        Click="OnRulesRefreshClick"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource RuToolbarButtonStyle}"
                                        AutomationProperties.Name="Refresh approval rules" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Rules.IsLoading, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Rules.StatusText, Mode=OneWay}"
                                       Visibility="{x:Bind Rules.HasStatus, Mode=OneWay}"
                                       Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="No remembered rules. Choosing Always allow on an approval card adds one here."
                                       Visibility="{x:Bind Rules.HasNoRules, Mode=OneWay}"
                                       Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" />
                            <ItemsControl x:Name="RulesList" ItemsSource="{x:Bind Rules.Rules}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ApprovalRuleRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                              Padding="12,10"
                                              Background="{StaticResource RuCanvasBrush}"
                                              CornerRadius="{StaticResource AppInsetCornerRadius}"
                                              AutomationProperties.Name="{x:Bind AutomationName}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource RuInkBrush}" />
                                                <TextBlock Text="{x:Bind Detail}"
                                                           Visibility="{x:Bind HasDetail}"
                                                           FontFamily="{StaticResource RuMonoFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ScopeLabel}"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    VerticalAlignment="Center"
                                                    Click="OnRemoveRuleClick"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource RuToolbarButtonStyle}"
                                                    AutomationProperties.Name="Remove this rule" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Keyboard shortcuts: the same list the Ctrl+/ sheet shows. -->
            <ScrollViewer x:Name="PanelShortcutsScrollViewer" Grid.Row="1"
                          Padding="28,20,28,32" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Border Style="{StaticResource FluentCardStyle}">
                    <ContentControl x:Name="ShortcutsListHost" HorizontalContentAlignment="Stretch" />
                </Border>
            </ScrollViewer>

            <ScrollViewer x:Name="PanelAboutScrollViewer" Grid.Row="1"
                          Padding="28,20,28,32" Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Ru Agent" FontSize="22" FontWeight="SemiBold"
                                       FontFamily="{StaticResource RuDisplayFontFamily}" Foreground="{StaticResource RuInkBrush}" />
                            <TextBlock Text="Windows coding agent" Style="{StaticResource SettingDescStyle}" />
                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="AboutBuildText" Style="{StaticResource SettingDescStyle}" />
                            <TextBlock x:Name="AboutPlatformText" Style="{StaticResource SettingDescStyle}" />
                            <HyperlinkButton Content="GitHub · OniAntou/Ru-Agent"
                                             NavigateUri="https://github.com/OniAntou/Ru-Agent"
                                             HorizontalAlignment="Left" Padding="0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Updates" Style="{StaticResource SettingLabelStyle}" />
                            <ComboBox x:Name="UpdateChannelCombo" Header="Release channel" SelectedIndex="0"
                                      SelectionChanged="OnUpdateChannelChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Stable" />
                                <ComboBoxItem Content="Preview — includes early releases" />
                            </ComboBox>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Style="{StaticResource SettingDescStyle}" />
                            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="OnCheckUpdatesClick" />
                                <Button x:Name="InstallUpdateButton" Content="Install and restart" IsEnabled="False" Click="OnInstallUpdateClick" />
                                <Button x:Name="CancelUpdateButton" Content="Cancel" Visibility="Collapsed" Click="OnCancelUpdateClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
