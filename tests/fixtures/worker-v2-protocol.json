{
  "protocol_version": 2,
  "valid_envelopes": [
    {
      "name": "hello",
      "envelope": {
        "v": 2,
        "id": "conn-1",
        "type": "hello",
        "payload": { "token": "worker-secret" }
      }
    },
    {
      "name": "hello_ok",
      "envelope": {
        "v": 2,
        "id": "conn-1",
        "type": "hello.ok",
        "seq": 0,
        "payload": { "version": 2, "capabilities": ["agent.step"] }
      }
    },
    {
      "name": "step_start",
      "envelope": {
        "v": 2,
        "id": "step-1",
        "type": "agent.step.start",
        "correlation_id": "corr-1",
        "payload": {
          "prompt": "Đọc README",
          "turns": [],
          "memory_context": null,
          "settings": {
            "max_tokens": 128,
            "temperature": 0.4,
            "top_k": 20,
            "allow_web_search": false,
            "model_tools": [
              {
                "tool_id": "files.read",
                "tool_version": "1.0.0",
                "scopes": ["workspace.read"],
                "availability": "executable",
                "model_enabled": true,
                "capability_class": "tool",
                "verification_required": false,
                "hint": "{\"path\":\"README.md\"}",
                "input_schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "path": { "type": "string" } },
                  "required": ["path"]
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "step_delta",
      "envelope": {
        "v": 2,
        "id": "step-1",
        "type": "agent.step.delta",
        "seq": 1,
        "correlation_id": "corr-1",
        "payload": { "text": "Em đang đọc." }
      }
    },
    {
      "name": "step_done_tool_call",
      "envelope": {
        "v": 2,
        "id": "step-1",
        "type": "agent.step.done",
        "seq": 1,
        "correlation_id": "corr-1",
        "payload": {
          "text": null,
          "tool_calls": [
            {
              "provider_call_id": null,
              "tool_id": "files.read",
              "tool_version": "1.0.0",
              "arguments": { "path": "README.md" }
            }
          ],
          "finish_reason": "tool_calls"
        }
      }
    },
    {
      "name": "step_cancel",
      "envelope": {
        "v": 2,
        "id": "step-1",
        "type": "agent.step.cancel",
        "payload": {}
      }
    },
    {
      "name": "error",
      "envelope": {
        "v": 2,
        "id": "step-1",
        "type": "error",
        "seq": 1,
        "correlation_id": "corr-1",
        "payload": { "code": "provider_timeout", "retryable": true }
      }
    }
  ],
  "invalid_raw_envelopes": [
    {
      "name": "wrong_version",
      "code": "unsupported_version",
      "json": "{\"v\":1,\"id\":\"step-1\",\"type\":\"agent.step.cancel\",\"payload\":{}}"
    },
    {
      "name": "duplicate_sequence_field",
      "code": "duplicate_field",
      "json": "{\"v\":2,\"id\":\"step-1\",\"type\":\"error\",\"seq\":1,\"seq\":2,\"payload\":{\"code\":\"provider_timeout\",\"retryable\":true}}"
    },
    {
      "name": "v1_tool_result",
      "code": "unsupported_message",
      "json": "{\"v\":2,\"id\":\"step-1\",\"type\":\"chat.tool.result\",\"payload\":{}}"
    },
    {
      "name": "terminal_authority_field",
      "code": "invalid_envelope",
      "json": "{\"v\":2,\"id\":\"step-1\",\"type\":\"agent.step.cancel\",\"terminal\":{\"command\":\"git status\"},\"payload\":{}}"
    }
  ]
}
