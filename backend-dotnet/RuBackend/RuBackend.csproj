<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RuAgent.Broker\RuAgent.Broker.csproj" />
    <ProjectReference Include="..\RuAgent.Harness.Core\RuAgent.Harness.Core.csproj" />
    <ProjectReference Include="..\RuAgent.Harness.Persistence\RuAgent.Harness.Persistence.csproj" />
    <ProjectReference Include="..\RuAgent.Hosting\RuAgent.Hosting.csproj" />
    <ProjectReference Include="..\RuAgent.Protocol\RuAgent.Protocol.csproj" />
    <ProjectReference Include="..\RuAgent.Runtime.Adapters\RuAgent.Runtime.Adapters.csproj" />
    <ProjectReference Include="..\RuAgent.Runtime.Worker\RuAgent.Runtime.Worker.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>
  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- Release precompiles the assemblies to native code with crossgen2, so the
         startup path does not pay JIT cost on first use. Debug stays uncompiled to
         keep incremental builds fast. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>
</Project>
