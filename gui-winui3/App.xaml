<Application
    x:Class="RuApp.App"
    RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RuApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Studio Minimalist palette (Clean Light & Comfortable Warm Charcoal Dark) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="RuCanvasColor">#F3F4F6</Color>
                    <Color x:Key="RuSidebarColor">#E9EBF0</Color>
                    <Color x:Key="RuSurfaceColor">#FFFFFF</Color>
                    <Color x:Key="RuInkColor">#181A1F</Color>
                    <Color x:Key="RuMutedColor">#636B78</Color>
                    <Color x:Key="RuLineColor">#D9DDE5</Color>
                    <Color x:Key="RuAccentColor">#B94D36</Color>
                    <Color x:Key="RuAccentSoftColor">#F8ECE8</Color>
                    <Color x:Key="RuSuccessColor">#2E7D5B</Color>
                    <Color x:Key="RuWarningColor">#B27B1E</Color>
                    <Color x:Key="RuDangerColor">#C23D3D</Color>

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#B94D36" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#A13E29" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#89321E" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#B94D36" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#A13E29" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#89321E" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#B94D36" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#A13E29" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#B94D36" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#A13E29" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="RuCanvasColor">#181A1E</Color>
                    <Color x:Key="RuSidebarColor">#131518</Color>
                    <Color x:Key="RuSurfaceColor">#22262D</Color>
                    <Color x:Key="RuInkColor">#EDEFF2</Color>
                    <Color x:Key="RuMutedColor">#9097A6</Color>
                    <Color x:Key="RuLineColor">#313742</Color>
                    <Color x:Key="RuAccentColor">#E07A5F</Color>
                    <Color x:Key="RuAccentSoftColor">#382620</Color>
                    <Color x:Key="RuSuccessColor">#4EAD7B</Color>
                    <Color x:Key="RuWarningColor">#DEAA50</Color>
                    <Color x:Key="RuDangerColor">#E56B6B</Color>

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E07A5F" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#EA8A71" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#F09A83" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#E07A5F" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#EA8A71" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#F09A83" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E07A5F" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#EA8A71" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#E07A5F" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#EA8A71" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters -->
            <converters:ErrorColorConverter x:Key="ErrorColorConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <SolidColorBrush x:Key="RuCanvasBrush" Color="{ThemeResource RuCanvasColor}" />
            <SolidColorBrush x:Key="RuSidebarBrush" Color="{ThemeResource RuSidebarColor}" Opacity="0.90" />
            <SolidColorBrush x:Key="RuSurfaceBrush" Color="{ThemeResource RuSurfaceColor}" />
            <SolidColorBrush x:Key="RuInkBrush" Color="{ThemeResource RuInkColor}" />
            <SolidColorBrush x:Key="RuMutedBrush" Color="{ThemeResource RuMutedColor}" />
            <SolidColorBrush x:Key="RuLineBrush" Color="{ThemeResource RuLineColor}" />
            <SolidColorBrush x:Key="RuAccentBrush" Color="{ThemeResource RuAccentColor}" />
            <SolidColorBrush x:Key="RuAccentSoftBrush" Color="{ThemeResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="RuSuccessBrush" Color="{ThemeResource RuSuccessColor}" />
            <SolidColorBrush x:Key="RuWarningBrush" Color="{ThemeResource RuWarningColor}" />
            <SolidColorBrush x:Key="RuDangerBrush" Color="{ThemeResource RuDangerColor}" />

            <FontFamily x:Key="RuUiFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="RuDisplayFontFamily">Cambria</FontFamily>
            <FontFamily x:Key="RuMonoFontFamily">Consolas</FontFamily>
            <CornerRadius x:Key="RuControlCornerRadius">6</CornerRadius>

            <!-- Legacy resource names remain available to untouched views. -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource RuCanvasColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{ThemeResource RuSidebarColor}" />
            <SolidColorBrush x:Key="AppSidebarBorderBrush" Color="{ThemeResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource RuSurfaceColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="{ThemeResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBorderSubtleBrush" Color="{ThemeResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBorderHighlightBrush" Color="{ThemeResource RuLineColor}" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{ThemeResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="{ThemeResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="AppAccentGlowBrush" Color="{ThemeResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppSecondaryAccentBrush" Color="{ThemeResource RuMutedColor}" />
            <SolidColorBrush x:Key="AppSecondaryAccentSubtleBrush" Color="{ThemeResource RuSidebarColor}" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{ThemeResource RuInkColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{ThemeResource RuMutedColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{ThemeResource RuMutedColor}" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource RuSuccessColor}" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="{ThemeResource RuSidebarColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{ThemeResource RuWarningColor}" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="{ThemeResource RuSidebarColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{ThemeResource RuDangerColor}" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="{ThemeResource RuSidebarColor}" />

            <!-- CornerRadius Design Tokens -->
            <CornerRadius x:Key="AppCardCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="AppPillCornerRadius">6</CornerRadius>

            <!-- Card Border Style -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="24,20" />
            </Style>

            <!-- Smooth Action Button Style -->
            <Style x:Key="ActionCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
