<UserControl
    x:Class="RuApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d">

    <Pivot>
        <PivotItem Header="Cài đặt hệ thống" Margin="0,16,0,0">
            <ScrollViewer Padding="32,0,32,32" Background="Transparent">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <TextBlock Text="Cài đặt hệ thống" FontSize="24" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>

            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Mô hình &amp; Runtime Backend" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="#EAEAEA"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Loại Backend" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <ComboBox x:Name="BackendComboBox" Grid.Column="1" Width="280" SelectionChanged="OnBackendSelectionChanged">
                            <ComboBoxItem Content="Local GGUF (Llama 3.1 8B v6.2)" Tag="gguf"/>
                            <ComboBoxItem Content="Transformers (Fallback HF Checkpoint)" Tag="transformers"/>
                            <ComboBoxItem Content="OpenCode Zen (Cloud API)" Tag="opencode"/>
                            <ComboBoxItem Content="Kilo Gateway (Cloud API)" Tag="kilo"/>
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="ModelRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0" Visibility="Collapsed">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Model Name" Foreground="#DDDDDD"/>
                            <TextBlock x:Name="ModelLoadingText" Text="Đang tải danh sách model từ API..." Foreground="#888888" FontSize="13" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Width="280">
                            <TextBox x:Name="ModelSearchBox" PlaceholderText="Tìm kiếm model..." TextChanged="OnModelSearchBoxTextChanged"/>
                            <ComboBox x:Name="ModelComboBox" Width="280" IsEditable="False"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="OpenCodeApiRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Grid.Column="0" Text="OpenCode API Key" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <PasswordBox x:Name="OpenCodeApiKeyBox" Grid.Column="1" PlaceholderText="sk-opencode-..." Width="280"/>
                    </Grid>

                    <Grid x:Name="ApiVariantRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Grid.Column="0" Text="Reasoning Effort" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <ComboBox x:Name="ApiVariantComboBox" Grid.Column="1" Width="280">
                            <ComboBoxItem Content="Default" Tag="Default"/>
                            <ComboBoxItem Content="Low" Tag="low"/>
                            <ComboBoxItem Content="Medium" Tag="medium"/>
                            <ComboBoxItem Content="High" Tag="high"/>
                            <ComboBoxItem Content="Max" Tag="max"/>
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="KiloApiRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Grid.Column="0" Text="Kilo API Key" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <PasswordBox x:Name="KiloApiKeyBox" Grid.Column="1" PlaceholderText="sk-kilo-..." Width="280"/>
                    </Grid>
                    
                    <Grid x:Name="GeminiVisionRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Gemini Vision API Key (Screen Observation Cloud)" Foreground="#DDDDDD"/>
                            <TextBlock Text="Dùng cho Gemini Live. Lấy key tại aistudio.google.com/apikey" Foreground="#777777" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <PasswordBox x:Name="GeminiVisionKeyBox" Grid.Column="1" PlaceholderText="AIza..." Width="280"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Hồ sơ Checkpoint" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <TextBox x:Name="CheckpointPathBox" Grid.Column="1" PlaceholderText="checkpoints/ru-..." Width="280"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Tham số sinh văn bản (Generation)" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="#EAEAEA"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Temperature (Độ sáng tạo)" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <TextBox x:Name="TemperatureNumberBox" Grid.Column="1" Text="0.7" Width="160" Background="Transparent" BorderThickness="0,0,0,1"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Top-K" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <TextBox x:Name="TopKNumberBox" Grid.Column="1" Text="40" Width="160" Background="Transparent" BorderThickness="0,0,0,1"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Max New Tokens (Độ dài tối đa)" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <TextBox x:Name="MaxTokensNumberBox" Grid.Column="1" Text="512" Width="160" Background="Transparent" BorderThickness="0,0,0,1"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Tính năng mở rộng" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="#EAEAEA"/>

                    <Grid x:Name="OnlineSearchRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Cho phép tìm kiếm Web online" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <ToggleSwitch x:Name="AllowOnlineSearchToggle" Grid.Column="1" IsOn="True"/>
                    </Grid>
                    
                    <Grid x:Name="SelfLearningRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Tự động ghi nhớ fact từ cuộc trò chuyện (Self-Learning)" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <ToggleSwitch x:Name="SelfLearningToggle" Grid.Column="1" IsOn="True"/>
                    </Grid>
                    
                    <Grid x:Name="CloudMemoryRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Grid.Column="0" Text="Cho phép chia sẻ bộ nhớ cục bộ với Cloud Model" VerticalAlignment="Center" Foreground="#DDDDDD"/>
                        <ToggleSwitch x:Name="CloudMemoryConsentToggle" Grid.Column="1" IsOn="False"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="SaveSettingsButton" Click="OnSaveSettingsClick" HorizontalAlignment="Right" Padding="32,12" CornerRadius="8" Background="#20A0C0FF" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="#A0C0FF"/>
                    <TextBlock Text="Lưu cài đặt" FontWeight="Medium" Foreground="#A0C0FF"/>
                </StackPanel>
            </Button>
        </StackPanel>
            </ScrollViewer>
        </PivotItem>
        
        <PivotItem Header="Bộ nhớ" Margin="0,16,0,0">
            <views:MemoryView x:Name="MemoryControl" />
        </PivotItem>
    </Pivot>
</UserControl>