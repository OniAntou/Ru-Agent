                    <!-- ListViewItem Hover & Selected -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E2E8F0" />
