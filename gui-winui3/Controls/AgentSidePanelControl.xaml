<UserControl
    x:Class="RuApp.Controls.AgentSidePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RuApp.Controls"
    xmlns:views="using:RuApp.Views"
    xmlns:models="using:RuApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- The shared toolbar style paints its hover in the canvas colour, which is
             invisible on the panel's own canvas surface; these local styles lift a
             control with the surface colour instead. -->
        <Style x:Key="SidePanelStripButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource RuSurfaceBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource RuLineBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidePanelChipButtonStyle" TargetType="Button">
            <!-- The chip's Border owns hover and active fills, so the chip reads
                 as one block; the buttons inside stay transparent in every state
                 except pressed, which keeps the press feedback local. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource RuLineBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="SidePanelCardRowStyle" TargetType="Button">
            <!-- A summary-card row is one click target: the whole row hovers and
                 opens its details tab, Codex-style. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource RuCanvasBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource RuLineBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- The right side surface in one host: the floating summary card and the
         full-height details panel. The root grid carries no background so the
         empty area stays hit-test transparent to the chat behind it. -->
    <Grid x:Name="SurfaceRoot">

        <Border x:Name="CardHost"
                Width="280"
                Margin="0,16,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{StaticResource RuSurfaceBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppCardCornerRadius}"
                Padding="14,12"
                Visibility="Collapsed"
                AutomationProperties.Name="Session panel">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardSlide" />
            </Border.RenderTransform>
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="CardTitleText"
                               Text="Session"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RuInkBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button x:Name="ExpandButton"
                            Grid.Column="1"
                            Click="OnExpandClick"
                            Style="{StaticResource RuToolbarButtonStyle}"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            ToolTipService.ToolTip="Open details panel"
                            AutomationProperties.Name="Open details panel">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </Grid>

                <!-- The card's rows are the way into the details tabs, Codex-style:
                     the whole row is one click target with a row hover. -->
                <Button x:Name="CardChangesRow"
                        Click="OnCardChangesRowClick"
                        Style="{StaticResource SidePanelCardRowStyle}"
                        ToolTipService.ToolTip="Open changes"
                        AutomationProperties.Name="Open changes panel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <FontIcon Glyph="&#xE70F;"
                                  FontSize="12"
                                  Foreground="{StaticResource RuMutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Changes"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource RuInkBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CardAddedText"
                                       Text="+0"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuSuccessBrush}" />
                            <TextBlock x:Name="CardRemovedText"
                                       Text="−0"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuDangerBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Border Height="1" Background="{StaticResource RuLineBrush}" />

                <Button x:Name="CardSubagentsRow" Click="OnCardSubagentsRowClick"
                        Style="{StaticResource SidePanelCardRowStyle}"
                        ToolTipService.ToolTip="View subagents" AutomationProperties.Name="View subagents">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Subagents" FontSize="12" Foreground="{StaticResource RuInkBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel x:Name="CardSubagentGlyphs" Orientation="Horizontal" Spacing="2" />
                            <TextBlock x:Name="CardSubagentsSummary" Text="No subagents yet" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource RuMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{StaticResource RuLineBrush}" />

                <Button x:Name="CardTasksRow"
                        Click="OnCardTasksRowClick"
                        Style="{StaticResource SidePanelCardRowStyle}"
                        ToolTipService.ToolTip="Open background tasks"
                        AutomationProperties.Name="Open tasks panel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <FontIcon Glyph="&#xE7C4;"
                                  FontSize="12"
                                  Foreground="{StaticResource RuMutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Background tasks"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource RuInkBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <TextBlock x:Name="CardTasksStatusText"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="12"
                           Foreground="{StaticResource RuMutedBrush}"
                           TextWrapping="Wrap" />

                <ScrollViewer MaxHeight="180"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CardTasksList" ItemsSource="{x:Bind Tasks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AgentTaskRow">
                                <StackPanel Margin="6,0,6,8" Spacing="3" ToolTipService.ToolTip="{x:Bind Label}">
                                    <TextBlock Text="{x:Bind Label}"
                                               FontFamily="{StaticResource RuMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind DetailText}"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="11"
                                               Foreground="{StaticResource RuMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid x:Name="PanelHost"
              Visibility="Collapsed"
              Background="{StaticResource RuCanvasBrush}"
              AutomationProperties.Name="Details panel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelSlide" />
            </Grid.RenderTransform>

            <controls:SidebarResizerControl x:Name="PanelResizeGrip"
                                            Width="6"
                                            Margin="-3,0,0,0"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            PointerEntered="OnGripPointerEntered"
                                            PointerExited="OnGripPointerExited"
                                            PointerPressed="OnGripPointerPressed"
                                            PointerMoved="OnGripPointerMoved"
                                            PointerReleased="OnGripPointerReleased" />

            <Border x:Name="PanelDivider"
                    Width="1"
                    HorizontalAlignment="Left"
                    Background="{StaticResource RuLineBrush}"
                    Opacity="0.6" />

            <Grid RowDefinitions="44,*">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2"
                      Margin="14,0,12,0"
                      VerticalAlignment="Center">
                    <ScrollViewer x:Name="TabStripScroll" Grid.Column="0"
                                  Height="28"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel x:Name="ChipStrip" Orientation="Horizontal" Spacing="2">
                    <!-- The chip wrapper is a Border, not the label button: the whole
                         chip is one hover/active surface, so the label and the close
                         control share a single block instead of two fills. -->
                    <Border x:Name="ChangesChip"
                            Tag="Changes"
                            VerticalAlignment="Center"
                            PointerEntered="OnChipPointerEntered"
                            PointerExited="OnChipPointerExited"
                            PointerPressed="OnChipPointerPressed"
                            PointerMoved="OnChipPointerMoved"
                            PointerReleased="OnChipPointerReleased"
                            PointerCaptureLost="OnChipPointerCaptureLost"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="ChangesTabButton"
                                    Click="OnChangesTabClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    ToolTipService.ToolTip="Changes"
                                    AutomationProperties.Name="Changes tab">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                                    <TextBlock x:Name="ChangesTabLabel"
                                               Text="Changes"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ChangesTabCloseButton"
                                    Click="OnChangesTabCloseClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    Width="24"
                                    Padding="0"
                                    ToolTipService.ToolTip="Close Changes"
                                    AutomationProperties.Name="Close Changes tab">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TasksChip"
                            Tag="Tasks"
                            VerticalAlignment="Center"
                            PointerEntered="OnChipPointerEntered"
                            PointerExited="OnChipPointerExited"
                            PointerPressed="OnChipPointerPressed"
                            PointerMoved="OnChipPointerMoved"
                            PointerReleased="OnChipPointerReleased"
                            PointerCaptureLost="OnChipPointerCaptureLost"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="TasksTabButton"
                                    Click="OnTasksTabClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    ToolTipService.ToolTip="Background tasks"
                                    AutomationProperties.Name="Background tasks tab">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7C4;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                                    <TextBlock x:Name="TasksTabLabel"
                                               Text="Background tasks"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TasksTabCloseButton"
                                    Click="OnTasksTabCloseClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    Width="24"
                                    Padding="0"
                                    ToolTipService.ToolTip="Close Background tasks"
                                    AutomationProperties.Name="Close Tasks tab">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SubagentsChip"
                            Tag="Subagents"
                            VerticalAlignment="Center"
                            PointerEntered="OnChipPointerEntered"
                            PointerExited="OnChipPointerExited"
                            PointerPressed="OnChipPointerPressed"
                            PointerMoved="OnChipPointerMoved"
                            PointerReleased="OnChipPointerReleased"
                            PointerCaptureLost="OnChipPointerCaptureLost"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="SubagentsTabButton"
                                    Click="OnSubagentsTabClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    ToolTipService.ToolTip="Subagents"
                                    AutomationProperties.Name="Subagents tab">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                                    <TextBlock x:Name="SubagentsTabLabel"
                                               Text="Subagents"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SubagentsTabCloseButton"
                                    Click="OnSubagentsTabCloseClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    Width="24"
                                    Padding="0"
                                    ToolTipService.ToolTip="Close Subagents"
                                    AutomationProperties.Name="Close Subagents tab">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FilesChip"
                            Tag="Files"
                            VerticalAlignment="Center"
                            PointerEntered="OnChipPointerEntered"
                            PointerExited="OnChipPointerExited"
                            PointerPressed="OnChipPointerPressed"
                            PointerMoved="OnChipPointerMoved"
                            PointerReleased="OnChipPointerReleased"
                            PointerCaptureLost="OnChipPointerCaptureLost"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="FilesTabButton"
                                    Click="OnFilesTabClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    ToolTipService.ToolTip="Files"
                                    AutomationProperties.Name="Files tab">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                                    <TextBlock x:Name="FilesTabLabel"
                                               Text="Files"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilesTabCloseButton"
                                    Click="OnFilesTabCloseClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    Width="24"
                                    Padding="0"
                                    ToolTipService.ToolTip="Close Files"
                                    AutomationProperties.Name="Close Files tab">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TerminalChip"
                            Tag="Terminal"
                            VerticalAlignment="Center"
                            PointerEntered="OnChipPointerEntered"
                            PointerExited="OnChipPointerExited"
                            PointerPressed="OnChipPointerPressed"
                            PointerMoved="OnChipPointerMoved"
                            PointerReleased="OnChipPointerReleased"
                            PointerCaptureLost="OnChipPointerCaptureLost"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="TerminalTabButton"
                                    Click="OnTerminalTabClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    ToolTipService.ToolTip="Terminal"
                                    AutomationProperties.Name="Terminal tab">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- The terminal's mark is the prompt itself, set in the app's
                                         mono font: two strokes that match the folder and pencil
                                         line weight instead of the boxed CommandPrompt glyph. -->
                                    <TextBlock Text="&gt;_"
                                               Width="18"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource RuMonoFontFamily}"
                                               FontSize="13"
                                               Foreground="{StaticResource RuMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TerminalTabLabel"
                                               Text="Terminal"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TerminalTabCloseButton"
                                    Click="OnTerminalTabCloseClick"
                                    Style="{StaticResource SidePanelChipButtonStyle}"
                                    Width="24"
                                    Padding="0"
                                    ToolTipService.ToolTip="Close Terminal"
                                    AutomationProperties.Name="Close Terminal tab">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="AddTabButton"
                            Grid.Column="1"
                            Style="{StaticResource SidePanelStripButtonStyle}"
                            Width="28"
                            Padding="0"
                            ToolTipService.ToolTip="Open panel tab"
                            AutomationProperties.Name="Open panel tab">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Files" Tag="Files" Click="OnOpenPanelTabClick" AutomationProperties.Name="Open Files tab" />
                                <MenuFlyoutItem Text="Changes" Tag="Changes" Click="OnOpenPanelTabClick" AutomationProperties.Name="Open Changes tab" />
                                <MenuFlyoutItem Text="Background tasks" Tag="Tasks" Click="OnOpenPanelTabClick" AutomationProperties.Name="Open Background tasks tab" />
                                <MenuFlyoutItem Text="Subagents" Tag="Subagents" Click="OnOpenPanelTabClick" AutomationProperties.Name="Open Subagents tab" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Terminal" Tag="Terminal" Click="OnOpenPanelTabClick" AutomationProperties.Name="Open Terminal tab" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>

                    <Button x:Name="FullscreenButton"
                            Grid.Column="2"
                            Click="OnFullscreenClick"
                            Style="{StaticResource SidePanelStripButtonStyle}"
                            Width="28"
                            Padding="0"
                            ToolTipService.ToolTip="Fullscreen panel"
                            AutomationProperties.Name="Fullscreen panel">
                        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>

                    <Button x:Name="CollapseButton"
                            Grid.Column="3"
                            Click="OnCollapseClick"
                            Style="{StaticResource SidePanelStripButtonStyle}"
                            Width="28"
                            Padding="0"
                            ToolTipService.ToolTip="Collapse to summary"
                            AutomationProperties.Name="Collapse side panel">
                        <Viewbox Width="14" Height="14">
                            <Path Data="M4.5,3.5 H11.5 A2,2 0 0 1 13.5,5.5 V10.5 A2,2 0 0 1 11.5,12.5 H4.5 A2,2 0 0 1 2.5,10.5 V5.5 A2,2 0 0 1 4.5,3.5 Z M10.5,3.5 V12.5"
                                  Stroke="{StaticResource RuMutedBrush}"
                                  StrokeThickness="1.2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </Grid>

                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{StaticResource RuLineBrush}"
                        Opacity="0.7" />

                <Grid Grid.Row="1" Margin="14,10,12,0">
                    <views:SubagentTreeView x:Name="SubagentBrowser" Visibility="Collapsed" />
                    <Grid x:Name="ChangesBody" Visibility="Collapsed" RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Text="Changes"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PanelAddedText"
                                       Grid.Column="1"
                                       Text="+0"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuSuccessBrush}" />
                            <TextBlock x:Name="PanelRemovedText"
                                       Grid.Column="2"
                                       Text="−0"
                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuDangerBrush}" />
                        </Grid>

                        <TextBlock x:Name="ChangesEmptyText"
                                   Grid.Row="1"
                                   Text="No changes yet."
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ChangesList" ItemsSource="{x:Bind Changes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChangesTabRow">
                                        <StackPanel Margin="0,0,0,6">
                                            <Button Click="OnChangeRowToggleClick"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource RuToolbarButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    CornerRadius="{StaticResource AppControlCornerRadius}"
                                                    Padding="6,3"
                                                    ToolTipService.ToolTip="{x:Bind FileName}"
                                                    AutomationProperties.Name="Toggle change diff">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <FontIcon Glyph="{x:Bind ExpansionGlyph, Mode=OneWay}"
                                                              FontSize="10"
                                                              Foreground="{StaticResource RuMutedBrush}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind FileName}"
                                                               FontFamily="{StaticResource RuMonoFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource RuInkBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind AddedDeltaText}"
                                                               FontFamily="{StaticResource RuMonoFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource RuSuccessBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{x:Bind RemovedDeltaText}"
                                                               FontFamily="{StaticResource RuMonoFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource RuDangerBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <controls:FileEditPreviewControl
                                                Margin="0,4,0,2"
                                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                BeforeText="{x:Bind BeforeText}"
                                                AfterText="{x:Bind AfterText}"
                                                StartLine="{x:Bind StartLine}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="TasksBody" Visibility="Collapsed" RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Text="Background tasks" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="TasksRefreshButton" Click="OnTasksRefreshClick"
                                    Style="{StaticResource SidePanelStripButtonStyle}" Width="28" Padding="0"
                                    ToolTipService.ToolTip="Refresh background tasks" AutomationProperties.Name="Refresh background tasks">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="PanelTasksStatusText"
                                   Grid.Row="1" Margin="0,0,0,12"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AgentTasksList" ItemsSource="{x:Bind Tasks, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AgentTaskRow">
                                        <Grid ColumnSpacing="12" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="5">
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontFamily="{StaticResource RuMonoFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           TextWrapping="Wrap" MaxLines="2"
                                                           ToolTipService.ToolTip="{x:Bind Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DetailText}"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource RuMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Stop"
                                                    Tag="{x:Bind ExecutionId}"
                                                    Click="OnTaskStopClick"
                                                    Padding="10,4" CornerRadius="{StaticResource AppControlCornerRadius}"
                                                    Visibility="{x:Bind StopVisibility}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Stop background task" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="FilesBody" Visibility="Collapsed" RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBlock x:Name="FilesRootText"
                                       Text="No workspace"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button x:Name="FilesRefreshButton"
                                    Grid.Column="1"
                                    Click="OnFilesRefreshClick"
                                    Style="{StaticResource SidePanelStripButtonStyle}"
                                    Width="28"
                                    Padding="0"
                                    ToolTipService.ToolTip="Refresh file list"
                                    AutomationProperties.Name="Refresh file list">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                            </Button>
                        </Grid>

                        <ListView x:Name="FilesList"
                                  Grid.Row="1"
                                  Margin="0,6,0,0"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnFileRowClick"
                                  ItemsSource="{x:Bind Files, Mode=OneWay}"
                                  ItemContainerStyle="{StaticResource FileRowContainerStyle}"
                                  AutomationProperties.Name="Workspace files">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileTreeRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                                          Margin="{x:Bind IndentMargin}"
                                          MinHeight="26"
                                          AutomationProperties.Name="{x:Bind Name}"
                                          ToolTipService.ToolTip="{x:Bind FullPath}">
                                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                                  FontSize="13"
                                                  Foreground="{StaticResource RuMutedBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind NameVisibility}" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{x:Bind Name}"
                                                   FontFamily="{StaticResource RuUiFontFamily}"
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource RuMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind NoteVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="FilesStatusText"
                                   Grid.Row="1"
                                   Margin="0,6,0,0"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Grid x:Name="TerminalBody" Visibility="Collapsed" RowDefinitions="Auto,*">
                        <TextBlock x:Name="TerminalWorkspaceText" Margin="0,0,0,8" FontSize="12"
                                   Foreground="{StaticResource RuMutedBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="The terminal follows this workspace. Changing workspace restarts the shell." />
                        <controls:InteractiveTerminalControl x:Name="TerminalTabView" Grid.Row="1"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
