<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Markdig.Signed" />
    <!-- RuAgent.Cli (terminal TUI) pulls Terminal.Gui, which in turn pulls the unsigned
         Markdig 1.3.2. These tests already reference Markdig.Signed 0.44.0 for the GUI
         markdown engine, so the duplicate Markdig namespace made compilation ambiguous
         (CS0433). The test project never exercises Terminal.Gui; exclude the unsigned
         package's assets so Markdig.Signed stays the only Markdig in the graph. -->
    <PackageReference Include="Markdig" ExcludeAssets="all" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\gui-winui3\RuApp.csproj" />
    <!-- The free-tier predicate is duplicated in the CLI TUI and the GUI picker;
         the cross-pin test calls both real implementations. -->
    <ProjectReference Include="..\backend-dotnet\RuAgent.Cli\RuAgent.Cli.csproj" />
  </ItemGroup>
</Project>
