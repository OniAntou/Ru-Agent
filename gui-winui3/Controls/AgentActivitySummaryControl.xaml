<UserControl
    x:Class="RuApp.Controls.AgentActivitySummaryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" Visibility="Collapsed">
    <!--
      One quiet line: a glyph for the main kind of work (it turns into the disclosure
      chevron on hover, focus or while open), a sentence title and a short tail. No
      surface or border of its own; the title brightens on hover.
    -->
    <Button x:Name="SummaryButton" Click="OnExpandClick"
            AutomationProperties.AutomationId="CompactAgentActivitySummary"
            HorizontalAlignment="Left" HorizontalContentAlignment="Left"
            Background="Transparent" BorderThickness="0" Padding="2,4" MinHeight="28"
            CornerRadius="{StaticResource AppControlCornerRadius}">
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        </Button.Resources>
        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <FontIcon x:Name="LeadingIcon" FontSize="13"
                          Foreground="{StaticResource RuMutedBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <FontIcon x:Name="ChevronIcon" Glyph="&#xE70D;" FontSize="10" Opacity="0"
                          Foreground="{StaticResource RuMutedBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
            </Grid>
            <TextBlock x:Name="TitleText" Grid.Column="1"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="{x:Bind Typography.ActivityFontSize, Mode=OneWay}"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="MetaText" Grid.Column="2"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="{x:Bind Typography.ActivityFontSize, Mode=OneWay}"
                       Foreground="{StaticResource RuMutedBrush}"
                       TextWrapping="NoWrap" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Button>
</UserControl>
