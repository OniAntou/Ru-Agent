<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Controls.AgentQuestionPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border x:Name="Panel"
            Visibility="Collapsed"
            Background="{StaticResource RuSurfaceBrush}"
            BorderBrush="{StaticResource RuLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            Padding="14,12"
            Margin="0,0,0,4"
            KeyDown="OnPanelKeyDown"
            AutomationProperties.AutomationId="AgentQuestionPanel">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE897;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="QUESTION"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"
                           Foreground="{StaticResource RuAccentBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="QuestionText"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="13"
                       LineHeight="18"
                       Foreground="{StaticResource RuInkBrush}"
                       AutomationProperties.AutomationId="AgentQuestionText"
                       AutomationProperties.LiveSetting="Polite" />
            <ItemsControl x:Name="OptionsList"
                          Grid.Row="2"
                          Visibility="Collapsed"
                          AutomationProperties.AutomationId="AgentQuestionOptions">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnOptionClick"
                                Content="{Binding}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Answer with this option"
                                Background="Transparent"
                                Foreground="{StaticResource RuInkBrush}"
                                BorderBrush="{StaticResource RuLineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                Padding="14,6"
                                Height="32" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="AnswerTextBox"
                         Grid.Column="0"
                         PlaceholderText="Type your answer"
                         MaxHeight="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         KeyDown="OnAnswerKeyDown"
                         FontFamily="{StaticResource RuUiFontFamily}"
                         FontSize="13"
                         CornerRadius="{StaticResource AppControlCornerRadius}"
                         AutomationProperties.AutomationId="AgentAnswerTextBox"
                         AutomationProperties.Name="Answer" />
                <Button x:Name="SubmitButton"
                        Grid.Column="1"
                        Click="OnSubmitClick"
                        AutomationProperties.AutomationId="AgentSubmitButton"
                        AutomationProperties.Name="Submit answer"
                        Background="{StaticResource RuAccentBrush}"
                        Foreground="{StaticResource RuSurfaceBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource AppControlCornerRadius}"
                        Padding="14,6"
                        Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource RuSurfaceBrush}" />
                        <TextBlock Text="Submit"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuSurfaceBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
