<UserControl
    x:Class="RuApp.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:RuApp.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid x:Name="ResponsiveRoot" Padding="36,24,36,36" RowDefinitions="Auto,*" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="HeaderActionsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="FilterChat.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="FilterEmotion.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="FilterVts.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="ClearButton.HorizontalAlignment" Value="Stretch"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Header & Filters Bar -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,0,0,16" VerticalAlignment="Center">
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Activity Timeline" Style="{StaticResource RuViewHeaderStyle}"/>
                <TextBlock Text="Track chat events, emotion analysis, and VTube Studio actions in real time" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel x:Name="HeaderActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ToggleButton x:Name="FilterChat" Content="Chat" FontSize="12.5" Padding="14,6" Margin="0"
                          Checked="OnFilterToggled" Unchecked="OnFilterToggled" Foreground="{StaticResource RuInfoBrush}"
                          Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource RuInfoBrush}" BorderThickness="1" 
                          CornerRadius="{StaticResource AppControlCornerRadius}"/>
            
            <ToggleButton x:Name="FilterEmotion" Content="Emotion" FontSize="12.5" Padding="14,6" Margin="0"
                          Checked="OnFilterToggled" Unchecked="OnFilterToggled" Foreground="{StaticResource RuVioletBrush}"
                          Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource RuVioletBrush}" BorderThickness="1" 
                          CornerRadius="{StaticResource AppControlCornerRadius}"/>
            
            <ToggleButton x:Name="FilterVts" Content="VTS" FontSize="12.5" Padding="14,6" Margin="0"
                          Checked="OnFilterToggled" Unchecked="OnFilterToggled" Foreground="{StaticResource RuPinkBrush}"
                          Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource RuPinkBrush}" BorderThickness="1" 
                          CornerRadius="{StaticResource AppControlCornerRadius}"/>
            
            <Button x:Name="ClearButton" Content="Clear Logs" FontSize="12.5" Padding="14,6" Margin="0"
                    Click="OnClearClicked" Foreground="{StaticResource AppDangerBrush}" Background="{StaticResource AppDangerSubtleBrush}"
                    BorderBrush="{StaticResource AppDangerBrush}" BorderThickness="1" CornerRadius="{StaticResource AppControlCornerRadius}" 
                    HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Timeline Card Container -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Translation="0,0,4" Padding="16">
            <ListView x:Name="TimelineList"
                      ItemsSource="{x:Bind Rows}"
                      IsItemClickEnabled="True"
                      ItemClick="OnRowClicked"
                      SelectionMode="None"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="4"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AppCardBackgroundHoverBrush}" BorderBrush="{StaticResource AppCardBorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="{StaticResource AppControlCornerRadius}" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                <!-- Dot -->
                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                         Fill="{Binding DotBrush}" VerticalAlignment="Top" Margin="0,5,12,0"/>

                                <!-- Time -->
                                <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Consolas, Cascadia Code, Courier New"
                                           FontSize="12" Foreground="{StaticResource AppTextTertiaryBrush}" VerticalAlignment="Top" Margin="0,3,8,0"/>

                                <!-- Type badge -->
                                <Border Grid.Column="2" Background="{Binding LabelBrush}" CornerRadius="6"
                                        Padding="8,2" Margin="0,1,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"
                                               Foreground="#FFFFFF"/>
                                </Border>

                                <!-- Content + Detail -->
                                <StackPanel Grid.Column="3" MinWidth="0">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource AppTextPrimaryBrush}"
                                               FontSize="13.5" VerticalAlignment="Top" Margin="0,2,0,4"/>

                                    <Border Background="{StaticResource RuCanvasBrush}" BorderBrush="{StaticResource AppCardBorderBrush}" BorderThickness="1" 
                                            CornerRadius="6" Padding="12,10" Margin="0,6,0,4"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="DATA DETAILS" FontSize="10" Foreground="{StaticResource AppAccentHoverBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Detail}" FontFamily="Consolas, Cascadia Code, Courier New"
                                                       FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

    </Grid>
</UserControl>
