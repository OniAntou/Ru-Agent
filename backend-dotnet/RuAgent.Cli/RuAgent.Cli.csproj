<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-targeted: image attachments decode and resize through GDI+
         (System.Drawing.Common), exactly like the WinUI surface. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RuAgent.Client\RuAgent.Client.csproj" />
    <ProjectReference Include="..\RuAgent.SessionInterchange\RuAgent.SessionInterchange.csproj" />
    <ProjectReference Include="..\RuAgent.Protocol\RuAgent.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RuAgent.Cli.Tests" />
  </ItemGroup>
  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- Release precompiles the assemblies to native code with crossgen2, so the
         startup path does not pay JIT cost on first use. Debug stays uncompiled to
         keep incremental builds fast. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>
</Project>
