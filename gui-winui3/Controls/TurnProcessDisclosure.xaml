<UserControl
    x:Class="RuApp.Controls.TurnProcessDisclosure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel>
        <Button x:Name="HeaderButton"
                Click="OnHeaderClick"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,4,0,6"
                MinHeight="28"
                AutomationProperties.Name="Toggle turn process">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                <TextBlock x:Name="HeaderTextBlock"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="12.5"
                           Foreground="{StaticResource RuMutedBrush}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
                <FontIcon x:Name="ChevronIcon" Grid.Column="1"
                          Glyph="&#xE70D;"
                          FontSize="10"
                          Foreground="{StaticResource RuMutedBrush}"
                          VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Grid x:Name="BodyHost" VerticalAlignment="Top" SizeChanged="OnBodySizeChanged">
            <Grid.Clip>
                <RectangleGeometry x:Name="BodyClip" Rect="0,0,0,0" />
            </Grid.Clip>
            <ContentPresenter Content="{x:Bind BodyContent, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</UserControl>
