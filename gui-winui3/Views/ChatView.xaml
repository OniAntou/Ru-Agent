<UserControl
    x:Class="RuApp.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:views="using:RuApp.Views"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,8" HorizontalAlignment="Stretch">
                <Border MaxWidth="620"
                        HorizontalAlignment="Right"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="14,14,4,14"
                        Padding="14,10">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy Content" Click="OnCopyMessageContentClick" Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fork Branch from Here" Click="OnForkFromMessageClick" Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8D8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rewind to Here" Click="OnRewindToMessageClick" Tag="{x:Bind}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind Attachments, Mode=OneWay}"
                                      Visibility="{x:Bind HasAttachments, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageAttachmentItem">
                                    <Grid Margin="0,0,0,4">
                                        <!-- Image Rendering -->
                                        <Border Visibility="{x:Bind IsImage, Mode=OneWay}"
                                                MaxWidth="240" MaxHeight="180" Width="140" Height="105" CornerRadius="8"
                                                Background="{StaticResource RuCanvasBrush}"
                                                BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                ToolTipService.ToolTip="Click to view full image">
                                            <HyperlinkButton Click="OnImageAttachmentClick" Tag="{x:Bind}"
                                                             AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                                                             Padding="0" Background="Transparent" BorderThickness="0"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" />
                                            </HyperlinkButton>
                                        </Border>

                                        <!-- Document / Code File Pill Badge -->
                                        <Border Visibility="{x:Bind IsDocument, Mode=OneWay}"
                                                CornerRadius="6"
                                                Background="{StaticResource RuCanvasBrush}"
                                                BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind FileIconGlyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource RuAccentBrush}" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                                FontSize="14.5"
                                                Foreground="{StaticResource RuInkBrush}"
                                                FontFamily="{StaticResource RuUiFontFamily}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AgentActivityTemplate" x:DataType="models:AgentActivityItem">
            <Grid Margin="0,4"
                  HorizontalAlignment="Left"
                  Visibility="{x:Bind IsVisibleInFeed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  Loaded="OnActivityItemLoaded"
                  Unloaded="OnActivityItemUnloaded"
                  DataContextChanged="OnActivityItemDataContextChanged"
                  AutomationProperties.LiveSetting="Polite">
                <Grid ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind DisplayText, Mode=OneWay}"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource RuInkBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind MetadataText, Mode=OneWay}"
                                   Visibility="{x:Bind HasNoLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind BaseMetadataText, Mode=OneWay}"
                                   Visibility="{x:Bind HasLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="·"
                                   Visibility="{x:Bind HasLineDeltaAndBaseMetadata, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource RuMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind AddedDeltaText, Mode=OneWay}"
                                   Visibility="{x:Bind HasLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuSuccessBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind RemovedDeltaText, Mode=OneWay}"
                                   Visibility="{x:Bind HasLineDelta, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuDangerBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <!-- State bindings (used by automation & contract tests) -->
                <Border Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                <Border Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                <Border Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
                <Border Visibility="{x:Bind IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" Width="0" Height="0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessageItem">
            <Grid Margin="0,16" HorizontalAlignment="Stretch">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy Content" Click="OnCopyMessageContentClick" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Fork Branch from Here" Click="OnForkFromMessageClick" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8D8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Rewind to Here" Click="OnRewindToMessageClick" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <StackPanel MaxWidth="760"
                            HorizontalAlignment="Left"
                            Spacing="6">
                    <ItemsControl AutomationProperties.AutomationId="AgentActivityFeed"
                                  AutomationProperties.Name="Agent Activity Feed"
                                  AutomationProperties.LiveSetting="Polite"
                                  ItemsSource="{x:Bind AgentActivities, Mode=OneWay}"
                                  ItemTemplate="{StaticResource AgentActivityTemplate}"
                                  Visibility="{x:Bind HasAgentActivities, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <controls:MarkdownBlock MarkdownText="{x:Bind Content, Mode=OneWay}"
                                            FontSize="15"
                                            Foreground="{x:Bind IsError, Converter={StaticResource ErrorColorConverter}}"
                                            FontFamily="{StaticResource RuUiFontFamily}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <views:ChatMessageTemplateSelector x:Key="ChatTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Background="{StaticResource RuCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InputContainer.Padding" Value="0,6,0,18" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="16,12" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SuggestionPanel.Orientation" Value="Vertical" />
                        <Setter Target="SuggestionPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="InputContainer.Padding" Value="0,4,0,12" />
                        <Setter Target="InputBorder.Padding" Value="4,2" />
                        <Setter Target="WelcomeHeroPanel.Margin" Value="12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:MeteorShowerField x:Name="MeteorShowerField"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />

        <Grid x:Name="ReadingColumn"
              Grid.Row="0"
              HorizontalAlignment="Stretch"
              Background="Transparent">
            <StackPanel x:Name="WelcomeHeroPanel"
                        MaxWidth="820"
                        HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         Spacing="16"
                         Margin="24,16"
                        Visibility="Visible">
                <TextBlock x:Name="WelcomeEyebrow"
                           Text="RU / CONVERSATIONAL RUNTIME"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{StaticResource RuMutedBrush}" />
                <TextBlock Text="Ru"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="14"
                           Foreground="{StaticResource RuAccentBrush}" />
                <TextBlock x:Name="WelcomeIntro"
                           Text="Hello. Where should we start today?"
                           FontFamily="{StaticResource RuDisplayFontFamily}"
                           FontSize="28"
                           Foreground="{StaticResource RuInkBrush}"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SuggestionPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="12">
                    <Button Tag="Ask about a task in progress"
                            Click="OnSuggestionClick"
                            Background="{StaticResource RuSurfaceBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource RuInkBrush}"
                            CornerRadius="{StaticResource RuControlCornerRadius}"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            FontFamily="{StaticResource RuUiFontFamily}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" />
                            <TextBlock Text="Ask about a task in progress"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="13"
                                       Foreground="{StaticResource RuInkBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="ChatScrollHost"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Bottom"
                          Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuAccentColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                    <x:Double x:Key="ScrollBarSize">8</x:Double>
                </ScrollViewer.Resources>
                <Grid x:Name="ChatContentGrid"
                      HorizontalAlignment="Center"
                      RowDefinitions="Auto,Auto">
                    <ListView x:Name="ChatListView"
                              Grid.Row="0"
                              AutomationProperties.AutomationId="ChatMessages"
                              Padding="16,16,16,8"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical"
                                                 HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                </Grid>
            </ScrollViewer>
        </Grid>

            <Grid x:Name="InputContainer"
              Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto,Auto"
              Width="820"
              MaxWidth="820"
              Background="Transparent"
              Padding="0,8,0,24"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center">
            <Border x:Name="TerminalPanel"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    Margin="0,0,0,8"
                    AutomationProperties.AutomationId="TerminalPanel"
                    AutomationProperties.Name="Terminal output">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          VerticalAlignment="Center">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;"
                                      FontSize="13"
                                      Foreground="{StaticResource RuAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Terminal"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RuInkBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Click="OnTerminalClearClick"
                                Padding="10,4"
                                AutomationProperties.AutomationId="TerminalClearButton"
                                AutomationProperties.Name="Clear terminal output" />
                        <Button Grid.Column="2"
                                Content="Hide"
                                Click="OnTerminalCollapseClick"
                                Padding="10,4"
                                AutomationProperties.AutomationId="TerminalCollapseButton"
                                AutomationProperties.Name="Hide terminal output" />
                    </Grid>
                    <ScrollViewer x:Name="TerminalScrollHost"
                                  Grid.Row="1"
                                  MaxHeight="180"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind TerminalBlocks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TerminalOutputBlock">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                       FontFamily="{StaticResource RuUiFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource RuInkBrush}" />
                                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}"
                                                       FontFamily="{StaticResource RuMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource RuMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource RuInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FooterText, Mode=OneWay}"
                                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource RuMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="AgentInlinePanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Spacing="6"
                        Margin="8,0,8,6">
                <!-- Status pill removed per user directive; placeholders preserved for accessibility/automation -->
                <TextBlock x:Name="AgentStatusText"
                           Visibility="Collapsed"
                           AutomationProperties.AutomationId="AgentStatusText"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="AgentStopButton"
                        Visibility="Collapsed"
                        Click="OnAgentStopClick"
                        AutomationProperties.AutomationId="AgentStopButton"
                        AutomationProperties.Name="Stop Coding Agent" />

                <Border x:Name="AgentApprovalPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource RuSurfaceBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,4">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource RuWarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="PERMISSION REQUIRED"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource RuWarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AgentApprovalSummaryText"
                                   Grid.Row="1"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="13"
                                   LineHeight="18"
                                   Foreground="{StaticResource RuInkBrush}"
                                   AutomationProperties.AutomationId="AgentApprovalSummaryText"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border x:Name="AgentApprovalCommandContainer"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Background="{StaticResource RuCanvasBrush}"
                                BorderBrush="{StaticResource RuLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="$"
                                           FontFamily="{StaticResource RuMonoFontFamily}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource RuAccentBrush}"
                                           VerticalAlignment="Top" />
                                <ScrollViewer Grid.Column="1"
                                              MaxHeight="120"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="AgentApprovalCommandText"
                                               FontFamily="{StaticResource RuMonoFontFamily}"
                                               FontSize="12"
                                               LineHeight="17"
                                               Foreground="{StaticResource RuInkBrush}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               AutomationProperties.AutomationId="AgentApprovalCommandText"
                                               AutomationProperties.Name="Terminal command" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <Button x:Name="AgentApproveButton"
                                    Click="OnAgentApproveClick"
                                    AutomationProperties.AutomationId="AgentApproveButton"
                                    AutomationProperties.Name="Approve agent action"
                                    Background="{StaticResource RuAccentBrush}"
                                    Foreground="{StaticResource RuSurfaceBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    Padding="14,6"
                                    Height="32">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource RuSurfaceBrush}" />
                                    <TextBlock Text="Approve"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource RuSurfaceBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AgentDenyButton"
                                    Click="OnAgentDenyClick"
                                    AutomationProperties.AutomationId="AgentDenyButton"
                                    AutomationProperties.Name="Deny agent action"
                                    Background="Transparent"
                                    Foreground="{StaticResource RuInkBrush}"
                                    BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    Padding="14,6"
                                    Height="32">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                                    <TextBlock Text="Deny"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource RuInkBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>

            <Border x:Name="InputBorder"
                    Grid.Row="3"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10,12,8"
                    AllowDrop="True"
                    DragOver="OnInputDragOver"
                    Drop="OnInputDrop">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Image Attachment Preview Strip -->
                    <ScrollViewer x:Name="AttachmentPreviewContainer"
                                  Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  Margin="0,0,0,8"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="AttachmentPreviewList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImageAttachmentItem">
                                    <Grid Margin="0,0,4,0">
                                        <!-- Image Thumbnail Box -->
                                        <Grid Visibility="{x:Bind IsImage, Mode=OneWay}" Width="60" Height="60"
                                              ToolTipService.ToolTip="{x:Bind FormattedSize, Mode=OneWay}">
                                             <Border CornerRadius="8" Background="{StaticResource RuCanvasBrush}"
                                                     BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1">
                                                 <Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"/>
                                             </Border>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Width="18" Height="18" Padding="0" Margin="2"
                                                    Background="#C0000000" Foreground="White"
                                                    BorderThickness="0" CornerRadius="9"
                                                    Click="OnRemoveAttachmentClick" Tag="{x:Bind Id}">
                                                <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                            </Button>
                                        </Grid>

                                        <!-- Document / Code File Pill Badge -->
                                        <Grid Visibility="{x:Bind IsDocument, Mode=OneWay}" Height="34">
                                            <Border CornerRadius="6" Background="{StaticResource RuCanvasBrush}"
                                                    BorderBrush="{StaticResource RuLineBrush}" BorderThickness="1"
                                                    Padding="8,4,4,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind FileIconGlyph, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RuAccentBrush}"/>
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" Margin="0,0,2,0"/>
                                                    <Button Width="18" Height="18" Padding="0"
                                                            Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                                            BorderThickness="0" CornerRadius="9"
                                                            Click="OnRemoveAttachmentClick" Tag="{x:Bind Id}">
                                                        <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBox x:Name="ChatInputTextBox"
                              Grid.Row="1"
                              AutomationProperties.AutomationId="ChatInput"
                              AutomationProperties.Name="Message input"
                              PlaceholderText="Message Ru…"
                             PreviewKeyDown="OnChatInputPreviewKeyDown"
                             AcceptsReturn="True"
                             MinHeight="44"
                             MaxHeight="150"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="{StaticResource RuUiFontFamily}"
                             FontSize="15"
                             Padding="4,2,4,6"
                             Foreground="{StaticResource RuInkBrush}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                          Margin="0,4,0,0">
                        <Button x:Name="AttachImageButton"
                                Grid.Column="0"
                                Click="OnAttachImageClick"
                                Width="30"
                                Height="30"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Margin="0"
                                AutomationProperties.AutomationId="AttachImageButton"
                                AutomationProperties.Name="Attach files or images">
                            <FontIcon x:Name="AttachImageIcon"
                                      Glyph="&#xE710;"
                                      FontSize="14"
                                      Foreground="{StaticResource RuMutedBrush}" />
                        </Button>

                        <Button x:Name="AgentModeButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                CornerRadius="{StaticResource RuControlCornerRadius}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                IsTabStop="False"
                                AutomationProperties.AutomationId="AgentModeButton"
                                AutomationProperties.Name="Coding Agent">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="AgentModeIcon"
                                          Glyph="&#xEC25;"
                                          FontSize="12"
                                          Foreground="{StaticResource RuMutedBrush}" />
                                <TextBlock x:Name="AgentModeLabel"
                                           Text="Agent"
                                           FontSize="12"
                                           Foreground="{StaticResource RuMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ChatModelButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ChatModelButton"
                                    AutomationProperties.Name="Select AI Model"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,4"
                                    Margin="0"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RootBorder"
                                                            Background="Transparent"
                                                            CornerRadius="{TemplateBinding CornerRadius}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuCanvasBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatModelLabel"
                                                Text="Model…"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}"
                                               MaxWidth="160"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChatModelSaveStatusText"
                                               Foreground="{StaticResource RuDangerBrush}"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="120"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <FontIcon Glyph="&#xE70D;"
                                               FontSize="9"
                                               Foreground="{StaticResource RuMutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="ChatModelFlyout" Placement="Top" Opened="OnChatModelFlyoutOpened">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Padding" Value="4" />
                                                <Setter Property="Width" Value="320" />
                                                <Setter Property="MinWidth" Value="320" />
                                                <Setter Property="MaxWidth" Value="320" />
                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <views:ProviderModelPicker x:Name="ModelPicker"
                                                                   Width="312"
                                                                   SearchTextChanged="OnModelPickerSearchTextChanged"
                                                                   ModelSelected="OnModelPickerModelSelected" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

<Border x:Name="ChatReasoningDivider" Width="1" Height="14" Background="{StaticResource RuLineBrush}" Opacity="0.6" Margin="2,0" VerticalAlignment="Center"/>

                            <Button x:Name="ChatReasoningButton"
                                    AutomationProperties.AutomationId="ChatReasoningButton"
                                    AutomationProperties.Name="Select Reasoning Effort"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,4"
                                    Margin="0"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RuControlCornerRadius}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RootBorder"
                                                            Background="Transparent"
                                                            CornerRadius="{TemplateBinding CornerRadius}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuCanvasBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuAccentSoftBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled" />
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatReasoningLabel"
                                               Text="default"
                                               FontFamily="{StaticResource RuUiFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource RuInkBrush}"
                                               MaxWidth="100"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;"
                                              FontSize="9"
                                              Foreground="{StaticResource RuMutedBrush}"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="ChatReasoningFlyout" Placement="Top" Opened="OnChatReasoningFlyoutOpened">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Padding" Value="4" />
                                                <Setter Property="MinWidth" Value="140" />
                                                <Setter Property="MaxWidth" Value="220" />
                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel x:Name="ReasoningOptionsContainer" Spacing="2" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ContextMeterButton"
                                    AutomationProperties.AutomationId="ContextMeterButton"
                                    AutomationProperties.Name="View Context Window capacity"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="13"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="13"
                                                            Width="26"
                                                            Height="26">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressRing x:Name="ContextProgressRing"
                                                  IsIndeterminate="False"
                                                  Value="0"
                                                  Minimum="0"
                                                  Maximum="100"
                                                  Width="18"
                                                  Height="18"
                                                  Foreground="{StaticResource RuAccentBrush}"
                                                  Background="{StaticResource RuLineBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout x:Name="ContextWindowFlyout" Placement="Top">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Padding" Value="8,6" />
                                                <Setter Property="MinWidth" Value="130" />
                                                <Setter Property="MaxWidth" Value="180" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="ContextUsedLabel"
                                                           Text="0 / 128K"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource RuInkBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="ContextPercentLabel"
                                                           Grid.Column="1"
                                                           Text="0%"
                                                           FontFamily="{StaticResource RuUiFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource RuMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ProgressBar x:Name="ContextProgressBar"
                                                         Value="0"
                                                         Maximum="100"
                                                         Height="2"
                                                         CornerRadius="1"
                                                         Foreground="{StaticResource RuAccentBrush}"
                                                         Background="{StaticResource RuLineBrush}"
                                                         Opacity="0.9" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="SendButton"
                                    AutomationProperties.AutomationId="SendButton"
                                    AutomationProperties.Name="Send message"
                                    Click="OnSendClick"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="{StaticResource RuControlCornerRadius}"
                                    Background="{StaticResource RuAccentSoftBrush}"
                                    BorderBrush="{StaticResource RuLineBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <FontIcon x:Name="SendButtonIcon" Glyph="&#xE725;" FontSize="13" Foreground="{StaticResource RuInkBrush}" Margin="-1,1,0,0" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
