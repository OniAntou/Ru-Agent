                    <!-- Pill + popup hover: unmistakably Ru (not default blue accent) -->
                    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerPressed" Color="#CBD5E1" />
                    <CornerRadius x:Key="ComboBoxHighlightBorderCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="ComboBoxDropDownButtonBackgroundCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="ComboBoxItemCornerRadius">6</CornerRadius>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="RuCanvasColor">#16181D</Color>
                    <Color x:Key="RuSidebarColor">#111317</Color>
                    <Color x:Key="RuSurfaceColor">#20232A</Color>
                    <Color x:Key="RuInkColor">#F1F5F9</Color>
                    <Color x:Key="RuMutedColor">#94A3B8</Color>
                    <Color x:Key="RuLineColor">#334155</Color>
                    <Color x:Key="RuAccentColor">#E2E8F0</Color>
                    <Color x:Key="RuAccentSoftColor">#282D37</Color>
                    <Color x:Key="RuAccentHoverColor">#F1F5F9</Color>
                    <Color x:Key="RuAccentPressedColor">#CBD5E1</Color>
                    <Color x:Key="RuSuccessColor">#34D399</Color>
                    <Color x:Key="RuWarningColor">#FBBF24</Color>
                    <Color x:Key="RuDangerColor">#F87171</Color>
                    <Color x:Key="RuInfoColor">#38BDF8</Color>
                    <Color x:Key="RuVioletColor">#C084FC</Color>
                    <Color x:Key="RuPinkColor">#F472B6</Color>

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F8FAFC" />

                    <!-- Universal Button & Control Hover/Pressed Theme Resources (Clean & Flicker-free) -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#16181D" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#282D37" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

                    <SolidColorBrush x:Key="SubtleFillColorSecondary" Color="#16181D" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiary" Color="#282D37" />

                    <!-- ListViewItem Hover & Selected -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#16181D" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#282D37" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#282D37" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#334155" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#334155" />
                    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#F1F5F9" />

                    <!-- ComboBox (Ru theme: Canvas input-well on Surface cards) -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#16181D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#282D37" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#16181D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#16181D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#16181D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#20232A" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPressed" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundDisabled" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#16181D" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#282D37" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#282D37" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#282D37" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#334155" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="Transparent" />
                    <!-- Pill + popup hover: unmistakably Ru (not default blue accent) -->
                    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="#282D37" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerPressed" Color="#334155" />
                    <CornerRadius x:Key="ComboBoxHighlightBorderCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="ComboBoxDropDownButtonBackgroundCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="ComboBoxItemCornerRadius">6</CornerRadius>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters -->
            <converters:ErrorColorConverter x:Key="ErrorColorConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <SolidColorBrush x:Key="RuCanvasBrush" Color="{ThemeResource RuCanvasColor}" />
            <SolidColorBrush x:Key="RuSidebarBrush" Color="{ThemeResource RuSidebarColor}" />
            <SolidColorBrush x:Key="RuSurfaceBrush" Color="{ThemeResource RuSurfaceColor}" />
            <SolidColorBrush x:Key="RuInkBrush" Color="{ThemeResource RuInkColor}" />
            <SolidColorBrush x:Key="RuMutedBrush" Color="{ThemeResource RuMutedColor}" />
            <SolidColorBrush x:Key="RuLineBrush" Color="{ThemeResource RuLineColor}" />
            <SolidColorBrush x:Key="RuAccentBrush" Color="{ThemeResource RuAccentColor}" />
            <SolidColorBrush x:Key="RuAccentSoftBrush" Color="{ThemeResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="RuAccentHoverBrush" Color="{ThemeResource RuAccentHoverColor}" />
            <SolidColorBrush x:Key="RuAccentPressedBrush" Color="{ThemeResource RuAccentPressedColor}" />
            <SolidColorBrush x:Key="RuOnAccentBrush" Color="{ThemeResource RuCanvasColor}" />
            <SolidColorBrush x:Key="RuSuccessBrush" Color="{ThemeResource RuSuccessColor}" />
            <SolidColorBrush x:Key="RuWarningBrush" Color="{ThemeResource RuWarningColor}" />
            <SolidColorBrush x:Key="RuDangerBrush" Color="{ThemeResource RuDangerColor}" />
            <SolidColorBrush x:Key="RuInfoBrush" Color="{ThemeResource RuInfoColor}" />
            <SolidColorBrush x:Key="RuVioletBrush" Color="{ThemeResource RuVioletColor}" />
            <SolidColorBrush x:Key="RuPinkBrush" Color="{ThemeResource RuPinkColor}" />

            <FontFamily x:Key="RuUiFontFamily">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter, Segoe UI Variable, Segoe UI, Segoe UI Emoji</FontFamily>
            <FontFamily x:Key="RuDisplayFontFamily">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter, Segoe UI Variable, Segoe UI, Segoe UI Emoji</FontFamily>
            <FontFamily x:Key="RuMonoFontFamily">Cascadia Code, Consolas</FontFamily>

            <!-- Legacy resource names remain available to untouched views. -->
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource RuSurfaceColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="{ThemeResource RuAccentSoftColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource RuLineColor}" />
            <SolidColorBrush x:Key="AppCardBorderSubtleBrush" Color="{ThemeResource RuLineColor}" />

            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{ThemeResource RuAccentColor}" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="{ThemeResource RuAccentSoftColor}" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{ThemeResource RuInkColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{ThemeResource RuMutedColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{ThemeResource RuMutedColor}" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource RuSuccessColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{ThemeResource RuWarningColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{ThemeResource RuDangerColor}" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="{ThemeResource RuSidebarColor}" />

            <!-- CornerRadius scale. One value per step, so two panels of the
                 same kind never end up with different roundness:
                   micro 3  - bars 6px tall, so 3 is a fully rounded end
                   6        - controls, inputs, badges, chips
                   inset 8  - a card nested one level inside another surface
                   card 12  - standalone panels and cards
                   flyout 14, modal 16 - the two floating layers
                   pill 999 - anything that must read as a lozenge -->
            <CornerRadius x:Key="AppMicroPillCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="AppInsetCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppCardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="AppModalCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="AppPillCornerRadius">999</CornerRadius>
            <CornerRadius x:Key="AppFlyoutCornerRadius">10</CornerRadius>

            <!-- Elevation: shared theme shadows; depth comes from shadow, not borders -->
            <ThemeShadow x:Key="RuRestShadow" />
            <ThemeShadow x:Key="RuRaisedShadow" />

            <!-- Card Border Style -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="24,20" />
                <Setter Property="Shadow" Value="{StaticResource RuRestShadow}" />
            </Style>

            <!-- Toolbar pill-button: transparent rest, canvas hover, soft pressed -->
            <Style x:Key="RuToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuCanvasBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RuAccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary CTA: transparent well, accent outline, soft hover -->
            <Style x:Key="RuSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource RuAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuLineBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary CTA: solid accent fill, canvas glyph, tonal hover/pressed -->
            <Style x:Key="RuPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RuAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource RuOnAccentBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ru Dropdown Button: input-well trigger mirroring the prompt ModelPicker trigger -->
            <Style x:Key="RuDropdownButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RuCanvasBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuLineBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ru Dropdown Flyout: same presenter chrome as the prompt ModelPicker -->
            <Style x:Key="RuDropdownFlyoutStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource RuSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RuLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppFlyoutCornerRadius}" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Width" Value="268" />
                <Setter Property="MinWidth" Value="268" />
                <Setter Property="MaxWidth" Value="268" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
            </Style>

            <!-- Ru Dropdown Item: hover/pressed owned by the style so every
                 row (including runtime-built Models.dev rows) reacts alike -->
            <Style x:Key="RuDropdownItemButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,3,8,3" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuAccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RuLineBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ru Option Row: one row of a flyout that the keyboard can walk.
                 Deliberately has no PointerOver visual state, unlike
                 RuDropdownItemButtonStyle above. A visual state ends when the pointer
                 leaves, and a keyboard cursor has to outlive the pointer: the whole
                 point is that the row Enter will pick stays marked after the mouse has
                 moved off it. A template cannot express that, so the row's background
                 is painted from code by the cursor controller. -->
            <Style x:Key="RuOptionRowStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,5,6,5" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="Root"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RuNavLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuUiFontFamily}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource RuInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RuViewHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RuDisplayFontFamily}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
