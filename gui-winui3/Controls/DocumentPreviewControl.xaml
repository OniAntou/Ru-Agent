<UserControl
    x:Class="RuApp.Controls.DocumentPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RuApp.Controls">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <StackPanel Spacing="3">
                <TextBlock x:Name="FileNameLabel" Text="File preview" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource RuInkBrush}" />
                <TextBlock x:Name="PreviewDetailLabel" Text="Read-only preview" FontSize="11" Foreground="{StaticResource RuMutedBrush}" />
            </StackPanel>
            <Button x:Name="FocusPreviewButton" Grid.Column="1" Click="OnFocusPreview" Visibility="Collapsed"
                    Content="Focus preview" FontSize="11" Padding="6,0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Use the document with the keyboard; Tab or Esc returns to Ru."
                    AutomationProperties.Name="Focus document preview" />
            <Button x:Name="FitPreviewButton" Grid.Column="1" Click="OnFitPreview" Visibility="Collapsed"
                    Content="Fit" FontSize="11" Padding="6,0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Fit preview to panel width" AutomationProperties.Name="Fit file preview" />
            <Button x:Name="PreviewReloadButton" Grid.Column="2" Click="OnRefresh" ToolTipService.ToolTip="Reload file preview"
                    AutomationProperties.Name="Reload file preview" Width="28" Padding="0" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
        </Grid>
        <Grid x:Name="PageToolbar" Grid.Row="1" Visibility="Collapsed" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <Button x:Name="PreviousPage" Click="OnPreviousPage" Content="‹" AutomationProperties.Name="Previous preview page" />
            <TextBlock x:Name="PageLabel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource RuMutedBrush}" />
            <Button x:Name="NextPage" Grid.Column="2" Click="OnNextPage" Content="›" AutomationProperties.Name="Next preview page" />
        </Grid>
        <Grid Grid.Row="2" x:Name="PreviewArea" Margin="0,0,0,12">
            <ScrollViewer x:Name="ContentScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4"
                          SizeChanged="OnPreviewViewportSizeChanged">
                <Grid x:Name="PreviewContent">
                    <Image x:Name="PageImage" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="Rendered document page" />
                    <!-- Code and plain text: an editor-like frame with a fixed line-number
                         gutter and syntax colors. Lines do not wrap; the code scrolls
                         sideways inside the frame while the gutter stays put. Both columns
                         share one block line height so numbers stay level with their lines. -->
                    <Border x:Name="CodeFrame" Visibility="Collapsed" VerticalAlignment="Top"
                            Background="{StaticResource RuSidebarBrush}" BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource AppCardCornerRadius}" Padding="0,8,0,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock x:Name="LineNumbers" FontFamily="{StaticResource RuMonoFontFamily}" FontSize="12"
                                       LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                       TextAlignment="Right" Padding="12,0,10,0" Opacity="0.6"
                                       Foreground="{StaticResource RuMutedBrush}" IsTextSelectionEnabled="False"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                <TextBlock x:Name="TextContent" FontFamily="{StaticResource RuMonoFontFamily}" FontSize="12"
                                           LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                           IsTextSelectionEnabled="True" TextWrapping="NoWrap" Padding="4,0,16,0"
                                           Foreground="{StaticResource RuInkBrush}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <controls:MarkdownBlock x:Name="MarkdownContent" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="StatusLabel" Text="Select a file in Files to preview it here." TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="13"
                       Foreground="{StaticResource RuMutedBrush}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</UserControl>
