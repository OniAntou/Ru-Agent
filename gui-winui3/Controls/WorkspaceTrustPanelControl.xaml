<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Controls.WorkspaceTrustPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!--
      The workspace trust gate, in the chat flow instead of a modal dialog: the same
      floating slot as the approval and question cards. It does not block the window,
      so the owner resolves it whenever the run stops needing trust. Focus lands on
      Cancel, Escape cancels, and nothing here approves by default.
    -->
    <Border x:Name="Panel"
            Visibility="Collapsed"
            Background="{StaticResource RuSurfaceBrush}"
            BorderBrush="{StaticResource RuLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            Padding="16,14"
            Margin="0,0,0,4"
            KeyDown="OnPanelKeyDown"
            AutomationProperties.AutomationId="WorkspaceTrustPanel"
            AutomationProperties.Name="Workspace trust">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="28" Height="28" VerticalAlignment="Top"
                    CornerRadius="{StaticResource AppControlCornerRadius}"
                    Background="{StaticResource RuAccentSoftBrush}">
                <FontIcon Glyph="&#xEA18;" FontSize="15"
                          Foreground="{StaticResource RuWarningBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RuInkBrush}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ContentText"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="13"
                           LineHeight="19"
                           Foreground="{StaticResource RuMutedBrush}" />

                <Border Background="{StaticResource RuCanvasBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppInsetCornerRadius}"
                        Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                  Foreground="{StaticResource RuMutedBrush}"
                                  VerticalAlignment="Top" Margin="0,1,0,0"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="PathText"
                                   Grid.Column="1"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="12"
                                   LineHeight="17"
                                   Foreground="{StaticResource RuInkBrush}" />
                    </Grid>
                </Border>

                <Grid x:Name="WarningRow" Visibility="Collapsed" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="13"
                              Foreground="{StaticResource RuWarningBrush}"
                              VerticalAlignment="Top" Margin="0,2,0,0"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="WarningText"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource RuUiFontFamily}"
                               FontSize="12.5"
                               LineHeight="18"
                               Foreground="{StaticResource RuInkBrush}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,2,0,0">
                    <Button x:Name="CancelButton"
                            Click="OnCancelClick"
                            AutomationProperties.AutomationId="WorkspaceTrustCancelButton"
                            AutomationProperties.Name="Cancel, do not trust this workspace"
                            Background="Transparent"
                            Foreground="{StaticResource RuInkBrush}"
                            BorderBrush="{StaticResource RuLineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            Padding="14,6"
                            Height="32">
                        <TextBlock Text="Cancel"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource RuInkBrush}" />
                    </Button>
                    <Button x:Name="ApproveButton"
                            Click="OnApproveClick"
                            AutomationProperties.AutomationId="WorkspaceTrustApproveButton"
                            Background="{StaticResource RuAccentBrush}"
                            Foreground="{StaticResource RuSurfaceBrush}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            Padding="14,6"
                            Height="32">
                        <TextBlock x:Name="ApproveLabel"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuSurfaceBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
