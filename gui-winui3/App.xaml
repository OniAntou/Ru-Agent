                    <Color x:Key="RuVioletColor">#7E22CE</Color>
                    <Color x:Key="RuPinkColor">#BE123C</Color>

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#1E293B" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#334155" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#475569" />
