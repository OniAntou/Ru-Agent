<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Controls.AgentApprovalPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border x:Name="Panel"
            Visibility="Collapsed"
            Background="{StaticResource RuSurfaceBrush}"
            BorderBrush="{StaticResource RuLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            Padding="14,12"
            Margin="0,0,0,4"
            KeyDown="OnPanelKeyDown"
            AutomationProperties.AutomationId="AgentApprovalPanel">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource RuWarningBrush}" VerticalAlignment="Center" />
                <TextBlock Text="PERMISSION REQUIRED"
                           FontFamily="{StaticResource RuUiFontFamily}"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"
                           Foreground="{StaticResource RuWarningBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SummaryText"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="13"
                       LineHeight="18"
                       Foreground="{StaticResource RuInkBrush}"
                       AutomationProperties.AutomationId="AgentApprovalSummaryText"
                       AutomationProperties.LiveSetting="Polite" />
            <Border x:Name="CommandContainer"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Background="{StaticResource RuCanvasBrush}"
                    BorderBrush="{StaticResource RuLineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppInsetCornerRadius}"
                    Padding="10,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="$"
                               FontFamily="{StaticResource RuMonoFontFamily}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource RuAccentBrush}"
                               VerticalAlignment="Top" />
                    <ScrollViewer Grid.Column="1"
                                  MaxHeight="120"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="CommandText"
                                   FontFamily="{StaticResource RuMonoFontFamily}"
                                   FontSize="12"
                                   LineHeight="17"
                                   Foreground="{StaticResource RuInkBrush}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="AgentApprovalCommandText"
                                   AutomationProperties.Name="Terminal command" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Button x:Name="ApproveButton"
                        Click="OnApproveClick"
                        AutomationProperties.AutomationId="AgentApproveButton"
                        AutomationProperties.Name="Approve agent action"
                        Background="{StaticResource RuAccentBrush}"
                        Foreground="{StaticResource RuSurfaceBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource AppControlCornerRadius}"
                        Padding="14,6"
                        Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource RuSurfaceBrush}" />
                        <TextBlock Text="Approve"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RuSurfaceBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AlwaysButton"
                        Click="OnAlwaysClick"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="AgentAlwaysButton"
                        AutomationProperties.Name="Approve for this chat session"
                        Background="Transparent"
                        Foreground="{StaticResource RuInkBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppControlCornerRadius}"
                        Padding="14,6"
                        Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                        <TextBlock Text="Always"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource RuInkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RememberButton"
                         Click="OnRememberClick"
                         Visibility="Collapsed"
                         AutomationProperties.AutomationId="AgentRememberButton"
                         AutomationProperties.Name="Approve and remember this action"
                         Background="Transparent"
                         Foreground="{StaticResource RuInkBrush}"
                         BorderBrush="{StaticResource RuLineBrush}"
                         BorderThickness="1"
                         CornerRadius="{StaticResource AppControlCornerRadius}"
                         Padding="14,6"
                         Height="32">
                     <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                         <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                         <TextBlock Text="Remember"
                                    FontFamily="{StaticResource RuUiFontFamily}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource RuInkBrush}"
                                    VerticalAlignment="Center" />
                     </StackPanel>
                 </Button>
                 <Button x:Name="DenyButton"
                        Click="OnDenyClick"
                        AutomationProperties.AutomationId="AgentDenyButton"
                        AutomationProperties.Name="Deny agent action"
                        Background="Transparent"
                        Foreground="{StaticResource RuInkBrush}"
                        BorderBrush="{StaticResource RuLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppControlCornerRadius}"
                        Padding="14,6"
                        Height="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource RuMutedBrush}" />
                        <TextBlock Text="Deny"
                                   FontFamily="{StaticResource RuUiFontFamily}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource RuInkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SessionScopeHint"
                       Grid.Row="4"
                       Visibility="Collapsed"
                       Text="Always opens this folder for the chat only. The grant is lost when the app closes."
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource RuUiFontFamily}"
                       FontSize="11"
                       Foreground="{StaticResource RuMutedBrush}"
                       AutomationProperties.AutomationId="AgentApprovalScopeHint" />
        </Grid>
    </Border>
</UserControl>
