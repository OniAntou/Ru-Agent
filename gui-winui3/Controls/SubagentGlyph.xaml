<UserControl x:Class="RuApp.Controls.SubagentGlyph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="24" Height="24" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
    <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform><RotateTransform x:Name="Orientation" /></Canvas.RenderTransform>
        <Path x:Name="Branch" Data="M6,18 L6,6 M6,12 L17,12 L17,6" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource RuInfoBrush}" />
        <Ellipse x:Name="RootNode" Canvas.Left="3" Canvas.Top="15" Width="6" Height="6" Fill="{StaticResource RuInfoBrush}" />
        <Ellipse x:Name="ReviewNode" Canvas.Left="14" Canvas.Top="3" Width="6" Height="6"
                 StrokeThickness="1.5" Stroke="{StaticResource RuInfoBrush}" />
        <Rectangle x:Name="CodingNode" Canvas.Left="14" Canvas.Top="3" Width="6" Height="6" RadiusX="1" RadiusY="1"
                   StrokeThickness="1.5" Stroke="{StaticResource RuInfoBrush}" Visibility="Collapsed" />
    </Canvas>
</UserControl>
