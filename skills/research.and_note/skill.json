{
  "id": "research.and_note",
  "version": "1.0.0",
  "input_schema": { "type": "object", "required": ["query"] },
  "output_schema": { "type": "object", "required": ["summary", "sources"] },
  "required_tools": ["read", "write"],
  "required_scopes": ["workspace.read", "workspace.write", "skill.execute"],
  "steps": [
    { "kind": "call_tool", "name": "search", "tool_id": "read", "arguments": { "op": "web_search", "query": "" } },
    { "kind": "call_tool", "name": "fetch", "tool_id": "read", "arguments": { "op": "web_fetch", "url": "" } },
    { "kind": "named_transform", "name": "summarize_with_citations" },
    { "kind": "call_tool", "name": "save_note", "tool_id": "write", "arguments": { "op": "write", "path": "notes.txt", "content": "" } }
  ],
  "requires_approval": true,
  "max_steps": 8,
  "timeout_ms": 120000,
  "trust_class": "builtin"
}
