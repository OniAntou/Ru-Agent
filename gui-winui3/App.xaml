                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#0F172A" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#0F172A" />

                    <!-- ComboBox (Ru theme: Canvas input-well on Surface cards) -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#CBD5E1" />
