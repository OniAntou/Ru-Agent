<Application
    x:Class="RuApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RuApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:ErrorColorConverter x:Key="ErrorColorConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Minimalist Matte Slate & Obsidian Palette (Clean, Elegant, Zero Neon) -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0D0E12" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#12141B" />
            <SolidColorBrush x:Key="AppSidebarBorderBrush" Color="#1D202A" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#171923" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="#1E222E" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#242836" />
            <SolidColorBrush x:Key="AppCardBorderSubtleBrush" Color="#1B1E28" />
            <SolidColorBrush x:Key="AppCardBorderHighlightBrush" Color="#2E3446" />
            
            <!-- Refined Matte Accents (No Neon) -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4F6BFF" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#6881FF" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#1A1D2D" />
            <SolidColorBrush x:Key="AppAccentGlowBrush" Color="#8FA2FF" />
            <SolidColorBrush x:Key="AppSecondaryAccentBrush" Color="#64748B" />
            <SolidColorBrush x:Key="AppSecondaryAccentSubtleBrush" Color="#181B24" />
            
            <!-- Crisp Platinum & Slate Typography -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#64748B" />
            
            <!-- Status Indicators (Emerald, Amber, Rose) -->
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#10B981" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="#132E24" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="#302312" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="#2B1417" />

            <!-- CornerRadius Design Tokens -->
            <CornerRadius x:Key="AppCardCornerRadius">14</CornerRadius>
            <CornerRadius x:Key="AppControlCornerRadius">9</CornerRadius>
            <CornerRadius x:Key="AppPillCornerRadius">24</CornerRadius>

            <!-- Card Border Style -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="24,20" />
            </Style>

            <!-- Smooth Action Button Style -->
            <Style x:Key="ActionCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
