<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.5" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <ProjectReference Include="..\RuAgent.Protocol\RuAgent.Protocol.csproj" />
    <EmbeddedResource Include="..\..\README.md" LogicalName="RuAgent.Broker.HelpDocs.ru-overview.md" />
    <EmbeddedResource Include="..\..\docs\architecture.md" LogicalName="RuAgent.Broker.HelpDocs.architecture.md" />
    <EmbeddedResource Include="..\..\docs\operations\runtime-behavior.md" LogicalName="RuAgent.Broker.HelpDocs.runtime.md" />
    <EmbeddedResource Include="..\..\docs\operations\agent-tools.md" LogicalName="RuAgent.Broker.HelpDocs.agent-tools.md" />
    <EmbeddedResource Include="..\..\docs\operations\provider-catalog.md" LogicalName="RuAgent.Broker.HelpDocs.provider-catalog.md" />
  </ItemGroup>
  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- Release precompiles the assemblies to native code with crossgen2, so the
         startup path does not pay JIT cost on first use. Debug stays uncompiled to
         keep incremental builds fast. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>
</Project>
