<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RuApp.Views.ProviderModelPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="312">

    <UserControl.Resources>
        <Style x:Key="PickerItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Root"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          CornerRadius="{TemplateBinding CornerRadius}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="0">
        <!-- Modern Search Box -->
        <Border Background="{StaticResource RuCanvasBrush}"
                BorderBrush="{StaticResource RuLineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppControlCornerRadius}"
                Padding="10,6"
                Margin="4,4,4,6">
            <Grid ColumnDefinitions="Auto,*">
                <FontIcon Glyph="&#xE721;"
                          FontSize="12"
                          Foreground="{StaticResource RuMutedBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBox x:Name="PickerSearchBox"
                         Grid.Column="1"
                          AutomationProperties.AutomationId="ModelSearchBox"
                          AutomationProperties.Name="Search models"
                          PlaceholderText="Search models…"
                         TextChanged="OnPickerSearchTextChanged"
                         FontFamily="{StaticResource RuUiFontFamily}"
                         FontSize="12.5"
                         MinHeight="0"
                         Padding="0"
                         Margin="0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         IsSpellCheckEnabled="False"
                         Foreground="{StaticResource RuInkBrush}">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource RuMutedColor}" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource RuMutedColor}" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource RuMutedColor}" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlThemePadding">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>

        <!-- Subtle Divider Line -->
<Border Height="1" Background="{StaticResource RuLineBrush}" Opacity="0.6" Margin="4,0,4,4" />

        <!-- Grouped Model List with Sleek Slim ScrollBar -->
        <ScrollViewer MaxHeight="250"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      Padding="2,0,8,4">
            <ScrollViewer.Resources>
                <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarForeground" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{ThemeResource RuLineColor}" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{ThemeResource RuMutedColor}" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{ThemeResource RuAccentColor}" />
                <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="Transparent" />
                <x:Double x:Key="ScrollBarSize">5</x:Double>
            </ScrollViewer.Resources>
            <StackPanel x:Name="PickerListContainer" Spacing="2" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
