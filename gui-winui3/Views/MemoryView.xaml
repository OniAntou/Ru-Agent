<UserControl
    x:Class="RuApp.Views.MemoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RuApp.Models"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="32" Background="Transparent">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Bộ nhớ đã lưu" FontSize="24" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Ru tự động trích xuất các thông tin cá nhân và dự án từ cuộc trò chuyện để cá nhân hóa phản hồi." Foreground="#AAAAAA" FontSize="14"/>
            </StackPanel>

            <Button x:Name="ClearMemoryButton" Grid.Column="1" Click="OnClearMemoryClick" Background="#40FF3333" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF8888"/>
                    <TextBlock Text="Xóa toàn bộ bộ nhớ" Foreground="#FFDDDD" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="MemoryListView" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:MemoryItemDto">
                    <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="20" Margin="0,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{x:Bind Text}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Foreground="#EAEAEA"/>
                                <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="#888888"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind CreatedAt}" FontSize="12" Foreground="#666666" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>