                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#5B6B82" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="#5B6B82" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPressed" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundDisabled" Color="#5B6B82" />
                    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="#5B6B82" />
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#0F172A" />
                    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#5B6B82" />
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#E2E8F0" />
