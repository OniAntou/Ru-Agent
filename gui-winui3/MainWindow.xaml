<Window
    x:Class="RuApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RuApp.Models"
    xmlns:controls="using:RuApp.Controls"
    xmlns:services="using:RuApp.Services"
    xmlns:views="using:RuApp.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot" Background="{StaticResource RuCanvasBrush}" PreviewKeyDown="OnShellPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar (Clean draggable titlebar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent"/>

        <!-- Main Content Area -->
        <Grid x:Name="RootLayoutGrid" Grid.Row="1" SizeChanged="RootLayoutGrid_SizeChanged">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1280"/>
                        </VisualState.StateTriggers>
                    </VisualState>

                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="NavNewChat.Padding" Value="10,8"/>
                            <Setter Target="NavChat.Padding" Value="10,7"/>
                            <Setter Target="NavSettings.Padding" Value="10,7"/>
                            <Setter Target="ThemeToggleButton.Padding" Value="10,7"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LabelNewChat.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelChat.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelThemeToggle.Visibility" Value="Collapsed"/>
                            <Setter Target="LabelSettings.Visibility" Value="Collapsed"/>
                            <Setter Target="WorkspaceHeaderPanel.Visibility" Value="Collapsed"/>
                            <Setter Target="NavNewChat.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavChat.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="ThemeToggleButton.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavSettings.HorizontalContentAlignment" Value="Center"/>
                            <Setter Target="NavNewChat.Padding" Value="8"/>
                            <Setter Target="NavChat.Padding" Value="8"/>
                            <Setter Target="ThemeToggleButton.Padding" Value="8"/>
                            <Setter Target="NavSettings.Padding" Value="8"/>
                            <Setter Target="SidebarResizer.Visibility" Value="Collapsed"/>
                             <Setter Target="StatusText.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="72" MaxWidth="400"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar. Asymmetric on purpose: the left edge is the
                 window edge, so only the two corners that meet the content get
                 the control radius. -->
            <Border Grid.Column="0" Background="{StaticResource RuSidebarBrush}" BorderThickness="0" CornerRadius="0,6,6,0">
                <Border.Resources>
        <DataTemplate x:Key="WorkspaceSessionTemplate" x:DataType="models:SessionInfo">
            <Grid Margin="{x:Bind ItemMargin, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneTime}"
                  PointerEntered="SessionItem_PointerEntered" PointerExited="SessionItem_PointerExited" Background="Transparent" Padding="10,4">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Fork New Branch" Click="OnForkSessionMenuClick" Tag="{x:Bind Id}">
                            <MenuFlyoutItem.Icon>
                                <!--
                                  Segoe MDL2 Assets has no branch glyph, and the glyph used
                                  here before (E8D8) is literally "DisableUpdates". SaveCopy
                                  is the closest honest mark for what a fork does: keep a
                                  copy of this conversation and continue in it.
                                -->
                                <FontIcon Glyph="&#xEA35;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExportClaudeCodeItem"
                                        Text="Export as Claude Code"
                                        Click="OnExportSessionMenuClick"
                                        Tag="{x:Bind Id}">
                            <MenuFlyoutItem.Icon>
                                <!-- Handing the session to another agent's own directory. -->
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExportCodexItem"
                                        Text="Export as Codex"
                                        Click="OnExportSessionMenuClick"
                                        Tag="{x:Bind Id}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ImportSessionItem"
                                        Text="Import session from another agent…"
                                        Click="OnImportSessionMenuClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete Session" Click="OnDeleteSessionClick" Tag="{x:Bind Id}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AppDangerBrush}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13" Foreground="{StaticResource RuInkBrush}"
                           TextTrimming="CharacterEllipsis" 
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <!-- The clock owns the right edge. The row's two actions share the
                     same cell and stay hidden until the row is hovered, at which
                     point the clock steps aside for them: everything is right-aligned
                     in one place, so the row never reflows, and the clock never
                     paints underneath a glyph. The controls are hidden by opacity
                     rather than by collapsing them so their width still reserves the
                     cell's edge. -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTimeText" HorizontalAlignment="Right"
                               Text="{x:Bind DisplayTimeText, Mode=OneTime}"
                               FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" Foreground="{StaticResource RuMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Token report for this session, including a session that is
                             not the one on screen. -->
                        <Button x:Name="SessionUsageButton" HorizontalAlignment="Right"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Width="22" Height="22" CornerRadius="{StaticResource AppControlCornerRadius}" Click="OnSessionUsageClick"
                                 Tag="{x:Bind Id, Mode=OneTime}" Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                                 ToolTipService.ToolTip="Session usage"
                                 AutomationProperties.Name="Session usage">
                            <TextBlock Text="…" FontFamily="{StaticResource RuUiFontFamily}" FontSize="14"
                                       Foreground="{StaticResource RuInkBrush}" Margin="0,-6,0,0" />
                        </Button>
                        <Button x:Name="SessionDeleteButton" HorizontalAlignment="Right"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Width="22" Height="22" CornerRadius="{StaticResource AppControlCornerRadius}" Click="OnDeleteSessionClick"
                                 Tag="{x:Bind Id}" Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                                 ToolTipService.ToolTip="Delete session"
                                 AutomationProperties.Name="Delete session">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource RuInkBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <Style x:Key="WorkspaceAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent"/>
                                            <Setter Target="Glyph.Foreground" Value="{StaticResource RuAccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent"/>
                                            <Setter Target="Glyph.Foreground" Value="{StaticResource RuAccentBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="Transparent"/>
                                            <Setter Target="Glyph.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon x:Name="Glyph" Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Row buttons inside the session list paint nothing themselves:
             the ListViewItem container owns the single rounded hover fill.
             A default Button template would add its own square PointerOver
             fill on top of it, which reads as a double border. -->
        <Style x:Key="WorkspaceRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WorkspaceGroupTemplate" x:DataType="services:WorkspaceGroupRow">
            <Button x:Name="WorkspaceGroupToggle" Click="OnWorkspaceGroupClick" Tag="{x:Bind Group.Key}" CommandParameter="{x:Bind IsExpanded, Mode=OneTime}" PointerEntered="WorkspaceGroupToggle_PointerEntered" PointerExited="WorkspaceGroupToggle_PointerExited"
                    Style="{StaticResource WorkspaceRowButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Group.Path}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Remove workspace" Click="OnWorkspaceRemoveClick" Tag="{x:Bind Group.Key}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AppDangerBrush}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource RuAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Group.Label}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RuInkBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="WorkspaceGroupAddButton" Grid.Column="2" Click="OnWorkspaceGroupAddClick" Tag="{x:Bind Group.Key}" Opacity="0.55" IsTabStop="True" Style="{StaticResource WorkspaceAddButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="New chat here" AutomationProperties.Name="New chat here"/>
                    <FontIcon x:Name="WorkspaceGroupChevron" Grid.Column="3" Opacity="0.55" Glyph="{x:Bind ChevronGlyph}" FontSize="10" Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceShowMoreTemplate" x:DataType="services:WorkspaceShowMoreRow">
            <Button Click="OnWorkspaceShowMoreClick" Tag="{x:Bind GroupKey}" Style="{StaticResource WorkspaceRowButtonStyle}" Padding="10,4"
                    HorizontalContentAlignment="Left">
                <TextBlock Text="{x:Bind DisplayText}" FontFamily="{StaticResource RuUiFontFamily}" FontSize="12" Foreground="{StaticResource RuAccentBrush}"/>
            </Button>
        </DataTemplate>
        <views:SidebarRowTemplateSelector x:Key="SidebarRowSelector"
                                          GroupTemplate="{StaticResource WorkspaceGroupTemplate}"
                                          SessionTemplate="{StaticResource WorkspaceSessionTemplate}"
                                          ShowMoreTemplate="{StaticResource WorkspaceShowMoreTemplate}" />
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Navigation Items -->
                        <StackPanel x:Name="SidebarTopPanel" Grid.Row="0" Padding="14,16,14,0" Spacing="2">
                            <!-- New Chat Button -->
                            <Button x:Name="NavNewChat" Click="OnNewChatClick" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Padding="10,8"
                                    CornerRadius="{StaticResource AppControlCornerRadius}" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource RuSecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="NewSessionButton"
                                    AutomationProperties.Name="New Chat">
                                <StackPanel x:Name="ContentNewChat" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconNewChat" Glyph="&#xE710;" FontSize="13" Foreground="{StaticResource RuAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelNewChat" Text="New Chat" Style="{StaticResource RuNavLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Navigation Tabs -->
                            <Button x:Name="NavChat" Tag="chat" Click="OnNavClick" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                    Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                    Padding="10,8" CornerRadius="{StaticResource AppControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Chat">
                                <StackPanel x:Name="ContentChat" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon x:Name="IconChat" Glyph="&#xE8F2;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LabelChat" Text="Chat" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        
                        <!-- Workspaces Header -->
                        <Grid x:Name="WorkspaceHeaderPanel" Grid.Row="1" Margin="14,20,14,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                                <TextBlock x:Name="WorkspaceHeader" Grid.Column="0" Text="WORKSPACES" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource RuMutedBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="WorkspaceSearchButton" Grid.Column="1" Click="OnWorkspaceSearchClick" Background="Transparent" BorderThickness="0" Padding="6,4"
                                        ToolTipService.ToolTip="Search sessions" AutomationProperties.Name="Search sessions">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource RuMutedBrush}"/>
                                </Button>
                                <Button x:Name="WorkspaceFilterButton" Grid.Column="2" Click="OnWorkspaceFilterClick" Background="Transparent" BorderThickness="0" Padding="6,4"
                                        ToolTipService.ToolTip="Show only the current workspace" AutomationProperties.Name="Filter to current workspace">
                                    <FontIcon Glyph="&#xE71C;" FontSize="12" Foreground="{StaticResource RuMutedBrush}"/>
                                </Button>
                                <Button x:Name="WorkspaceNewButton" Grid.Column="3" Click="OnWorkspaceAddClick" Background="Transparent" BorderThickness="0" Padding="6,4"
                                        ToolTipService.ToolTip="Add workspace" AutomationProperties.Name="Add workspace">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource RuMutedBrush}"/>
                                </Button>
                            </Grid>
                            <TextBox x:Name="WorkspaceSearchBox" Grid.Row="1" Margin="0,6,0,0" PlaceholderText="Search sessions"
                                     AutomationProperties.Name="Search sessions"
                                     Visibility="Collapsed" TextChanged="OnWorkspaceSearchTextChanged" KeyDown="OnWorkspaceSearchKeyDown"/>
                            <TextBlock x:Name="WorkspaceSearchCount" Grid.Row="2" Margin="2,4,0,0" FontFamily="{StaticResource RuUiFontFamily}" FontSize="11" Foreground="{StaticResource RuMutedBrush}" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Sessions List -->
                        <ListView x:Name="SidebarSessionList" Grid.Row="2" SelectionMode="Single"
                                  AutomationProperties.AutomationId="SessionList"
                                  SelectionChanged="OnSessionSelectionChanged" Margin="8,0" Padding="0,0,0,16"
                                  Background="Transparent" BorderThickness="0" ItemTemplateSelector="{StaticResource SidebarRowSelector}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="34" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>

                    <!-- Status and settings -->
                    <StackPanel x:Name="SidebarBottomPanel" Grid.Row="1" Padding="14,8,14,14" Spacing="4">
                        <StackPanel x:Name="ShellStatusRow" Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Padding="10,8,10,12"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource RuSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText"
                                       AutomationProperties.AutomationId="BackendStatus"
                                       Text="System ready"
                                       FontFamily="{StaticResource RuUiFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource RuMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </StackPanel>

                        <Button x:Name="ThemeToggleButton"
                                Visibility="Collapsed"
                                Click="OnThemeToggleClick"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                Foreground="{StaticResource RuMutedBrush}"
                                Padding="10,8"
                                CornerRadius="{StaticResource AppControlCornerRadius}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Switch to dark mode">
                            <StackPanel x:Name="ContentThemeToggle" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon x:Name="ThemeToggleIcon"
                                          Glyph="&#xE706;"
                                          FontSize="15"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelThemeToggle"
                                           Text="Switch to dark mode"
                                           FontFamily="{StaticResource RuUiFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettings" Tag="settings" Click="OnNavClick" HorizontalAlignment="Stretch"
                                Background="Transparent" Foreground="{StaticResource RuMutedBrush}"
                                Padding="10,8" CornerRadius="{StaticResource AppControlCornerRadius}" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Settings">
                            <StackPanel x:Name="ContentSettings" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <FontIcon x:Name="IconSettings" Glyph="&#xE713;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelSettings" Text="Settings" FontFamily="{StaticResource RuUiFontFamily}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar Divider / Resizer (10px hit-target with native SizeWestEast cursor) -->
            <controls:SidebarResizerControl x:Name="SidebarResizer" Grid.Column="1" Width="10" Margin="-5,0,-5,0" Canvas.ZIndex="10"
                  Background="Transparent"
                  PointerEntered="Resizer_PointerEntered"
                  PointerExited="Resizer_PointerExited"
                  PointerPressed="Resizer_PointerPressed"
                  PointerMoved="Resizer_PointerMoved"
                  PointerReleased="Resizer_PointerReleased"
                  DoubleTapped="Resizer_DoubleTapped">
                <Border x:Name="SidebarResizerLine" Width="1" HorizontalAlignment="Center"
                        Background="{StaticResource RuLineBrush}" Opacity="0.6"/>
            </controls:SidebarResizerControl>

            <!-- Content Frame with Smooth Native Transition -->
            <ContentControl x:Name="ContentFrame" Grid.Column="2" Margin="0" 
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="Transparent">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
            </ContentControl>
        </Grid>

        <!-- Settings Modal Overlay Popup -->
        <Grid x:Name="SettingsModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="500"
              Visibility="Collapsed"
              SizeChanged="OnSettingsModalOverlaySizeChanged">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Dimmed Backdrop (Click outside card to close) -->
            <Border
                    Background="{StaticResource RuCanvasBrush}"
                    Opacity="0.75"
                    PointerPressed="OnSettingsBackdropPointerPressed" />

            <!-- Dialog Card Container (Fixed stable dimension avoids jitter/shifting) -->
            <Border x:Name="SettingsModalCard"
                    Width="880"
                    Height="560"
                    MaxWidth="1080"
                    MaxHeight="780"
                    Margin="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppModalCornerRadius}"
                    Translation="0,0,16"
                    Shadow="{StaticResource RuRaisedShadow}"
                    PointerPressed="OnSettingsCardPointerPressed">
                <Grid>
                    <!-- Modal Body (Hosts SettingsView with Sidebar + Content) -->
                    <ContentControl x:Name="SettingsModalContent"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent" />

                    <!-- Top-Right Close Button -->
                    <Button x:Name="CloseSettingsButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            Canvas.ZIndex="10"
                            Click="OnCloseSettingsButtonClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Width="32"
                            Height="32"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            AutomationProperties.Name="Close settings"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Session usage modal (opened from a session row's menu) -->
        <Grid x:Name="SessionUsageOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="510"
              Visibility="Collapsed"
              SizeChanged="OnSessionUsageOverlaySizeChanged">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Dimmed Backdrop (Click outside card to close) -->
            <Border x:Name="SessionUsageBackdrop"
                    Background="{StaticResource RuCanvasBrush}"
                    Opacity="0.75"
                    PointerPressed="OnSessionUsageBackdropPointerPressed" />

            <!-- Dialog Card Container (Fixed stable dimension avoids jitter/shifting) -->
            <Border x:Name="SessionUsageCard"
                    Width="560"
                    Height="560"
                    MaxWidth="720"
                    MaxHeight="780"
                    Margin="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource RuSurfaceBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppModalCornerRadius}"
                    Translation="0,0,16"
                    Shadow="{StaticResource RuRaisedShadow}"
                    PointerPressed="OnSessionUsageCardPointerPressed">
                <Grid>
                    <controls:SessionUsagePanel x:Name="SessionUsagePanelControl"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />

                    <!-- Top-Right Close Button -->
                    <Button x:Name="CloseSessionUsageButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            Canvas.ZIndex="10"
                            Click="OnCloseSessionUsageClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Width="32"
                            Height="32"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            AutomationProperties.Name="Close session usage"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource RuMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Welcome & Loading Overlay (static art while backend initializes) -->
        <controls:WelcomeOverlay x:Name="WelcomeOverlay"
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Canvas.ZIndex="1000" />
    </Grid>
