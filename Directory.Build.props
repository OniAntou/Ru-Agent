<Project>

  <!--
    Repository-wide build baseline.

    Product C# projects, including the WinUI application and harness, treat warnings
    as errors. Test projects remain excluded because xUnit analyzer suggestions are
    advisory. Any external XAML/SDK warning exceptions must be narrowly listed in the
    affected project after confirming the warning comes from that toolchain.
  -->
  <PropertyGroup>
    <!-- Source builds share the product version; packaging overrides it explicitly. -->
    <Version Condition="'$(RuReleaseVersion)' == ''">0.1.2</Version>
    <Version Condition="'$(RuReleaseVersion)' != ''">$(RuReleaseVersion)</Version>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Pinned so a newer SDK cannot silently enable a larger analyzer set on the
         same source and turn the warning-free build red on another machine. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- xUnit analyzer suggestions remain advisory in test projects. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
