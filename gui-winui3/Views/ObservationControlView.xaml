<UserControl
    x:Class="RuApp.Views.ObservationControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32" Background="Transparent">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <TextBlock Text="Nhận thức Màn hình (Screen Observer)" FontSize="24" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>

            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="24">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Quan sát màn hình chính (DXGI -&gt; Local Qwen3-VL -&gt; OmniVoice)" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="#EAEAEA"/>
                        <TextBlock Text="Màn hình được quan sát cục bộ qua vòng lặp RAM. Không ghi đĩa hay lưu trữ bất kỳ hình ảnh nào." Foreground="#AAAAAA" FontSize="14"/>
                    </StackPanel>

                    <Button x:Name="ToggleObservationButton" Grid.Column="1" Click="OnToggleObservationClick" VerticalAlignment="Center" Padding="24,12" CornerRadius="8" Background="#20FFFFFF" BorderThickness="1" BorderBrush="#10FFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="ToggleIcon" Glyph="&#xE714;" FontSize="16"/>
                            <TextBlock x:Name="ToggleText" Text="Bắt đầu quan sát" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Chỉ số vận hành Realtime (RAM-only)" FontSize="18" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="#EAEAEA"/>

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="16">
                        <Border Grid.Row="0" Grid.Column="0" Background="#20FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="20" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tổng frame đã chụp" FontSize="13" Foreground="#999999"/>
                                <TextBlock x:Name="FrameCountText" Text="0" FontSize="28" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#20FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="20" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Phân tích VLM" FontSize="13" Foreground="#999999"/>
                                <TextBlock x:Name="VisionCountText" Text="0" FontSize="28" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Background="#152515" BorderBrush="#2040FF40" BorderThickness="1" Padding="20" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Phản hồi đã phát giọng" FontSize="13" Foreground="#88CC88"/>
                                <TextBlock x:Name="EmittedCountText" Text="0" FontSize="28" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#251515" BorderBrush="#40FF4040" BorderThickness="1" Padding="20" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Bỏ qua do màn hình tĩnh (Stale)" FontSize="13" Foreground="#CC8888"/>
                                <TextBlock x:Name="StaleDropsText" Text="0" FontSize="28" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="#FF5252"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#20FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="20" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Thay đổi màn hình (MAD Delta) / Engine" FontSize="13" Foreground="#999999"/>
                                <TextBlock x:Name="LatencyText" Text="0.0% | UltraFast-GDI-Native" FontSize="20" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="#EAEAEA" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>